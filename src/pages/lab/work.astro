---
import Layout from '../../layouts/Layout.astro';
import IconLoopButton from '../../components/IconLoopButton.astro';
import Footer from '../../components/Footer.astro';
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';

type Stat = { value: string; num: number; label: string };
type Job = { id: string; company: string; role: string; start: string; end: string; logo: string; ink: string; stats: Stat[] };

const jobs = JSON.parse(await readFile(resolve('./public/config/work-stats.json'), 'utf8')) as Job[];

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmtDate = (d: string) => {
  const [y, m] = d.split('-');
  return `${MONTHS[Number(m) - 1]} ${y}`;
};
const span = (j: Job) => `${fmtDate(j.start)} – ${fmtDate(j.end)}`;
const sym = (v: string) => v.replace(/([+%$~.,])/g, '<span class="sym">$1</span>');
const symSvg = (v: string) => v.replace(/([+%$~.,])/g, '<tspan class="sym">$1</tspan>');
const arcSize = (name: string) => Math.min(15, 205 / (name.length * 0.95)).toFixed(1);
const lead = (j: Job) => j.stats[0];
const logScale = (n: number) => Math.max(0.03, Math.log10(Math.max(n, 1)) / 9);

const jobById = Object.fromEntries(jobs.map((j) => [j.id, j]));
const stat = (id: string, i: number) => jobById[id].stats[i];

const monthIndex = (d: string) => {
  const [y, m] = d.split('-').map(Number);
  return (y - 2023) * 12 + (m - 1);
};
const TOTAL = 48;
const ribbon = jobs
  .map((j) => ({
    job: j,
    left: (monthIndex(j.start) / TOTAL) * 100,
    width: ((monthIndex(j.end) + 1 - monthIndex(j.start)) / TOTAL) * 100,
  }))
  .sort((a, b) => a.left - b.left);

const allStats = jobs.flatMap((j) => j.stats.map((s) => ({ ...s, job: j })));
const logTicks = [
  { k: 0, label: '1' },
  { k: 1, label: '10' },
  { k: 2, label: '100' },
  { k: 3, label: '1k' },
  { k: 4, label: '10k' },
  { k: 5, label: '100k' },
  { k: 6, label: '1M' },
  { k: 7, label: '10M' },
  { k: 8, label: '100M' },
  { k: 9, label: '1B' },
];

const hash = (s: string) => {
  let h = 5381;
  for (const c of s) h = ((h << 5) + h + c.charCodeAt(0)) >>> 0;
  return h.toString(16).padStart(8, '0').slice(0, 7);
};

const rings = jobs.map((j) =>
  j.stats.slice(0, 5).map((s, i) => {
    const r = 88 - i * 14;
    const c = 2 * Math.PI * r;
    return { r, c, dash: logScale(s.num) * c, stat: s, opacity: 1 - i * 0.16 };
  })
);

const variants = [
  ['v1', 'Ledger'],
  ['v2', 'Ribbon'],
  ['v3', 'Bento'],
  ['v4', 'Receipts'],
  ['v5', 'Rings'],
  ['v6', 'Scale'],
  ['v7', 'Odometer'],
  ['v8', 'Stamps'],
  ['v9', 'Git log'],
  ['v10', 'Poster'],
];
---

<Layout title="Work directions — Owen Ritchie">
  <div class="page">
    <header class="page-header">
      <IconLoopButton icon="arrow-left" label="Back" direction="left" variant="accent" tone="page" href="/" />
    </header>

    <main class="lab">
      <div class="lab-intro">
        <h1 class="lab-title">Where I've worked</h1>
        <p>Ten directions for the work section, all built from the same numbers on my resume. Tell me which numbers to pick.</p>
        <nav class="lab-nav" aria-label="Directions">
          {variants.map(([id, name], i) => <a href={`#${id}`}><span>{String(i + 1).padStart(2, '0')}</span>{name}</a>)}
        </nav>
      </div>

      <!-- 01 LEDGER -->
      <section class="v" id="v1">
        <header class="v-head"><span>01</span><h2>Ledger</h2><p>Big numbers in ruled rows, like an annual report.</p></header>
        <div class="ledger">
          {jobs.map((j) => (
            <article class="lg-row">
              <div class="lg-who">
                <img src={j.logo} alt="" width="40" height="40" />
                <h3>{j.company}</h3>
                <p>{j.role}</p>
                <small>{span(j)}</small>
              </div>
              <div class="lg-stats">
                {j.stats.slice(0, 3).map((s) => (
                  <div class="lg-stat">
                    <b set:html={sym(s.value)} />
                    <span>{s.label}</span>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- 02 RIBBON -->
      <section class="v" id="v2">
        <header class="v-head"><span>02</span><h2>Ribbon</h2><p>Time on the axis, the headline stat riding on each stint.</p></header>
        <div class="ribbon">
          <div class="rb-axis">
            {[2023, 2024, 2025, 2026].map((y, i) => <i style={`left:${(i * 12 / TOTAL) * 100}%`}>{y}</i>)}
          </div>
          <div class="rb-lanes">
            {ribbon.map((r, i) => (
              <div class="rb-lane" style={`--l:${r.left}%;--w:${r.width}%`}>
                <div class="rb-bar">
                  <img src={r.job.logo} alt="" width="22" height="22" />
                  <span>{r.job.company}</span>
                </div>
                <div class="rb-note">
                  <b set:html={sym(lead(r.job).value)} />
                  <span>{lead(r.job).label}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 03 BENTO -->
      <section class="v" id="v3">
        <header class="v-head"><span>03</span><h2>Bento</h2><p>A mosaic where size follows scale.</p></header>
        <div class="bento">
          <div class="bt bt-hero">
            <img src={jobById.kinaxis.logo} alt="" width="34" height="34" />
            <b set:html={sym(stat('kinaxis', 0).value)} />
            <span>{stat('kinaxis', 0).label}</span>
            <small>Kinaxis · {span(jobById.kinaxis)}</small>
          </div>
          <div class="bt">
            <b set:html={sym(stat('kinaxis', 1).value)} />
            <span>{stat('kinaxis', 1).label}</span>
          </div>
          <div class="bt bt-bar">
            <b set:html={sym(stat('gac', 0).value)} />
            <span>{stat('gac', 0).label}</span>
            <i><u style="width:99.8%"></u></i>
          </div>
          <div class="bt bt-ink">
            <b set:html={sym(stat('poisson', 0).value)} />
            <span>{stat('poisson', 0).label}</span>
          </div>
          <div class="bt">
            <b set:html={sym(stat('kinaxis', 3).value)} />
            <span>{stat('kinaxis', 3).label}</span>
          </div>
          <div class="bt bt-logos">
            {jobs.map((j) => <img src={j.logo} alt={j.company} width="44" height="44" />)}
            <span>3 internships, 2023 to 2026</span>
          </div>
          <div class="bt">
            <b set:html={sym(stat('gac', 1).value)} />
            <span>{stat('gac', 1).label}</span>
          </div>
          <div class="bt bt-soft">
            <b set:html={sym(stat('kinaxis', 4).value)} />
            <span>{stat('kinaxis', 4).label}</span>
          </div>
          <div class="bt">
            <b set:html={sym(stat('kinaxis', 5).value)} />
            <span>{stat('kinaxis', 5).label}</span>
          </div>
          <div class="bt">
            <b set:html={sym(stat('poisson', 2).value)} />
            <span>{stat('poisson', 2).label}</span>
          </div>
          <div class="bt">
            <b set:html={sym(stat('poisson', 1).value)} />
            <span>{stat('poisson', 1).label}</span>
          </div>
        </div>
      </section>

      <!-- 04 RECEIPTS -->
      <section class="v" id="v4">
        <header class="v-head"><span>04</span><h2>Receipts</h2><p>An itemized bill of what each role delivered.</p></header>
        <div class="receipts">
          {jobs.map((j, i) => (
            <article class="receipt" style={`--tilt:${[-1.4, 0.8, -0.6][i]}deg`}>
              <header>
                <img src={j.logo} alt="" width="30" height="30" />
                <h3>{j.company}</h3>
                <p>{j.role}</p>
                <small>{span(j)}</small>
              </header>
              <hr />
              <ul>
                {j.stats.slice(0, 5).map((s) => (
                  <li><span>{s.label}</span><b>{s.value}</b></li>
                ))}
              </ul>
              <hr />
              <footer><span>Total impact</span><b>Delivered</b></footer>
            </article>
          ))}
        </div>
      </section>

      <!-- 05 RINGS -->
      <section class="v" id="v5">
        <header class="v-head"><span>05</span><h2>Rings</h2><p>Each stat is an arc on a log scale, so a billion and a thousand can share one dial.</p></header>
        <div class="rings">
          {jobs.map((j, ji) => (
            <article class="ring-card">
              <svg viewBox="0 0 200 200" role="img" aria-label={`${j.company} stats as rings`}>
                {rings[ji].map((r) => (
                  <g>
                    <circle class="rg-track" cx="100" cy="100" r={r.r} />
                    <circle class="rg-arc" cx="100" cy="100" r={r.r} stroke-dasharray={`${r.dash.toFixed(1)} ${r.c.toFixed(1)}`} style={`opacity:${r.opacity}`} transform="rotate(-90 100 100)" />
                  </g>
                ))}
                <text class="rg-value" x="100" y="108" text-anchor="middle" set:html={symSvg(lead(j).value)} />
              </svg>
              <h3>{j.company}</h3>
              <small>{span(j)}</small>
              <ul>
                {rings[ji].map((r) => (
                  <li style={`--o:${r.opacity}`}><i></i><b>{r.stat.value}</b><span>{r.stat.label}</span></li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <!-- 06 SCALE -->
      <section class="v" id="v6">
        <header class="v-head"><span>06</span><h2>Scale</h2><p>Every number from every role on one logarithmic axis, from 3 to 500 million.</p></header>
        <div class="scale">
          <div class="sc-axis">
            {logTicks.map((t) => <i style={`left:${(t.k / 9) * 100}%`}>{t.label}</i>)}
          </div>
          {jobs.map((j) => (
            <div class="sc-group">
              <h3><img src={j.logo} alt="" width="22" height="22" />{j.company}</h3>
              {j.stats.map((s) => (
                <div class="sc-row">
                  <div class="sc-track">
                    <i style={`width:${logScale(s.num) * 100}%`}></i>
                    <b style={`left:${logScale(s.num) * 100}%`} set:html={sym(s.value)} />
                  </div>
                  <span>{s.label}</span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>

      <!-- 07 ODOMETER -->
      <section class="v" id="v7">
        <header class="v-head"><span>07</span><h2>Odometer</h2><p>Mechanical counters, one per role.</p></header>
        <div class="odos">
          {jobs.map((j) => (
            <article class="odo">
              <div class="od-cells" role="img" aria-label={lead(j).value}>
                {[...lead(j).value].map((c) => (
                  <i class:list={['od-cell', { 'od-sym': /[^0-9]/.test(c) }]}>{c}</i>
                ))}
              </div>
              <p>{lead(j).label}</p>
              <footer><img src={j.logo} alt="" width="24" height="24" /><span>{j.company}</span><small>{span(j)}</small></footer>
            </article>
          ))}
        </div>
      </section>

      <!-- 08 STAMPS -->
      <section class="v" id="v8">
        <header class="v-head"><span>08</span><h2>Stamps</h2><p>Passport stamps for each posting.</p></header>
        <div class="stamps">
          {jobs.map((j, i) => (
            <figure class="stamp" style={`--ink:${j.ink};--rot:${[-7, 5, -3][i]}deg`}>
              <svg viewBox="0 0 220 220" role="img" aria-label={`${j.company}: ${lead(j).value} ${lead(j).label}`}>
                <defs>
                  <path id={`top-${j.id}`} d="M 38,110 A 72,72 0 0 1 182,110" />
                  <path id={`bot-${j.id}`} d="M 30,110 A 80,80 0 0 0 190,110" />
                </defs>
                <circle class="st-ring" cx="110" cy="110" r="102" />
                <circle class="st-ring thin" cx="110" cy="110" r="94" />
                <circle class="st-ring dash" cx="110" cy="110" r="52" />
                <text class="st-arc" style={`font-size:${arcSize(j.company)}px`}><textPath href={`#top-${j.id}`} startOffset="50%" text-anchor="middle">{j.company.toUpperCase()}</textPath></text>
                <text class="st-arc small"><textPath href={`#bot-${j.id}`} startOffset="50%" text-anchor="middle">{span(j).toUpperCase()}</textPath></text>
                <text class="st-value" x="110" y="118" text-anchor="middle" set:html={symSvg(lead(j).value)} />
              </svg>
              <figcaption>{lead(j).label}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- 09 GIT LOG -->
      <section class="v" id="v9">
        <header class="v-head"><span>09</span><h2>Git log</h2><p>Every role as a commit, every result as a diffstat.</p></header>
        <div class="gitlog">
          {jobs.map((j, i) => (
            <article class="commit">
              <p class="gl-hash">commit <b>{hash(j.id)}</b>{i === 0 ? <em> (HEAD -&gt; main)</em> : ''}</p>
              <p class="gl-meta">Author: Owen Ritchie</p>
              <p class="gl-meta">Date:   {span(j)}</p>
              <p class="gl-msg">{j.role} @ {j.company}</p>
              <ul>
                {j.stats.slice(0, 6).map((s) => (
                  <li>
                    <b>{/^[0-9$]/.test(s.value) ? '+' : ''}{s.value}</b>
                    <i style={`--w:${logScale(s.num) * 100}%`}></i>
                    <span>{s.label}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <!-- 10 POSTER -->
      <section class="v" id="v10">
        <header class="v-head"><span>10</span><h2>Poster</h2><p>Oversized numerals, the way a magazine opens a feature.</p></header>
        <div class="poster">
          {jobs.map((j, i) => (
            <article class:list={['ps-row', { flip: i % 2 === 1 }]}>
              <b class:list={['ps-num', ['outline', 'fill', 'tint'][i]]} set:html={sym(lead(j).value)} />
              <div class="ps-side">
                <h3>{j.company}</h3>
                <p>{j.role}</p>
                <small>{span(j)}</small>
                <span class="ps-lead">{lead(j).label}</span>
                <ul>
                  {j.stats.slice(1, 3).map((s) => <li><b set:html={sym(s.value)} />{s.label}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
  </div>

  <Footer rounded flush />
</Layout>

<style>
  :global(.sym) {
    font-family: 'Grenze', serif;
  }

  .page {
    width: 100%;
    position: relative;
  }

  .page-header {
    display: flex;
    align-items: center;
    min-height: 2.2rem;
    margin-bottom: 3rem;
  }

  .lab {
    max-width: 1120px;
    margin: 0 auto;
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .lab-intro {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto clamp(2.5rem, 6vw, 4.5rem);
  }

  .lab-title {
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    line-height: 1.05;
    color: var(--heading-ink);
    margin-bottom: 0.9rem;
  }

  .lab-intro p {
    color: var(--text-muted);
    line-height: 1.7;
  }

  .lab-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .lab-nav a {
    display: inline-flex;
    gap: 0.45rem;
    align-items: baseline;
    padding: 0.35rem 0.9rem;
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: 999px;
    color: var(--text);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .lab-nav a span {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .v {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
    border-top: var(--dash-width) dashed var(--dash-color);
    scroll-margin-top: 1rem;
  }

  .v-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .v-head span {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .v-head h2 {
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: 2rem;
    color: var(--heading-ink);
  }

  .v-head p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  h3 {
    font-weight: 600;
  }

  /* ---------- 01 ledger ---------- */
  .lg-row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 2.4fr);
    gap: 2rem;
    padding: 1.75rem 0;
    border-bottom: var(--dash-width) dashed var(--dash-color);
  }

  .lg-row:first-child {
    padding-top: 0;
  }

  .lg-who img {
    display: block;
    width: 40px;
    height: 40px;
    object-fit: contain;
    margin-bottom: 0.7rem;
  }

  .lg-who h3 {
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: 1.5rem;
    color: var(--heading-ink);
  }

  .lg-who p {
    color: var(--text);
    font-size: 0.95rem;
  }

  .lg-who small {
    color: var(--text-muted);
  }

  .lg-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .lg-stat b {
    display: block;
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: clamp(2.4rem, 5.4vw, 4.4rem);
    line-height: 1;
    color: var(--heading-ink);
    margin-bottom: 0.5rem;
  }

  .lg-stat span {
    display: block;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  /* ---------- 02 ribbon ---------- */
  .ribbon {
    position: relative;
  }

  .rb-axis {
    position: relative;
    height: 1.6rem;
    border-bottom: var(--dash-width) dashed var(--dash-color);
    margin-bottom: 1.5rem;
  }

  .rb-axis i {
    position: absolute;
    bottom: 0.3rem;
    font-style: normal;
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-left: 0.4rem;
    border-left: var(--dash-width) dashed var(--dash-color);
    height: 1.6rem;
    display: flex;
    align-items: flex-end;
  }

  .rb-lane {
    margin-bottom: 1.75rem;
  }

  .rb-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: var(--l);
    width: var(--w);
    min-width: max-content;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: var(--btn-2);
    color: var(--text);
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .rb-bar img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    flex: none;
  }

  .rb-note {
    margin-left: var(--l);
    margin-top: 0.7rem;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    max-width: 30rem;
  }

  .rb-note b {
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--heading-ink);
  }

  .rb-note span {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  @media (max-width: 800px) {
    .rb-lane {
      --l: 0%;
      --w: 100%;
    }
  }

  /* ---------- 03 bento ---------- */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(150px, auto);
    grid-auto-flow: dense;
    gap: 0.9rem;
  }

  .bt {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 1.2rem;
    border-radius: 22px;
    background: var(--card);
    border: var(--dash-width) dashed var(--dash-color);
  }

  .bt b {
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1;
    color: var(--heading-ink);
  }

  .bt span {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .bt-hero {
    grid-column: span 2;
    grid-row: span 2;
    background: var(--btn);
    border-color: transparent;
  }

  .bt-hero img {
    width: 34px;
    height: 34px;
    margin-bottom: auto;
    padding: 5px;
    border-radius: 10px;
    background: var(--bg);
    object-fit: contain;
  }

  .bt-hero b {
    font-size: clamp(4rem, 10vw, 7.5rem);
    color: var(--btn-fg);
  }

  .bt-hero span,
  .bt-hero small {
    color: color-mix(in oklch, var(--btn-fg) 78%, transparent);
  }

  .bt-bar i {
    display: block;
    height: 6px;
    margin-top: 0.4rem;
    border-radius: 3px;
    background: color-mix(in oklch, var(--accent) 18%, transparent);
  }

  .bt-bar u {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
  }

  .bt-ink {
    background: var(--btn-2);
    border-color: transparent;
  }

  .bt-soft {
    grid-column: span 2;
    border-style: solid;
    border-color: transparent;
  }

  .bt-logos {
    grid-column: span 2;
    flex-direction: row;
