---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AboutMe from '../components/AboutMe.astro';
import ProjectGrid from '../components/projects/ProjectGrid.astro';
import Timeline from '../components/timeline/Timeline.astro';
import WorkBento from '../components/work/WorkBento.astro';
import Footer from '../components/Footer.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const projectsData = JSON.parse(
  readFileSync(join(process.cwd(), 'public/config/projects.json'), 'utf-8')
) as {
  title: string;
  short?: string;
  subtitle: string;
  link?: string;
  image: string;
  colorTheme?: string;
  comingSoon?: boolean;
  download?: string;
  stack?: string[];
  kind?: string;
  hidden?: boolean;
}[];

const timelineData = JSON.parse(
  readFileSync(join(process.cwd(), 'public/config/timeline.json'), 'utf-8')
) as {
  entries: {
    title: string;
    role: string;
    start: string;
    end: string;
    color?: string;
    link?: string;
    logo?: string;
    logoZoom?: number;
    logoFit?: 'cover' | 'contain';
    description?: string;
  }[];
  events?: { date: string; label: string; description?: string; link?: string }[];
};

const today = new Date().toISOString().slice(0, 10);
const workBento = true;
---

<Layout title="Owen Ritchie">
  <main>
    <div class="cover-stack">
      <Hero />

      <AboutMe />

      {workBento ? <WorkBento entries={timelineData.entries} /> : <Timeline now={today} entries={timelineData.entries} />}

      <ProjectGrid projects={projectsData} />
    </div>

    <Footer />
  </main>
</Layout>

<script>
  const pinned = document.querySelectorAll<HTMLElement>('.cover-stack > .about-me, .cover-stack > .timeline');
  const wide = matchMedia('(min-width: 861px)');
  const fit = () => {
    pinned.forEach((el) => {
      el.style.top = wide.matches ? `${Math.min(0, innerHeight - el.offsetHeight)}px` : '';
    });
  };
  wide.addEventListener('change', fit);
  fit();
  addEventListener('resize', fit);
  pinned.forEach((el) => new ResizeObserver(fit).observe(el));
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap');

  main {
    max-width: 1320px;
    margin: 0 auto;
    position: relative;
  }

  .cover-stack {
    position: relative;
  }

  @media (min-width: 861px) {
    .cover-stack > :global(.hero) {
      position: sticky;
      top: 0;
    }
  }

  @media (min-width: 861px) {
    .cover-stack > :global(.about-me),
    .cover-stack > :global(.timeline) {
      position: sticky;
      top: 0;
    }
  }

  .cover-stack > :global(.timeline) {
    z-index: 2;
  }

  .cover-stack > :global(.pgrid) {
    z-index: 3;
  }

</style>
