---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AboutMe from '../components/AboutMe.astro';
import ProjectGrid from '../components/projects/ProjectGrid.astro';
import WorkBento from '../components/work/WorkBento.astro';
import Footer from '../components/Footer.astro';
import TypeOn from '../components/TypeOn.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const projectsData = JSON.parse(
  readFileSync(join(process.cwd(), 'public/config/projects.json'), 'utf-8')
) as {
  title: string;
  short?: string;
  subtitle: string;
  link?: string;
  image: string;
  colorTheme?: string;
  comingSoon?: boolean;
  download?: string;
  stack?: string[];
  kind?: string;
  hidden?: boolean;
}[];

const timelineData = JSON.parse(
  readFileSync(join(process.cwd(), 'public/config/timeline.json'), 'utf-8')
) as {
  entries: {
    title: string;
    role: string;
    start: string;
    end: string;
    color?: string;
    link?: string;
    logo?: string;
    logoZoom?: number;
    logoFit?: 'cover' | 'contain';
    description?: string;
  }[];
  events?: { date: string; label: string; description?: string; link?: string }[];
};

---

<Layout title="Owen Ritchie">
  <main>
    <div class="cover-stack">
      <Hero />

      <AboutMe />

      <WorkBento entries={timelineData.entries} />

      <ProjectGrid projects={projectsData} />
    </div>

    <Footer />
  </main>
  <TypeOn />
</Layout>

<script>
  const pinned = document.querySelectorAll<HTMLElement>('.cover-stack > .about-me, .cover-stack > .timeline');
  const wide = matchMedia('(min-width: 861px)');
  const fit = () => {
    pinned.forEach((el) => {
      el.style.top = wide.matches ? `${Math.min(0, innerHeight - el.offsetHeight)}px` : '';
    });
  };
  wide.addEventListener('change', fit);
  fit();
  addEventListener('resize', fit);
  pinned.forEach((el) => new ResizeObserver(fit).observe(el));

  const naturalTop = (el: HTMLElement) => {
    const stack = Array.from(document.querySelectorAll<HTMLElement>('.cover-stack > *'));
    const prev = stack.map((n) => n.getAttribute('style'));
    stack.forEach((n) => {
      n.style.position = 'static';
      n.style.top = 'auto';
    });
    const y = el.getBoundingClientRect().top + scrollY;
    stack.forEach((n, i) => {
      const p = prev[i];
      if (p === null) n.removeAttribute('style');
      else n.setAttribute('style', p);
    });
    return y - (parseFloat(getComputedStyle(el).scrollMarginTop) || 0);
  };

  const jump = (id: string, smooth: boolean) => {
    const el = document.getElementById(id);
    if (!el) return false;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    scrollTo({ top: naturalTop(el), behavior: smooth && !still ? 'smooth' : 'auto' });
    return true;
  };

  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
    if (!a || a.origin !== location.origin || a.pathname !== location.pathname || !a.hash) return;
    if (jump(a.hash.slice(1), true)) {
      e.preventDefault();
      history.replaceState(null, '', a.hash);
    }
  });

  if (location.hash) addEventListener('load', () => jump(location.hash.slice(1), false));
</script>

<style>
  main {
    max-width: 1320px;
    margin: 0 auto;
    position: relative;
  }

  .cover-stack {
    position: relative;
  }

  @media (min-width: 861px) {
    .cover-stack > :global(.hero) {
      position: sticky;
      top: 0;
    }
  }

  @media (min-width: 861px) {
    .cover-stack > :global(.about-me),
    .cover-stack > :global(.timeline) {
      position: sticky;
      top: 0;
    }
  }

  .cover-stack > :global(.timeline) {
    z-index: 2;
  }

  .cover-stack > :global(.pgrid) {
    z-index: 3;
  }

</style>
