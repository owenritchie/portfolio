---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AboutMe from '../components/AboutMe.astro';
import ProjectsSection from '../components/projects/ProjectsSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import Timeline from '../components/timeline/Timeline.astro';
import Footer from '../components/Footer.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const projectsData = JSON.parse(
  readFileSync(join(process.cwd(), 'public/config/projects.json'), 'utf-8')
) as {
  title: string;
  subtitle: string;
  link?: string;
  image: string;
  colorTheme: string;
  comingSoon?: boolean;
  stack?: string[];
}[];

const timelineData = JSON.parse(
  readFileSync(join(process.cwd(), 'public/config/timeline.json'), 'utf-8')
) as {
  entries: {
    title: string;
    role: string;
    start: string;
    end: string;
    color?: string;
    link?: string;
    logo?: string;
    logoZoom?: number;
    logoFit?: 'cover' | 'contain';
    description?: string;
  }[];
  events?: { date: string; label: string; description?: string; link?: string }[];
};

// Timeline cuts off at the real current date (resolved at build time).
const today = new Date().toISOString().slice(0, 10);
---

<Layout title="Owen Ritchie">
  <main>
    <Hero />

    <AboutMe />

    <!-- Experience Timeline -->
    <Timeline now={today} entries={timelineData.entries} />

    <ProjectsSection projects={projectsData} />

    <SkillsSection />

    <Footer />
  </main>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap');

  /* Load-in Animation Keyframes */
  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeScale {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Animation Classes */
  :global(.animate-in) {
    opacity: 0;
    animation: fadeSlideUp 0.6s ease-out forwards;
  }

  :global(.animate-in-scale) {
    opacity: 0;
    animation: fadeScale 0.6s ease-out forwards;
  }

  :global(.animate-delay-1) { animation-delay: 0.1s; }
  :global(.animate-delay-2) { animation-delay: 0.2s; }
  :global(.animate-delay-3) { animation-delay: 0.3s; }
  :global(.animate-delay-4) { animation-delay: 0.4s; }
  :global(.animate-delay-5) { animation-delay: 0.5s; }

  main {
    max-width: 1320px;
    margin: 0 auto;
    position: relative;
  }

  main > :global(.theme-toggle) {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 100;
  }

  .bento {
    display: grid;
    grid-template-areas:
      "header header header photo"
      "about about about photo"
      "about about about map"
      "about about about art";
    grid-template-columns: 1fr 1fr 1fr 280px;
    grid-template-rows: auto 1fr 1fr 80px;
    gap: 1rem;
    min-height: 600px;
  }

  :global(.box) {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 1024px) {
    .bento {
      grid-template-columns: 1fr 1fr 1fr 240px;
    }
  }

  @media (max-width: 768px) {
    .bento {
      grid-template-areas:
        "header header"
        "photo photo"
        "map map"
        "about about"
        "art art";
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto 200px auto auto auto;
      min-height: auto;
    }
  }

  @media (max-width: 480px) {
    .bento {
      grid-template-areas:
        "header"
        "photo"
        "map"
        "about"
        "art";
      grid-template-columns: 1fr;
      grid-template-rows: auto 220px auto auto auto;
      gap: 0.75rem;
    }
  }
</style>
