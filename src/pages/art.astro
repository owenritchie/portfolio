---
import Layout from '../layouts/Layout.astro';
import IconLoopButton from '../components/IconLoopButton.astro';
import LampToggle from '../components/LampToggle.astro';
import FeaturedSection from '../components/art/FeaturedSection.astro';
import Gallery from '../components/art/Gallery.astro';
import Lightbox from '../components/art/Lightbox.astro';
import { readdir } from 'node:fs/promises';
import { resolve } from 'node:path';

const photosDir = resolve('./public/photos');
const photoFiles = (await readdir(photosDir))
  .filter(f => /\.(jpg|jpeg|png|webp|gif)$/i.test(f))
  .sort();
---

<Layout title="Art — Owen Ritchie">
  <div class="page">
    <div class="lamp-anchor">
      <div class="lamp">
        <LampToggle restLength={90} maxPull={36} size="46px" class="art-lamp" />
      </div>
    </div>

    <header class="page-header">
      <IconLoopButton
        icon="arrow-left"
        label="Back"
        direction="left"
        tip="right"
        variant="accent"
        href="/"
      />
    </header>

    <FeaturedSection />
    <Gallery photos={photoFiles} />
  </div>

  <Lightbox />
</Layout>

<style>
  .page {
    width: 100%;
    position: relative;
  }

  .lamp-anchor {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: 0;
    pointer-events: none;
  }

  .lamp {
    position: absolute;
    top: -3.5rem;
    right: 2.5rem;
    width: 46px;
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .lamp {
      top: -2.5rem;
    }
  }

  @media (max-width: 620px) {
    .lamp-anchor {
      display: none;
    }
  }

  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.2rem;
    margin-bottom: 3rem;
  }

  @media (max-width: 768px) {
    .page-header {
      margin-bottom: 2rem;
    }
  }
</style>
