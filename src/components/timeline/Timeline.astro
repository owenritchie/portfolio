---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Entry {
  title: string;
  role: string;
  start: string;
  end: string;
  color?: string;
  link?: string;
  logo?: string;
  logoZoom?: number;
  logoFit?: 'cover' | 'contain';
  cardColor?: string;
  description?: string;
  skills?: string[];
  hidden?: boolean;
}

interface Props {
  now: string;
  entries: Entry[];
}

const { now, entries } = Astro.props;

const skillIcons = new Map(
  (JSON.parse(readFileSync(join(process.cwd(), 'public/config/skills.json'), 'utf-8')) as {
    name: string;
    icon: string;
  }[]).map((s) => [s.name, s.icon] as const)
);

const resolveSkills = (names?: string[]) =>
  (names ?? []).map((name) => ({ name, icon: skillIcons.get(name) ?? '' }));

function toYear(value: string): number {
  const v = value === 'present' ? now : value;
  const [y, m, d] = v.split('-').map(Number);
  return y + ((m ?? 1) - 1) / 12 + ((d ?? 1) - 1) / 365;
}

const nowY = toYear(now);

const resolved = entries.filter((e) => !e.hidden).map((e) => ({
  ...e,
  startY: toYear(e.start),
  endY: Math.min(toYear(e.end), nowY),
}));

const domainStart = Math.min(...resolved.map((e) => e.startY));
const domainEnd = nowY;
const span = domainEnd - domainStart || 1;

const pct = (year: number) => ((year - domainStart) / span) * 100;
const clamp = (n: number) => Math.max(0, Math.min(100, n));

const bars = resolved
  .map((e) => ({
    ...e,
    startPct: clamp(pct(e.startY)),
    widthPct: Math.max(clamp(pct(e.endY)) - clamp(pct(e.startY)), 0),
    initial: e.title.charAt(0),
  }))
  .sort((a, b) => b.startY - a.startY);

const yearTicks = [];
for (let y = Math.ceil(domainStart); y <= Math.floor(domainEnd); y++) {
  yearTicks.push({ year: y, left: clamp(pct(y)) });
}

const lead = bars[0];

const fmtYear = (v: string) => (v === 'present' ? 'Present' : v.slice(0, 4));
const fmtRange = (e: { start: string; end: string }) => {
  const a = fmtYear(e.start);
  const b = fmtYear(e.end);
  return a === b ? a : `${a} — ${b}`;
};
---

<section id="work" class="timeline" aria-label="Work timeline" data-reveal="trigger">
  <h2 class="timeline-heading" data-reveal="up"><span class="th-long">Where I've done my work</span><span class="th-short">Work</span></h2>
  <div class="timeline-sub" data-reveal="up" style="--rd:0.06s">
    <a class="timeline-side-resume" href="/resume/owen-ritchie.pdf" target="_blank" rel="noopener">View my resume<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M8 13h8M8 17h5" /></svg></a>
  </div>

  <div class="timeline-shell">
    <div class="timeline-chart">
      {bars.map((bar, i) => {
        const logoStyle = [
          bar.logoFit ? `--logo-fit:${bar.logoFit}` : '',
          bar.logoZoom ? `--logo-zoom:${bar.logoZoom}` : '',
        ].filter(Boolean).join(';');
        return (
          <button
            type="button"
            class={`timeline-row${i === 0 ? ' is-active' : ''}`}
            style={`--i:${i};${bar.cardColor ? `--card-color:${bar.cardColor};` : ''}`}
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-title={bar.title}
            data-role={bar.role}
            data-desc={bar.description}
            data-link={bar.link}
            data-skills={JSON.stringify(resolveSkills(bar.skills))}
          >
            <span class="timeline-label">
              <span class="timeline-label-text">
                <span class="timeline-label-title">{bar.title}</span>
                <span class="timeline-label-role">{bar.role}</span>
                <span class="timeline-label-dates">{fmtRange(bar)}</span>
                {bar.description && <span class="timeline-label-desc">{bar.description}</span>}
                {resolveSkills(bar.skills).some((k) => k.icon) && (
                  <span class="timeline-label-skills">
                    {resolveSkills(bar.skills).map((k) => k.icon && (
                      <img src={k.icon} alt={`${k.name} logo`} title={k.name} width="22" height="22" loading="lazy" />
                    ))}
                  </span>
                )}
              </span>
              <span class="timeline-logo">
                {bar.logo
                  ? <img class="timeline-logo-img" src={bar.logo} alt={bar.title} width="64" height="64" loading="lazy" style={logoStyle || undefined} />
                  : <span class="timeline-logo-mono">{bar.initial}</span>}
              </span>
            </span>
            <span class="timeline-track">
              <span class="timeline-rail"></span>
              <span class="timeline-bar" style={`left:${bar.startPct}%; width:${bar.widthPct}%;`}></span>
            </span>
          </button>
        );
      })}

      <div class="timeline-axis" aria-hidden="true">
        {yearTicks.map((t) => (
          <span class="timeline-axis-year" style={`left:${t.left}%;`}>{t.year}</span>
        ))}
      </div>

      <nav class="tl-nav" aria-label="Browse work">
        <button type="button" class="tl-arrow" data-step="-1" aria-label="Previous job">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        {bars.map((bar, i) => (
          <button type="button" class={`tl-dot${i === 0 ? ' is-active' : ''}`} data-go={i} aria-label={`${bar.title}`}><span></span></button>
        ))}
        <button type="button" class="tl-arrow" data-step="1" aria-label="Next job">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </nav>
    </div>

    <aside class="timeline-side" aria-live="polite">
      <h3 class="timeline-side-title">
        <a
          class={`timeline-side-link${lead?.link ? '' : ' is-static'}`}
          href={lead?.link}
          target={lead?.link ? '_blank' : undefined}
          rel={lead?.link ? 'noopener' : undefined}
        >
          <span class="timeline-side-name">{lead?.title}</span>
        </a>
      </h3>
      <p class="timeline-side-role">{lead?.role}</p>
      <p class="timeline-side-desc">{lead?.description}</p>
      <ul class="timeline-side-skills" aria-label="Skills">
        {resolveSkills(lead?.skills).map((s) => (
          s.icon && (
            <li class="timeline-skill">
              <img class="timeline-skill-icon" src={s.icon} alt={`${s.name} logo`} title={s.name} width="36" height="36" loading="lazy" />
            </li>
          )
        ))}
      </ul>
    </aside>
  </div>

</section>

<style>
  .timeline {
    --bar: oklch(0.26 0.035 145);
    --bead: oklch(0.91 0.05 140);
    --rail: oklch(0.93 0.02 90);
    --label-col: 34%;
    --col-gap: 1.5rem;
    --row-h: 116px;
    --plot-left: calc(var(--label-col) + var(--col-gap));
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: calc(-1 * clamp(28px, 5vw, 52px));
    scroll-margin-top: 1.5rem;
    background: var(--bg);
    border-radius: clamp(28px, 5vw, 52px) clamp(28px, 5vw, 52px) 0 0;
    padding: clamp(2.5rem, 6vw, 4.5rem) max((100vw - 1120px) / 2, clamp(1.5rem, 5vw, 5rem)) clamp(5.5rem, 10vw, 8rem);
  }

  :global([data-theme="dark"]) .timeline {
    --bar: var(--accent);
    --bead: var(--accent);
    --rail: color-mix(in oklab, var(--text) 11%, transparent);
  }

  .timeline::before {
    content: "";
    display: none;
    position: absolute;
    inset: 0;
    border: var(--dash-width) dashed var(--dash-color);
    border-bottom: none;
    border-radius: inherit;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, black 0, black 6px, transparent 64px);
    mask-image: linear-gradient(to bottom, black 0, black 6px, transparent 64px);
  }

  :global([data-theme="dark"]) .timeline::before {
    display: block;
  }

  .timeline-heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    color: var(--text);
    text-align: center;
    margin: 0 0 0.9rem;
  }

  .th-short {
    display: none;
  }

  .tl-nav,
  .timeline-label-skills {
    display: none;
  }

  .timeline-sub {
    text-align: center;
    margin: 0 0 clamp(2.5rem, 6vw, 4.5rem);
  }


  @media (max-width: 860px) {
    .timeline-heading,
    .timeline-sub {
      text-align: left;
    }
  }

  .timeline-shell {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
  }

  .timeline-side {
    flex: 0 0 40%;
    position: sticky;
    top: 2.5rem;
    box-sizing: border-box;
    padding: clamp(1.8rem, 2.6vw, 2.5rem);
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: 16px;
  }

  .timeline-side-title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: clamp(2.2rem, 4.6vw, 3.9rem);
    line-height: 1.08;
    color: var(--text);
    margin: 0;
  }

  .timeline-side-resume {
    position: relative;
    display: inline-block;
    padding-bottom: 0.1rem;
    color: var(--text);
    font-family: 'Grenze', serif;
    font-size: 1.1rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1.5px;
    transition: background-size var(--dur-base) var(--ease-out);
  }

  .timeline-side-resume svg {
    display: inline-block;
    width: 1.05em;
    height: 1.05em;
    margin-left: 0.3em;
    vertical-align: -0.15em;
    opacity: 0;
  }

  .timeline-side-resume:hover,
  .timeline-side-resume:focus-visible {
    background-size: 100% 1.5px;
  }

  .timeline-side-resume:hover svg,
  .timeline-side-resume:focus-visible svg {
    opacity: 1;
  }

  .timeline-skill-icon {
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .timeline-skill-icon:hover {
    transform: rotate(360deg);
  }

  .timeline-side-role {
    font-family: 'Grenze', serif;
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0.7rem 0 0;
  }

  .timeline-side-link,
  .timeline-side-link:visited {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-base) var(--ease-out);
  }

  .timeline-side-link.is-static {
    pointer-events: none;
    cursor: default;
  }

  .timeline-side-link:hover {
    color: var(--bar);
  }

  :global(html[data-theme="dark"]) .timeline-side-link:hover {
    color: var(--text-muted);
  }

  .timeline-side-link:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  .timeline-side-desc {
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    line-height: 1.7;
    color: var(--text);
    opacity: 0.85;
    max-width: 52ch;
    margin: 1.4rem 0 0;
  }

  .timeline-side-skills {
    list-style: none;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(0.4rem, 0.8vw, 0.85rem);
    padding: 0;
    margin: 1.7rem 0 0;
  }

  .timeline-side-skills :global(.timeline-skill) {
    display: inline-flex;
    flex: 1 1 0;
    min-width: 0;
    max-width: 36px;
  }

  .timeline-side-skills :global(.timeline-skill-icon) {
    width: 100%;
    aspect-ratio: 1;
    height: auto;
    object-fit: contain;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .timeline-side-skills :global(.timeline-skill-icon:hover) {
    transform: scale(1.12);
  }

  .timeline-side-skills:empty {
    display: none;
    margin: 0;
  }

  .timeline-chart {
    flex: 1 1 auto;
    min-width: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 1rem;
    padding-bottom: 2.6rem;
  }

  .timeline-row {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    background: transparent;
    font: inherit;
    text-align: inherit;
    width: 100%;
    cursor: pointer;
    color: inherit;
    display: flex;
    gap: var(--col-gap);
    align-items: center;
    height: var(--row-h);
    position: relative;
    z-index: 1;
    opacity: 0;
    transform: translateY(8px);
    animation: tlIn var(--dur-slow) var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 0.06s);
    transition: opacity var(--dur-base) var(--ease-out);
  }

  @keyframes tlFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes tlIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .timeline-label {
    flex: 0 0 var(--label-col);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    gap: 0.8rem;
    min-width: 0;
  }

  .timeline-label-text {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    gap: 0.08rem;
    line-height: 1.12;
    min-width: 0;
  }

  .timeline-label-title {
    font-family: 'Grenze', serif;
    font-weight: 500;
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  /* Small-desktop / tablet landscape: the 34% label column is too narrow for "Consulting" */
  @media (min-width: 861px) and (max-width: 1100px) {
    .timeline {
      --label-col: 44%;
    }
  }

  .timeline-label-role,
  .timeline-label-dates,
  .timeline-label-desc {
    display: none;
  }

  .timeline-logo {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 15px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .timeline-row:hover .timeline-logo {
    transform: scale(1.09);
  }

  .timeline-logo-img {
    width: 100%;
    height: 100%;
    object-fit: var(--logo-fit, cover);
    transform: scale(var(--logo-zoom, 1));
  }

  .timeline-logo-mono {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bar);
    color: #eef4ec;
    font-family: var(--font-heading, system-ui), sans-serif;
    font-weight: 700;
    font-size: 1.6rem;
  }

  .timeline-track {
    flex: 1 1 auto;
    position: relative;
    align-self: stretch;
  }

  .timeline-rail {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    transform: translateY(-50%);
    background: var(--rail);
    border-radius: 2px;
  }

  .timeline-bar {
    position: absolute;
    top: 50%;
    height: 52px;
    min-width: 18px;
    border-radius: 999px;
    background: var(--bead);
    transform-origin: left center;
    transform: translateY(-50%) scaleX(0);
    animation: barIn var(--dur-slow) var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 0.09s + 0.25s);
  }

  @keyframes barIn {
    to { transform: translateY(-50%) scaleX(1); }
  }

  .timeline-row.is-active .timeline-bar {
    outline: var(--dash-width) dashed var(--dash-color);
    outline-offset: 4px;
  }

  .timeline-axis {
    position: absolute;
    left: var(--plot-left);
    right: 0;
    bottom: 0;
    height: 1.9rem;
  }

  .timeline-axis-year {
    position: absolute;
    bottom: 0;
    transform: translateX(-50%);
    font-family: 'Grenze', serif;
    font-weight: 500;
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    color: var(--text);
    opacity: 1;
    font-feature-settings: 'tnum';
  }

  @media (max-width: 860px) {
    .timeline-shell {
      flex-direction: column;
      gap: 1.5rem;
      align-items: stretch;
    }

    .timeline-chart {
      width: 100%;
    }

    .timeline-side {
      position: static;
      flex-basis: auto;
      width: 100%;
    }

    .timeline-side-desc {
      max-width: 64ch;
    }
  }

  @media (max-width: 860px) {
    .timeline-track,
    .timeline-axis,
    .timeline-side {
      display: none;
    }

    .timeline-shell {
      gap: 0;
    }

    .timeline-chart {
      padding-top: 0;
      padding-bottom: 0;
      gap: 0;
    }

    .timeline-row {
      height: auto;
      align-items: flex-start;
      cursor: default;
    }

    .th-long {
      display: none;
    }

    .th-short {
      display: inline;
    }

    .timeline-chart {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      touch-action: pan-y;
    }

    .timeline-row {
      grid-area: 1 / 1;
      padding: 1.15rem;
      border-radius: 20px;
      background: oklch(0.955 0.01 110);
      animation: none;
      opacity: 1;
      transform: none;
    }

    :global([data-theme="dark"]) .timeline-row {
      background: oklch(0.22 0.04 280);
    }

    .timeline-row:not(.is-active) {
      visibility: hidden;
    }

    .timeline-row.is-active {
      animation: tlFade var(--dur-slow) var(--ease-out);
    }

    .timeline-label-skills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      height: 22px;
      overflow: hidden;
      margin-top: 0.8rem;
    }

    .timeline-label-skills img {
      width: 22px;
      height: 22px;
      object-fit: contain;
    }

    .tl-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 0.75rem;
    }

    .tl-dot,
    .tl-arrow {
      display: grid;
      place-items: center;
      height: 44px;
      padding: 0;
      border: none;
      background: none;
      cursor: pointer;
    }

    .tl-dot {
      width: 28px;
    }

    .tl-arrow {
      width: 44px;
      color: var(--text-muted);
    }

    .tl-arrow svg {
      width: 18px;
      height: 18px;
    }

    .tl-arrow:active {
      color: var(--text);
    }

    .tl-dot span {
      display: block;
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: color-mix(in oklab, var(--text) 28%, transparent);
      transition: width var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);
    }

    .tl-dot.is-active span {
      width: 22px;
      background: var(--text);
    }

    .tl-dot:focus-visible,
    .tl-arrow:focus-visible {
      outline: 2px solid var(--text);
      outline-offset: -4px;
      border-radius: 8px;
    }

    .timeline-label {
      flex: 1 1 auto;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 0.9rem;
    }

    .timeline-logo {
      order: -1;
      width: 50px;
      height: 50px;
    }

    .timeline-label-text {
      flex: 1 1 auto;
      min-width: 0;
      align-items: flex-start;
      text-align: left;
      gap: 0.15rem;
    }

    .timeline-label-title {
      white-space: normal;
      font-size: 1.4rem;
      line-height: 1.1;
    }

    .timeline-label-role {
      display: block;
      font-family: 'Grenze', serif;
      font-size: 0.85rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .timeline-label-dates {
      display: block;
      font-family: 'Grenze', serif;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      opacity: 0.75;
    }

    .timeline-label-desc {
      display: block;
      font-size: 0.92rem;
      line-height: 1.55;
      color: var(--text);
      opacity: 0.82;
      margin-top: 0.5rem;
      max-width: none;
    }

    /* Logo + title block on top, description and skills run the full card width underneath */
    .timeline-label {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.15rem 0.9rem;
      align-items: start;
      width: 100%;
    }

    .timeline-label-text {
      display: contents;
    }

    .timeline-logo {
      grid-column: 1;
      grid-row: 1 / span 3;
    }

    .timeline-label-title,
    .timeline-label-role,
    .timeline-label-dates {
      grid-column: 2;
    }

    .timeline-label-desc,
    .timeline-label-skills {
      grid-column: 1 / -1;
    }

    .timeline-label-desc {
      margin-top: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-row {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .timeline-bar {
      animation: none;
      transform: translateY(-50%) scaleX(1);
    }
  }
</style>

<script>
  document.querySelectorAll('.timeline').forEach((scope) => {
    const root = scope as HTMLElement;
    const side = root.querySelector('.timeline-side');
    if (!side) return;
    const elRole = side.querySelector<HTMLElement>('.timeline-side-role');
    const elTitle = side.querySelector<HTMLElement>('.timeline-side-title');
    const elDesc = side.querySelector<HTMLElement>('.timeline-side-desc');
    const elSkills = side.querySelector<HTMLElement>('.timeline-side-skills');
    const rows = Array.from(root.querySelectorAll<HTMLElement>('.timeline-row'));

    function select(row: HTMLElement) {
      rows.forEach((r) => {
        const on = r === row;
        r.classList.toggle('is-active', on);
        r.setAttribute('aria-pressed', on ? 'true' : 'false');
      });

      if (elRole) elRole.textContent = row.dataset.role || '';
      if (elDesc) elDesc.textContent = row.dataset.desc || '';

      if (elSkills) {
        let skills: { name: string; icon: string }[] = [];
        try { skills = JSON.parse(row.dataset.skills || '[]'); } catch { skills = []; }
        elSkills.textContent = '';
        skills.forEach((s) => {
          if (!s.icon) return;
          const li = document.createElement('li');
          li.className = 'timeline-skill';
          const img = document.createElement('img');
          img.className = 'timeline-skill-icon';
          img.src = s.icon;
          img.alt = `${s.name} logo`;
          img.width = 36;
          img.height = 36;
          img.title = s.name;
          img.loading = 'lazy';
          li.appendChild(img);
          elSkills.appendChild(li);
        });
      }

      const a = elTitle?.querySelector<HTMLAnchorElement>('.timeline-side-link');
      const name = elTitle?.querySelector<HTMLElement>('.timeline-side-name');
      if (name) name.textContent = row.dataset.title || '';
      if (a) {
        const link = row.dataset.link;
        if (link) {
          a.href = link;
          a.target = '_blank';
          a.rel = 'noopener';
          a.classList.remove('is-static');
        } else {
          a.removeAttribute('href');
          a.classList.add('is-static');
        }
      }
    }

    rows.forEach((row) => {
      row.addEventListener('click', () => select(row));
    });
  });
</script>

<script>
  document.querySelectorAll<HTMLElement>('.timeline').forEach((root) => {
    const rows = Array.from(root.querySelectorAll<HTMLElement>('.timeline-row'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.tl-dot'));
    const chart = root.querySelector('.timeline-chart');
    if (!rows.length || !dots.length) return;

    const current = () => Math.max(0, rows.findIndex((r) => r.classList.contains('is-active')));

    const go = (i: number) => {
      const n = (i + rows.length) % rows.length;
      rows[n].click();
      dots.forEach((d, idx) => {
        d.classList.toggle('is-active', idx === n);
        if (idx === n) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    };

    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    root.querySelectorAll<HTMLElement>('.tl-arrow').forEach((a) => {
      a.addEventListener('click', () => go(current() + Number(a.dataset.step)));
    });

    let sx = 0;
    let sy = 0;
    chart?.addEventListener('touchstart', (e) => {
      const t = (e as TouchEvent).touches[0];
      sx = t.clientX;
      sy = t.clientY;
    }, { passive: true });
    chart?.addEventListener('touchend', (e) => {
      const t = (e as TouchEvent).changedTouches[0];
      const dx = t.clientX - sx;
      if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(t.clientY - sy) * 1.5) go(current() + (dx < 0 ? 1 : -1));
    }, { passive: true });
  });
</script>
