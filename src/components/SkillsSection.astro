---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const skills = JSON.parse(
  readFileSync(join(process.cwd(), 'public/config/skills.json'), 'utf-8')
) as { name: string; icon: string }[];
---

<section class="using" aria-label="Tools and technologies">
  <div class="using-stage">
    <div class="using-burn" aria-hidden="true">
      <div class="using-flare"></div>
    </div>

    <div class="using-frame">
      <div class="using-grid">
        {skills.map((s, i) => (
          <img src={s.icon} alt={s.name} title={s.name} loading="lazy" data-reveal="scale" style={`--rd:${(i * 0.04).toFixed(2)}s`} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .using {
    margin: clamp(3rem, 7vw, 5rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .using-stage {
    position: relative;
    max-width: 1050px;
    margin: 0 auto;
  }

  .using-frame {
    position: relative;
    z-index: 1;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1.5px dashed var(--border);
    border-radius: 18px;
  }

  :global([data-theme="dark"]) .using-frame {
    background: var(--bg);
  }

  .using-burn {
    display: none;
  }

  :global([data-theme="dark"]) .using-burn {
    display: block;
    position: absolute;
    inset: 0;
    border-radius: 18px;
    z-index: 0;
    --burn: linear-gradient(
      90deg,
      oklch(0.55 0.25 264) 0%,
      oklch(0.72 0.2 246) 11%,
      oklch(0.9 0.1 240) 21%,
      oklch(0.99 0.02 250) 33%,
      oklch(0.97 0.15 85) 45%,
      oklch(0.8 0.22 32) 57%,
      oklch(0.72 0.29 350) 69%,
      oklch(0.62 0.28 320) 80%,
      oklch(0.57 0.26 292) 90%,
      oklch(0.55 0.25 264) 100%
    );
  }

  :global([data-theme="dark"]) .using-burn::before,
  :global([data-theme="dark"]) .using-burn::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--burn);
    background-size: 200% 100%;
    pointer-events: none;
  }

  :global([data-theme="dark"]) .using-burn::before {
    z-index: 1;
    filter: blur(3px);
    opacity: 0.95;
  }

  :global([data-theme="dark"]) .using-burn::after {
    z-index: 0;
    filter: blur(12px);
    opacity: 0.45;
  }

  .using-flare {
    display: none;
  }

  :global([data-theme="dark"]) .using-flare {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      transparent 0%,
      oklch(0.9 0.16 65 / 0.25) 28%,
      oklch(1 0.05 90 / 1) 50%,
      oklch(0.9 0.16 65 / 0.25) 72%,
      transparent 100%
    );
    background-size: 40% 100%;
    background-repeat: no-repeat;
    background-position: 50% 50%;
    filter: blur(4px);
    pointer-events: none;
  }

  :global([data-theme="dark"]) .using-flare::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      transparent 0%,
      oklch(1 0.06 330 / 0.9) 50%,
      transparent 100%
    );
    background-size: 26% 100%;
    background-repeat: no-repeat;
    background-position: 50% 50%;
    filter: blur(5px);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-theme="dark"]) .using-burn::before {
      animation: burn-cycle 9s linear infinite;
    }
    :global([data-theme="dark"]) .using-burn::after {
      animation: burn-cycle 15s linear infinite reverse;
    }
    :global([data-theme="dark"]) .using-flare {
      animation: burn-flare 5.5s ease-in-out infinite;
    }
    :global([data-theme="dark"]) .using-flare::after {
      animation: burn-flare-2 8.5s ease-in-out infinite;
    }
  }

  @keyframes burn-cycle {
    from { background-position: 0% 50%; }
    to { background-position: 200% 50%; }
  }

  @keyframes burn-flare {
    0% { background-position: -25% 50%; opacity: 0; }
    12% { opacity: 0.45; }
    26% { opacity: 1; }
    40% { opacity: 0.5; }
    56% { opacity: 1; }
    72% { opacity: 0.55; }
    100% { background-position: 125% 50%; opacity: 0; }
  }

  @keyframes burn-flare-2 {
    0% { background-position: 120% 50%; opacity: 0; }
    45% { opacity: 0; }
    60% { opacity: 0.95; }
    75% { opacity: 0.2; }
    100% { background-position: -20% 50%; opacity: 0; }
  }

  .using-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: clamp(1rem, 2.4vw, 2rem);
    justify-items: center;
    align-items: center;
  }

  .using-grid img {
    width: clamp(34px, 5vw, 56px);
    height: clamp(34px, 5vw, 56px);
    object-fit: contain;
    cursor: pointer;
    transition: transform 0.5s ease;
  }

  .using-grid img:hover {
    transform: rotate(360deg) scale(1.15);
  }

  @media (max-width: 640px) {
    .using-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    :global([data-theme="dark"]) .using-burn::before,
    :global([data-theme="dark"]) .using-burn::after {
      animation: none;
    }

    :global([data-theme="dark"]) .using-flare {
      display: none;
    }
  }
</style>
