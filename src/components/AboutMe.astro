---
import AboutMap from './AboutMap.astro';
---

<section id="me" class="about-me">
  <div class="about-me-inner">
    <figure class="about-me-figure" data-reveal="up">
      <img
        class="about-me-portrait"
        src="/me/owen-960.webp"
        srcset="/me/owen-480.webp 480w, /me/owen-960.webp 960w"
        sizes="(min-width: 861px) 460px, 100vw"
        width="960"
        height="1280"
        alt="Owen Ritchie"
        loading="lazy"
      />
    </figure>

    <div class="about-me-content">
      <h2 class="about-me-heading" data-reveal="up" style="--rd:0.06s">About Me</h2>
      <p data-reveal="up" style="--rd:0.12s">
        Hey, I'm Owen — a student, engineer &amp; designer currently based in Ottawa, ON. I love
        working on creative and meaningful projects, and spend lots of my free time outside hiking,
        skiing and playing various sports. I also love the arts, where I'm interested in design
        philosophy &amp; engineering, playing music, and photography (photojournalism, wildlife).
      </p>
      <p data-reveal="up" style="--rd:0.18s">
        Always happy to talk, so feel free to <a href="mailto:owenritchie04@gmail.com">reach out</a>!
      </p>

      <AboutMap />
    </div>
  </div>
</section>

<style>
  .about-me {
    --card: oklch(0.3 0.09 145);
    --border: oklch(0.55 0.07 145);
    --dash-color: oklch(1 0 0 / 0.32);
    --text: oklch(0.95 0.02 130);
    --text-muted: oklch(0.75 0.04 130);
    --accent: oklch(0.7 0.15 150);
    --accent-2: oklch(0.78 0.09 60);
    position: relative;
    z-index: 1;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: 0;
    scroll-margin-top: 1rem;
    background: var(--card);
    border-radius: clamp(28px, 5vw, 52px) clamp(28px, 5vw, 52px) 0 0;
    padding: clamp(3rem, 8vw, 6.5rem) clamp(1.5rem, 5vw, 5rem) clamp(4.5rem, 10vw, 8rem);
    overflow: hidden;
  }

  :global([data-theme="dark"]) .about-me {
    --card: inherit;
    --border: inherit;
    --dash-color: inherit;
    --text: inherit;
    --text-muted: inherit;
    --accent: inherit;
    --accent-2: inherit;
  }

  .about-me::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  :global([data-theme="dark"]) .about-me::after {
    border: var(--dash-width) dashed var(--dash-color);
    border-bottom: none;
    -webkit-mask-image: linear-gradient(to bottom, black 0, black 3%, transparent 14%);
    mask-image: linear-gradient(to bottom, black 0, black 3%, transparent 14%);
  }

  .about-me-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: stretch;
  }

  .about-me-figure {
    position: relative;
    margin: 0;
    padding: 12px;
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: calc(clamp(20px, 3vw, 32px) + 12px);
  }

  .about-me-portrait {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: clamp(20px, 3vw, 32px);
  }

  .about-me-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .about-me-content :global(.about-map.about-map) {
    width: 100%;
    flex: 1 1 auto;
    height: auto;
    min-height: 180px;
    margin-top: 2rem;
  }

  .about-me-heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    color: var(--text);
    margin: 0 0 1.25rem;
  }

  .about-me-content p {
    color: var(--text-muted);
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.7;
    max-width: none;
    margin: 0 0 1rem;
  }

  .about-me-content p a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
  }

  .about-me-content p:last-of-type {
    margin-bottom: 0;
  }

  @media (max-width: 860px) {
    .about-me-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-me {
      padding-bottom: calc(clamp(4.5rem, 10vw, 8rem) + clamp(28px, 5vw, 52px));
    }

    .about-me-figure {
      max-width: 380px;
    }

    .about-me-content p {
      max-width: 62ch;
    }

    .about-me-content :global(.about-map.about-map) {
      flex: none;
    }
  }

  @media (min-width: 481px) and (max-width: 860px) {
    .about-me-figure {
      max-width: none;
    }

    .about-me-portrait {
      aspect-ratio: 16 / 10;
      object-position: 50% 38%;
    }
  }
</style>
