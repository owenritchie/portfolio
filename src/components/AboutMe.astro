---
import AboutMap from './AboutMap.astro';
---

<section id="me" class="about-me">
  <div class="about-me-inner">
    <div class="about-me-content">
      <img class="about-me-portrait" src="/me/owen.png" alt="Owen Ritchie" loading="lazy" data-reveal="up" />

      <h2 class="about-me-heading" data-reveal="up" style="--rd:0.06s">About Me</h2>
      <p data-reveal="up" style="--rd:0.12s">
        Hey, I'm Owen — a student, engineer &amp; designer currently based in Ottawa, ON. I love
        working on creative and meaningful projects, and spend lots of my free time outside hiking,
        skiing and playing various sports. I also love the arts, where I'm interested in design
        philosophy &amp; engineering, playing music, photography, and more specifically
        photojournalism.
      </p>
      <p data-reveal="up" style="--rd:0.18s">
        Always happy to talk, so feel free to reach out!
      </p>

      <a
        class="about-me-mail"
        href="mailto:owenritchie04@gmail.com"
        data-reveal="up"
        style="--rd:0.24s"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
          <path d="m3 7 8.1 5.4a1.6 1.6 0 0 0 1.8 0L21 7" />
        </svg>
        <span>Email me</span>
      </a>
    </div>

    <AboutMap />
  </div>
</section>

<style>
  .about-me {
    --card: oklch(0.3 0.09 145);
    --border: oklch(0.55 0.07 145);
    --text: oklch(0.95 0.02 130);
    --text-muted: oklch(0.75 0.04 130);
    --accent: oklch(0.7 0.15 150);
    --accent-2: oklch(0.78 0.09 60);
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: clamp(3rem, 7vw, 6rem);
    scroll-margin-top: 1rem;
    background: var(--card);
    border-radius: clamp(28px, 5vw, 52px) clamp(28px, 5vw, 52px) 0 0;
    padding: clamp(3rem, 8vw, 6.5rem) clamp(1.5rem, 5vw, 5rem) clamp(4.5rem, 10vw, 8rem);
    overflow: hidden;
  }

  :global([data-theme="dark"]) .about-me {
    --card: inherit;
    --border: inherit;
    --text: inherit;
    --text-muted: inherit;
    --accent: inherit;
    --accent-2: inherit;
  }

  .about-me::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  :global([data-theme="dark"]) .about-me::after {
    border: 1.5px dashed var(--border);
    border-bottom: none;
    -webkit-mask-image: linear-gradient(to bottom, black 0, black 3%, transparent 14%);
    mask-image: linear-gradient(to bottom, black 0, black 3%, transparent 14%);
  }

  .about-me-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: stretch;
  }

  .about-me-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .about-me-portrait {
    display: block;
    width: clamp(120px, 20vw, 180px);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 16px;
    margin-bottom: 1.5rem;
  }

  .about-me-heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    color: var(--text);
    margin: 0 0 1.25rem;
  }

  .about-me-content p {
    color: var(--text-muted);
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.7;
    max-width: min(52ch, 100%);
    margin: 0 0 1rem;
  }

  .about-me-content p:last-of-type {
    margin-bottom: 0;
  }

  .about-me-mail {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.6rem;
    height: 3.1rem;
    padding: 0 1.7rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: var(--bg);
    border: 1.5px dashed transparent;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-me-mail svg {
    width: 20px;
    height: 20px;
  }

  .about-me-mail::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    border-radius: 999px;
    transition:
      inset 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.3s ease;
  }

  .about-me-mail::after {
    content: "";
    position: absolute;
    inset: -7px;
    z-index: -1;
    border: 1.5px dashed var(--border);
    border-radius: 999px;
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-me-mail:hover {
    transform: translateY(-2px);
  }

  .about-me-mail:hover::before {
    filter: brightness(1.08);
  }

  .about-me-mail:hover::after,
  .about-me-mail:focus-visible::after {
    opacity: 1;
    transform: scale(1);
  }

  .about-me-mail:active::before {
    inset: -7px;
  }

  .about-me-mail:focus-visible {
    outline: none;
  }

  :global([data-theme="dark"]) .about-me-mail {
    color: var(--text);
    border-color: var(--border);
  }

  :global([data-theme="dark"]) .about-me-mail::before {
    background: var(--card);
  }

  :global([data-theme="dark"]) .about-me-mail:hover::before {
    filter: none;
    background: color-mix(in oklch, var(--card) 78%, var(--accent) 22%);
  }

  @media (prefers-reduced-motion: reduce) {
    .about-me-mail,
    .about-me-mail::before,
    .about-me-mail::after {
      transition: none;
    }

    .about-me-mail:hover {
      transform: none;
    }
  }

  @media (max-width: 820px) {
    .about-me-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
