---
import AboutMap from './AboutMap.astro';
---

<section id="me" class="about-me">
  <div class="about-me-inner">
    <figure class="about-me-figure" data-reveal="up">
      <img
        class="about-me-portrait"
        src="/me/owen-1440.webp"
        srcset="/me/owen-480.webp 480w, /me/owen-960.webp 960w, /me/owen-1440.webp 1440w"
        sizes="(min-width: 861px) 720px, 100vw"
        width="960"
        height="1280"
        alt="Owen Ritchie"
        loading="lazy"
        draggable="false"
      />
    </figure>

    <div class="about-me-content">
      <h2 class="about-me-heading" data-reveal="up" style="--rd:0.06s">About Me</h2>
      <p data-reveal="up" style="--rd:0.12s">
        Hey, I'm Owen — a student, engineer &amp; designer currently based in Ottawa, ON. I love
        working on creative and meaningful projects, and spend lots of my free time outside hiking,
        skiing and playing various sports. I also love the arts, where I'm interested in design
        philosophy, playing music, and photography (photojournalism, wildlife).
      </p>
      <p data-reveal="up" style="--rd:0.18s">
        Always happy to talk, so feel free to <a href="mailto:owenritchie04@gmail.com">reach out<svg class="mail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 7 8.5 6.5L20.5 7" /></svg></a>!
      </p>

      <AboutMap />
    </div>
  </div>
</section>

<style>
  .about-me {
    --card: oklch(0.955 0.01 110);
    --border: oklch(0.85 0.01 120);
    --text: oklch(0.26 0.035 145);
    --text-muted: oklch(0.48 0.04 145);
    --accent: oklch(0.5 0.16 145);
    --accent-2: oklch(0.74 0.07 60);
    position: relative;
    z-index: 1;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: 0;
    scroll-margin-top: 1rem;
    background: var(--card);
    border-radius: clamp(28px, 5vw, 52px) clamp(28px, 5vw, 52px) 0 0;
    padding: clamp(3rem, 8vw, 6.5rem) clamp(1.5rem, 5vw, 5rem) clamp(4.5rem, 10vw, 8rem);
    overflow: hidden;
  }

  :global([data-theme="dark"]) .about-me {
    --card: inherit;
    --border: inherit;
    --text: inherit;
    --text-muted: inherit;
    --accent: inherit;
    --accent-2: inherit;
  }

  .about-me::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  :global([data-theme="dark"]) .about-me::after {
    border: var(--dash-width) dashed var(--dash-color);
    border-bottom: none;
    -webkit-mask-image: linear-gradient(to bottom, black 0, black 3%, transparent 14%);
    mask-image: linear-gradient(to bottom, black 0, black 3%, transparent 14%);
  }

  .about-me-inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: stretch;
  }

  .about-me-figure {
    position: relative;
    margin: 0;
    padding: 12px;
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: calc(clamp(20px, 3vw, 32px) + 12px);
  }

  .about-me-figure.is-jelly {
    cursor: grab;
  }

  .about-me-figure.is-held {
    cursor: grabbing;
    user-select: none;
  }

  .about-me-portrait {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: clamp(20px, 3vw, 32px);
  }

  .about-me-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .about-me-content :global(.about-map.about-map) {
    width: 100%;
    flex: 1 1 auto;
    height: auto;
    min-height: 180px;
    margin-top: 2rem;
  }

  .about-me-heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    color: var(--text);
    margin: 0 0 1.25rem;
  }

  .about-me-content p {
    color: var(--text-muted);
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.7;
    max-width: none;
    margin: 0 0 1rem;
  }

  .about-me-content p a {
    color: var(--text);
    text-decoration: none;
    padding-bottom: 0.1rem;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1.5px;
    transition: background-size var(--dur-base) var(--ease-out);
  }

  .about-me-content p a .mail-icon {
    display: inline-block;
    width: 0;
    height: 0.95em;
    margin-left: 0;
    vertical-align: -0.12em;
    opacity: 0;
    transition:
      width var(--dur-base) var(--ease-out),
      margin-left var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out);
  }

  .about-me-content p a:hover .mail-icon,
  .about-me-content p a:focus-visible .mail-icon {
    width: 0.95em;
    margin-left: 0.3em;
    opacity: 1;
  }

  .about-me-content p a:hover,
  .about-me-content p a:focus-visible {
    background-size: 100% 1.5px;
  }

  .about-me-content p:last-of-type {
    margin-bottom: 0;
  }

  @media (max-width: 860px) {
    .about-me-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-me {
      padding-bottom: calc(clamp(4.5rem, 10vw, 8rem) + clamp(28px, 5vw, 52px));
    }

    .about-me-figure {
      max-width: 380px;
    }

    .about-me-content p {
      max-width: 62ch;
    }

    .about-me-content :global(.about-map.about-map) {
      flex: none;
    }
  }

  @media (min-width: 481px) and (max-width: 860px) {
    .about-me-figure {
      max-width: none;
    }

    .about-me-portrait {
      aspect-ratio: 16 / 10;
      object-position: 50% 38%;
    }
  }
</style>

<script>
  type Spring = { x: number; y: number; vx: number; vy: number; k: number; c: number };

  const fig = document.querySelector<HTMLElement>('.about-me-figure');
  const img = fig?.querySelector<HTMLImageElement>('.about-me-portrait');

  if (fig && img && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const frame: Spring = { x: 0, y: 0, vx: 0, vy: 0, k: 170, c: 7 };
    const photo: Spring = { x: 0, y: 0, vx: 0, vy: 0, k: 110, c: 6 };
    const MAX_PULL = 16;
    const WOBBLE = 0.0018;

    let tx = 0;
    let ty = 0;
    let held = false;
    let raf = 0;
    let last = 0;
    let originX = 0;
    let originY = 0;

    const step = (s: Spring, dt: number) => {
      s.vx += (-s.k * (s.x - tx) - s.c * s.vx) * dt;
      s.vy += (-s.k * (s.y - ty) - s.c * s.vy) * dt;
      s.x += s.vx * dt;
      s.y += s.vy * dt;
    };

    const resting = (s: Spring) =>
      Math.abs(s.x) < 0.01 && Math.abs(s.y) < 0.01 && Math.abs(s.vx) < 0.05 && Math.abs(s.vy) < 0.05;

    const tick = (now: number) => {
      const dt = Math.min((now - last) / 1000, 1 / 30) / 2;
      last = now;
      for (let i = 0; i < 2; i++) {
        step(frame, dt);
        step(photo, dt);
      }

      if (!held && tx === 0 && ty === 0 && resting(frame) && resting(photo)) {
        fig.style.transform = '';
        img.style.transform = '';
        frame.x = frame.y = frame.vx = frame.vy = 0;
        photo.x = photo.y = photo.vx = photo.vy = 0;
        raf = 0;
        return;
      }

      const ax = Math.abs(frame.x);
      const ay = Math.abs(frame.y);
      const sx = 1 + (ax - 0.5 * ay) * WOBBLE;
      const sy = 1 + (ay - 0.5 * ax) * WOBBLE;
      fig.style.transform =
        `translate(${frame.x}px, ${frame.y}px) rotate(${frame.x * 0.02}deg) ` +
        `skew(${-frame.y * 0.03}deg, ${frame.x * 0.03}deg) scale(${sx}, ${sy})`;
      img.style.transform = `translate(${photo.x - frame.x}px, ${photo.y - frame.y}px)`;
      raf = requestAnimationFrame(tick);
    };

    const wake = () => {
      if (raf) return;
      last = performance.now();
      raf = requestAnimationFrame(tick);
    };

    const release = () => {
      if (!held) return;
      held = false;
      tx = ty = 0;
      fig.classList.remove('is-held');
      wake();
    };

    fig.classList.add('is-jelly');
    fig.addEventListener('dragstart', (e) => e.preventDefault());

    fig.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch' || e.button !== 0) return;
      held = true;
      originX = e.clientX;
      originY = e.clientY;
      fig.setPointerCapture(e.pointerId);
      fig.classList.add('is-held');
      wake();
    });

    fig.addEventListener('pointermove', (e) => {
      if (!held) return;
      const dx = e.clientX - originX;
      const dy = e.clientY - originY;
      const mag = Math.hypot(dx, dy);
      if (!mag) return;
      const pull = MAX_PULL * Math.tanh(mag / (MAX_PULL * 2.5));
      tx = (dx / mag) * pull;
      ty = (dy / mag) * pull;
    });

    fig.addEventListener('pointerup', release);
    fig.addEventListener('pointercancel', release);
    fig.addEventListener('lostpointercapture', release);
  }
</script>
