---
import AboutMap from './AboutMap.astro';

---

<section id="me" class="about-me">

  <div class="about-board-wrap">
    <div class="about-board" style="--cols:44">
      <h2 class="about-title" data-reveal="blur">About Me</h2>

      <img class="about-me-portrait" src="/me/owen.png" alt="Owen Ritchie" loading="lazy" data-reveal="scale" style="--rd:0.1s" />

      <div class="about-me-content" data-reveal="up" style="--rd:0.2s">
        <p data-reveal="up" style="--rd:0.35s">
        Hey, I'm Owen — a student, engineer &amp; designer currently based in Ottawa, ON. I love
        working on creative and meaningful projects, and spend lots of my free time outside hiking,
        skiing and playing various sports. I also love the arts, where I'm interested in design
        philosophy &amp; engineering, playing music, photography, and more specifically
        photojournalism.
      </p>
        <p data-reveal="up" style="--rd:0.45s">
        Always happy to talk, so feel free to reach out!
      </p>
      </div>

      <div class="about-map-slot" data-reveal="scale" style="--rd:0.3s">
        <AboutMap />
      </div>
    </div>
  </div>
</section>

<style>
  .about-me {
    --card: oklch(0.3 0.09 145);
    --border: oklch(0.55 0.07 145);
    --text: oklch(0.95 0.02 130);
    --text-muted: oklch(0.75 0.04 130);
    --accent: oklch(0.7 0.15 150);
    --accent-2: oklch(0.78 0.09 60);
    --panel: color-mix(in oklch, var(--card) 88%, black);
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: clamp(3rem, 7vw, 6rem);
    scroll-margin-top: 1rem;
    background: var(--card);
    border-radius: clamp(28px, 5vw, 52px) clamp(28px, 5vw, 52px) 0 0;
    padding: clamp(3rem, 8vw, 6.5rem) clamp(1.5rem, 5vw, 5rem) clamp(4.5rem, 10vw, 8rem);
    overflow: hidden;
  }

  :global([data-theme="dark"]) .about-me {
    --card: inherit;
    --border: inherit;
    --text: inherit;
    --text-muted: inherit;
    --accent: inherit;
    --accent-2: inherit;
  }

  .about-board-wrap {
    position: relative;
    z-index: 1;
    container-type: inline-size;
    max-width: 1120px;
    margin: 0 auto;
  }

  .about-board {
    --t: calc(100cqw / var(--cols));
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-template-rows: auto var(--t) repeat(16, var(--t));
  }

  .about-title {
    grid-area: 1 / 1 / 2 / -1;
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: calc(100cqw / 4.32);
    line-height: 0.9;
    letter-spacing: -0.015em;
    white-space: nowrap;
    color: color-mix(in oklch, var(--text) 24%, var(--card));
  }

  .about-me-portrait {
    grid-area: 3 / 1 / 19 / 13;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 14px;
  }

  .about-me-content {
    grid-area: 3 / 14 / 19 / 29;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--t) * 0.8);
    background: var(--panel);
    border-radius: 14px;
    overflow: hidden;
  }

  .about-me-content p {
    color: var(--text-muted);
    font-size: clamp(0.95rem, 1.38vw, 1.17rem);
    line-height: 1.6;
    margin: 0 0 0.7rem;
  }

  .about-me-content p:last-of-type {
    margin-bottom: 0;
  }

  .about-map-slot {
    grid-area: 3 / 30 / 19 / -1;
    position: relative;
    min-height: 0;
  }

  .about-map-slot :global(.about-map) {
    border-radius: 14px;
    min-height: 0;
    height: 100%;
  }

  .about-map-slot :global(.about-map-pin-ring) {
    border-style: solid;
    border-width: 1.5px;
  }

  @media (max-width: 820px) {
    .about-board {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .about-title {
      margin-bottom: 0.8rem;
    }

    .about-me-portrait {
      height: auto;
      aspect-ratio: 4 / 3;
    }

    .about-me-content {
      margin-top: 0;
      padding: 1.1rem;
    }

    .about-me-content p {
      font-size: 1rem;
    }

    .about-map-slot {
      display: none;
    }

    .about-me {
      padding-bottom: calc(clamp(4.5rem, 10vw, 8rem) + clamp(28px, 5vw, 52px));
    }
  }
</style>
