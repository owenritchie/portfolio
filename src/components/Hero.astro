---
import LampToggle from './LampToggle.astro';

---

<header class="hero">
  <p class="hero-name" data-reveal="up">Owen Ritchie</p>

  <div class="hero-tilt">
    <div class="hero-media" data-reveal="scale" style="--rd:0.06s">
      <img
        class="hero-img hero-img-light"
        src="/hero/light-hero-1800.webp"
        srcset="/hero/light-hero-960.webp 960w, /hero/light-hero-1800.webp 1800w"
        sizes="(min-width: 1081px) 836px, 100vw"
        width="1800"
        height="1133"
        alt="Macro shot of two ants on a branch against a dark green background"
        fetchpriority="high"
      />
      <img
        class="hero-img hero-img-dark"
        src="/hero/dark-hero-1800.webp"
        srcset="/hero/dark-hero-960.webp 960w, /hero/dark-hero-1800.webp 1800w"
        sizes="(min-width: 1081px) 836px, 100vw"
        width="1800"
        height="1065"
        alt="Stone staircase climbing a Mayan pyramid at dusk"
        fetchpriority="high"
      />
      <h1 class="hero-big"><span>Owen Ritchie</span></h1>
      <span class="hero-shine" aria-hidden="true"></span>
    </div>
  </div>

  <div class="hero-hint">
    <button type="button" class="auto-btn" id="autoscroll" aria-label="Enable autoscroll">
      <span class="ab-icon" aria-hidden="true">
        <span class="ab-viewport">
          <span class="ab-glyph ab-lead"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="6.5" y="3" width="11" height="18" rx="5.5" /><path d="M12 7v3" /></svg></span>
          <span class="ab-glyph ab-next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="6.5" y="3" width="11" height="18" rx="5.5" /><path d="M12 7v3" /></svg></span>
        </span>
      </span>
      <span class="ab-text" aria-hidden="true"><span>Enable autoscroll</span></span>
    </button>
  </div>
</header>

<div class="lamp-anchor">
  <div class="lamp">
    <LampToggle restLength={90} maxPull={36} size="46px" class="hero-lamp" />
  </div>
</div>

<script>
  const big = document.querySelector<HTMLElement>('.hero-big');
  const media = document.querySelector<HTMLElement>('.hero-media');

  if (big && media) {
    const fit = () => {
      if (!media.clientWidth) return;
      big.style.fontSize = '100px';
      const style = getComputedStyle(big);
      const room = media.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
      const text = big.firstElementChild as HTMLElement;
      big.style.fontSize = `${((100 * room) / text.offsetWidth) * 0.99}px`;
    };
    document.fonts.ready.then(fit);
    new ResizeObserver(fit).observe(media);
  }

  const hint = document.querySelector<HTMLElement>('.hero-hint');
  if (hint) {
    const update = () => hint.classList.toggle('is-gone', scrollY > 0);

    addEventListener('scroll', update, { passive: true });
    update();
  }

  const auto = document.getElementById('autoscroll');
  if (auto) {
    const SPEED = 150;
    const root = document.documentElement;
    let running = false;
    let raf = 0;
    let last = 0;
    let holdUntil = 0;
    let y = 0;

    const stop = () => {
      if (!running) return;
      running = false;
      root.classList.remove('autoscrolling');
      dispatchEvent(new CustomEvent('autoscroll', { detail: false }));
      cancelAnimationFrame(raf);
      root.style.scrollBehavior = '';
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => removeEventListener(t, stop));
    };

    const tick = (now: number) => {
      if (!running) return;
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      if (now >= holdUntil) {
        y += SPEED * dt;
        scrollTo(0, y);
      }
      if (y >= root.scrollHeight - innerHeight - 1) return stop();
      raf = requestAnimationFrame(tick);
    };

    auto.addEventListener('click', (e) => {
      e.stopPropagation();
      y = scrollY;
      running = true;
      root.classList.add('autoscrolling');
      dispatchEvent(new CustomEvent('autoscroll', { detail: true }));
      root.style.scrollBehavior = 'auto';
      last = performance.now();
      holdUntil = last + 300;
      setTimeout(() => ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => addEventListener(t, stop, { passive: true })), 0);
      raf = requestAnimationFrame(tick);
    });
  }

</script>

<style>
  .hero {
    max-width: 58rem;
    margin-inline: auto;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: clamp(2rem, 8cqw, 5rem);
    padding-bottom: clamp(1rem, 3cqw, 2rem);
    position: relative;
    isolation: isolate;
    container-type: inline-size;
  }

  .lamp-anchor {
    position: fixed;
    top: 2rem;
    left: 0;
    width: 100vw;
    height: 0;
    z-index: 150;
    pointer-events: none;
  }

  .lamp {
    position: absolute;
    top: -3.5rem;
    right: 2.5rem;
    width: 46px;
    z-index: 3;
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .lamp {
      top: -2.5rem;
    }
  }

  .hero-name {
    display: none;
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: clamp(2.4rem, 11cqw, 3.4rem);
    line-height: 1;
    color: var(--heading-ink);
    margin: 0 0 1.2rem;
  }

  .hero-tilt {
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .hero-media {
    --inset: clamp(1rem, 3cqw, 1.9rem);
    flex-shrink: 0;
    aspect-ratio: 16 / 9;
    border-radius: clamp(16px, 3cqw, 28px);
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(to top, rgb(0 0 0 / 0.35), transparent 45%);
  }

  :global([data-theme="dark"]) .hero-media::after {
    display: none;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-img-dark {
    display: none;
  }

  :global([data-theme="dark"]) .hero-img-light {
    display: none;
  }

  :global([data-theme="dark"]) .hero-img-dark {
    display: block;
  }

  .hero-big {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: calc(var(--inset) * 0.55);
    margin: 0;
    padding: 0 var(--inset);
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: 15cqw;
    line-height: 0.8;
    letter-spacing: -0.015em;
    white-space: nowrap;
    color: var(--bg);
    text-align: center;
  }

  :global([data-theme="dark"]) .hero-big {
    color: var(--heading-ink);
  }

  .hero-shine {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    background:
      linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.5) 50%, transparent 65%) no-repeat 0 0 / 250% 100%,
      linear-gradient(to bottom, rgb(255 255 255 / 0.22), transparent 55%);
    background-position: 120% 0, 0 0;
    mix-blend-mode: soft-light;
  }

  .hero-hint {
    display: flex;
    justify-content: center;
    gap: 1.1rem;
    margin: clamp(1.5rem, 6vh, 3.5rem) 0 auto;
    transition: opacity var(--dur-base) var(--ease-out), visibility 0s linear 0s;
  }

  .auto-btn {
    --ab-travel: 150%;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0;
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: 999px;
    background: transparent;
    color: oklch(0.42 0.06 70);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--dur-base) var(--ease-out);
  }

  :global(:root:not([data-theme="dark"])) .auto-btn {
    background: oklch(0.26 0.035 145);
    border-color: transparent;
    color: oklch(0.945 0.013 92);
  }

  :global(:root:not([data-theme="dark"])) .auto-btn::after {
    border-color: oklch(0.45 0.04 145);
  }

  :global(:root:not([data-theme="dark"])) .auto-btn:is(:hover, :focus-visible) {
    background: oklch(0.34 0.05 145);
  }

  :global([data-theme="dark"]) .auto-btn {
    color: oklch(0.84 0.07 295);
  }

  .ab-icon {
    position: relative;
    flex: none;
    width: 45px;
    height: 45px;
  }

  .ab-viewport {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    overflow: hidden;
  }

  .ab-glyph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .ab-glyph svg {
    width: 22px;
    height: 22px;
  }

  .ab-next {
    transform: translateY(calc(-1 * var(--ab-travel)));
  }

  .ab-text {
    display: grid;
    grid-template-columns: 0fr;
    overflow: hidden;
    white-space: nowrap;
    transition: grid-template-columns var(--dur-slow) var(--ease-out);
  }

  .ab-text span {
    min-width: 0;
    padding-right: 0;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out), padding var(--dur-slow) var(--ease-out);
  }

  .auto-btn::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -8.5px;
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: 999px;
    opacity: 0;
    transform: scale(0.94);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }

  .auto-btn:focus-visible {
    outline: none;
  }

  .auto-btn:is(:hover, :focus-visible) {
    background: color-mix(in oklch, var(--dash-color) 25%, transparent);
  }

  .auto-btn:is(:hover, :focus-visible) .ab-text {
    grid-template-columns: 1fr;
  }

  .auto-btn:is(:hover, :focus-visible) .ab-text span {
    opacity: 1;
    padding-right: 1.2rem;
  }

  .auto-btn:is(:hover, :focus-visible) .ab-lead {
    transform: translateY(var(--ab-travel));
  }

  .auto-btn:is(:hover, :focus-visible) .ab-next {
    transform: none;
  }

  .auto-btn:is(:hover, :focus-visible)::after {
    opacity: 1;
    transform: scale(1);
  }

  .hero-hint.is-gone {
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base);
  }

  @keyframes hero-tilt {
    from { transform: perspective(900px) rotateX(0deg) scale(1); }
    to { transform: perspective(900px) rotateX(48deg) scale(0.94); }
  }

  @keyframes hero-shine {
    0% { opacity: 0; background-position: 120% 0, 0 0; }
    35% { opacity: 1; }
    100% { opacity: 1; background-position: -20% 0, 0 0; }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-tilt,
      .hero-shine {
        animation-timeline: scroll(root);
        animation-range: 0 85vh;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-duration: 1ms;
      }

      .hero-tilt {
        animation-name: hero-tilt;
        transform-origin: 50% 100%;
        will-change: transform;
      }

      .hero-shine {
        animation-name: hero-shine;
      }
    }
  }

  @media (max-width: 1024px), (pointer: coarse) {
    .lamp-anchor {
      display: none;
    }
  }

  /* Tablet: line the hero up with the section gutters below instead of the narrower desktop column */
  @media (max-width: 1080px) {
    .hero {
      max-width: none;
      padding-inline: max(0px, calc(clamp(1.5rem, 5vw, 5rem) - 2rem));
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding-inline: max(0px, calc(clamp(1.5rem, 5vw, 5rem) - 1rem));
    }
  }

  @media (min-width: 861px) and (orientation: portrait) {
    .hero {
      min-height: 0;
    }

    .hero-media {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 860px) {
    .hero {
      min-height: 0;
    }
  }

  @media (max-width: 680px) {
    .hero-name {
      display: block;
      text-align: center;
    }

    .hero-tilt,
    .hero-hint {
      display: none;
    }

    .hero {
      padding-bottom: 0.5rem;
    }
  }
</style>
