---
import LampToggle from './LampToggle.astro';

const navLinks = [
  { label: 'Me', href: '#me' },
  { label: 'Work', href: '#work' },
  { label: 'Projects', href: '#projects' },
  { label: 'Art', href: '/art' },
];
---

<header class="hero">
  <div class="lamp-anchor">
    <div class="lamp">
      <LampToggle restLength={90} maxPull={36} size="46px" class="hero-lamp" />
    </div>
  </div>

  <div class="hero-top">
    <a class="hero-name" href="/" data-reveal="up">Owen Ritchie</a>

    <nav class="hero-nav" aria-label="Primary" data-reveal="up" style="--rd:0.08s">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <button
      type="button"
      class="hero-burger"
      id="hero-burger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="hero-menu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M3 5h18M3 12h18M3 19h18" />
      </svg>
    </button>
  </div>
  <div class="hero-media" data-reveal="scale" style="--rd:0.06s">
    <img
      class="hero-img hero-img-light"
      src="/hero/light-hero.jpg"
      alt="Macro shot of two ants on a branch against a dark green background"
      fetchpriority="high"
    />
    <img
      class="hero-img hero-img-dark"
      src="/hero/dark-hero.jpg"
      alt="Stone staircase climbing a Mayan pyramid at dusk"
      fetchpriority="high"
    />
  </div>
</header>

<div class="hero-menu" id="hero-menu">
  <div class="hero-menu-bar">
    <button type="button" class="hero-menu-close" id="hero-menu-close" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M5.5 5.5l13 13M18.5 5.5l-13 13" />
      </svg>
    </button>
  </div>

  <nav aria-label="Primary">
    <ul class="hero-menu-list">
      {navLinks.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</div>

<script>
  const burger = document.getElementById('hero-burger');
  const menu = document.getElementById('hero-menu');
  const closeBtn = document.getElementById('hero-menu-close');

  if (burger && menu && closeBtn) {
    const focusables = () =>
      [closeBtn, ...menu.querySelectorAll<HTMLAnchorElement>('a')];

    const setOpen = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('menu-open', open);
      if (open) closeBtn.focus();
      else burger.focus();
    };

    addEventListener('pageshow', () => {
      if (menu.classList.contains('is-open')) setOpen(false);
      else document.documentElement.classList.remove('menu-open');
    });

    burger.addEventListener('click', () => setOpen(true));
    closeBtn.addEventListener('click', () => setOpen(false));

    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );

    document.addEventListener('keydown', (e) => {
      if (!menu.classList.contains('is-open')) return;

      if (e.key === 'Escape') {
        setOpen(false);
        return;
      }

      if (e.key !== 'Tab') return;

      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>

<style>
  .hero {
    max-width: 58rem;
    margin-inline: auto;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: clamp(2rem, 8cqw, 5rem);
    padding-bottom: clamp(1rem, 3cqw, 2rem);
    position: relative;
    isolation: isolate;
    container-type: inline-size;
  }

  .lamp-anchor {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: 0;
    pointer-events: none;
  }

  .lamp {
    position: absolute;
    top: -3.5rem;
    right: 2.5rem;
    width: 46px;
    z-index: 3;
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .lamp {
      top: -2.5rem;
    }
  }

  .hero-top {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    margin-bottom: clamp(1.25rem, 3.88cqw, 2.25rem);
    position: relative;
    z-index: 1;
  }

  .hero-name {
    font-family: 'Myflora', serif;
    font-weight: bold;
    font-size: clamp(2rem, 6.2cqw, 3.6rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
  }

  .hero-nav {
    position: absolute;
    top: 50%;
    right: clamp(1.5rem, 12cqw, 7.5rem);
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: clamp(1.4rem, 5cqw, 2.9rem);
    font-family: 'Grenze', serif;
  }

  .hero-nav a {
    position: relative;
    font-size: clamp(1.05rem, 2.5cqw, 1.45rem);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    padding-bottom: 0.2rem;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 2px;
    transition: background-size 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-nav a:hover {
    background-size: 100% 2px;
  }

  .hero-burger {
    display: none;
    margin-left: auto;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .hero-burger svg {
    width: clamp(2rem, 9.4cqw, 2.4rem);
    height: clamp(2rem, 9.4cqw, 2.4rem);
  }

  :global([data-theme="dark"]) .hero-burger svg,
  :global([data-theme="dark"]) .hero-menu-close svg {
    filter: drop-shadow(0 0 9px oklch(0.9 0.05 288 / 0.55));
  }

  .hero-burger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .hero-menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 5vw, 2rem);
    background: var(--bg);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.3s;
  }

  .hero-menu.is-open {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .hero-menu-bar {
    display: flex;
    justify-content: flex-end;
    flex-shrink: 0;
  }

  .hero-menu-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .hero-menu-close svg {
    width: clamp(2rem, 8.5vw, 2.4rem);
    height: clamp(2rem, 8.5vw, 2.4rem);
  }

  .hero-menu-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .hero-menu nav {
    margin: auto 0;
    width: 100%;
  }

  .hero-menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-menu-list li + li {
    border-top: 1.5px dashed var(--border);
  }

  .hero-menu-list a {
    display: block;
    padding: 1.05rem 0;
    font-family: 'Grenze', serif;
    font-size: clamp(1.7rem, 9vw, 2.4rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
  }

  .hero-media {
    flex-shrink: 0;
    aspect-ratio: 16 / 9;
    border-radius: clamp(16px, 3cqw, 28px);
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-img-dark {
    display: none;
  }

  :global([data-theme="dark"]) .hero-img-light {
    display: none;
  }

  :global([data-theme="dark"]) .hero-img-dark {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-menu {
      transition: none;
    }
  }

  @media (max-width: 620px) {
    .hero {
      min-height: 0;
    }

    .lamp-anchor {
      display: none;
    }

    .hero-top {
      --name-fs: clamp(2.4rem, 11cqw, 3.4rem);
    }

    .hero-name {
      font-size: var(--name-fs);
    }

    .hero-nav {
      display: none;
    }

    .hero-burger {
      display: grid;
      transform: translateY(calc(var(--name-fs) * -0.1));
    }

    .hero-media {
      flex: none;
      aspect-ratio: 3 / 2;
    }
  }
</style>
