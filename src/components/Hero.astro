---
import LampToggle from './LampToggle.astro';
---

<header class="hero">
  <div class="lamp-anchor">
    <div class="lamp">
      <LampToggle restLength={90} maxPull={36} size="46px" class="hero-lamp" />
    </div>
  </div>

  <div class="hero-top">
    <a class="hero-name" href="/" data-reveal="up">Owen Ritchie</a>

    <nav class="hero-nav" aria-label="Primary" data-reveal="up" style="--rd:0.08s">
      <a href="#me">Me</a>
      <a href="#work">Work</a>
      <a href="#projects">Projects</a>
      <a href="/art">Art</a>
    </nav>
  </div>

  <div class="hero-media" data-reveal="scale" style="--rd:0.06s">
    <img
      class="hero-img hero-img-light"
      src="/hero/light-hero.jpg"
      alt="Macro shot of two ants on a branch against a dark green background"
      fetchpriority="high"
    />
    <img
      class="hero-img hero-img-dark"
      src="/hero/dark-hero.jpg"
      alt="Stone staircase climbing a Mayan pyramid at dusk"
      fetchpriority="high"
    />
  </div>
</header>

<style>
  .hero {
    max-width: 58rem;
    margin-inline: auto;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: clamp(2rem, 8cqw, 5rem);
    padding-bottom: clamp(1rem, 3cqw, 2rem);
    position: relative;
    isolation: isolate;
    container-type: inline-size;
  }

  .lamp-anchor {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: 0;
    pointer-events: none;
  }

  .lamp {
    position: absolute;
    top: -3.5rem;
    right: 2.5rem;
    width: 46px;
    z-index: 3;
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .lamp {
      top: -2.5rem;
    }
  }

  .hero-top {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    margin-bottom: clamp(1.25rem, 3.88cqw, 2.25rem);
    position: relative;
    z-index: 1;
  }

  .hero-name {
    font-family: 'Myflora', serif;
    font-weight: bold;
    font-size: clamp(2rem, 6.2cqw, 3.6rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
  }

  .hero-nav {
    position: absolute;
    top: 50%;
    right: clamp(1.5rem, 12cqw, 7.5rem);
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: clamp(1.4rem, 5cqw, 2.9rem);
    font-family: 'Grenze', serif;
  }

  .hero-nav a {
    position: relative;
    font-size: clamp(1.05rem, 2.5cqw, 1.45rem);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    padding-bottom: 0.2rem;
  }

  .hero-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-nav a:hover::after {
    transform: scaleX(1);
  }

  .hero-media {
    flex-shrink: 0;
    aspect-ratio: 16 / 9;
    border-radius: clamp(16px, 3cqw, 28px);
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-img-dark {
    display: none;
  }

  :global([data-theme="dark"]) .hero-img-light {
    display: none;
  }

  :global([data-theme="dark"]) .hero-img-dark {
    display: block;
  }

  @media (max-width: 620px) {
    .hero {
      min-height: 0;
    }

    .lamp-anchor {
      display: none;
    }

    .hero-nav {
      display: none;
    }

    .hero-media {
      flex: none;
      aspect-ratio: 3 / 2;
    }
  }
</style>
