---
import IconLoopButton from './IconLoopButton.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const allProjects = JSON.parse(
  readFileSync(join(process.cwd(), 'public/config/projects.json'), 'utf-8')
) as { title: string; link?: string }[];

const footerProjects = [
  { label: 'Mill', match: 'Mill' },
  { label: 'Spotify Analytics', match: 'Spotify Analytics Tracking my Listening Habits' },
  { label: 'OC Transpo Stats', match: 'OC Transpo Real-Time Analytics' },
  { label: 'G7 Report', match: 'G7 Canada 2025 Accountability Report' },
].map((fp) => ({
  label: fp.label,
  link: allProjects.find((p) => p.title === fp.match)?.link,
}));

const columns: {
  heading: string;
  links: { label: string; href: string; external: boolean; note?: string }[];
}[] = [
  {
    heading: 'Contact',
    links: [
      { label: 'Email', href: 'mailto:owenritchie04@gmail.com', external: false },
      { label: 'LinkedIn', href: 'https://www.linkedin.com/in/owenritchie2004/', external: true },
      { label: 'GitHub', href: 'https://github.com/owenritchie', external: true },
      { label: 'Resume', href: '/resume/owen-ritchie.pdf', external: true, note: 'Hire me!' },
    ],
  },
  {
    heading: 'Projects',
    links: footerProjects.map((p) => ({
      label: p.label,
      href: p.link || '/#projects',
      external: Boolean(p.link),
    })),
  },
  {
    heading: 'About',
    links: [
      { label: 'Me', href: '/#me', external: false },
      { label: 'My Art', href: '/art', external: false },
      { label: 'My Experience', href: '/#work', external: false },
    ],
  },
];

const { rounded = false, flush = false } = Astro.props as { rounded?: boolean; flush?: boolean };
const icons: Record<string, string> = {"Email": "<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"m3 7 9 6 9-6\"/>", "LinkedIn": "<path d=\"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z\"/><rect x=\"2\" y=\"9\" width=\"4\" height=\"12\"/><circle cx=\"4\" cy=\"4\" r=\"2\"/>", "GitHub": "<path d=\"M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22\"/>", "Resume": "<path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><path d=\"M14 2v6h6M16 13H8M16 17H8\"/>", "Me": "<path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/>", "My Art": "<path d=\"M12 3a9 9 0 1 0 0 18c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.3 0-1.1.9-2 2-2h2.4A3.6 3.6 0 0 0 21 12.8 9 9 0 0 0 12 3z\"/><circle cx=\"7.5\" cy=\"11\" r=\"1\"/><circle cx=\"10.5\" cy=\"7\" r=\"1\"/><circle cx=\"15.5\" cy=\"7.5\" r=\"1\"/>", "My Experience": "<rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\"/><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"/>", "Mill": "<circle cx=\"12\" cy=\"12\" r=\"9\"/>"};
const year = new Date().getFullYear();
---

<div class={`footer-band${rounded ? ' is-rounded' : ''}${flush ? ' is-flush' : ''}`}>
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-identity">
        <span class="footer-brand">Owen Ritchie</span>
        <p class="footer-note">Data Science &amp; Engineering</p>

        <div class="footer-actions">
          <button type="button" class="footer-switch" id="footer-theme" role="switch" aria-checked="false" aria-label="Dark mode">
            <span class="footer-switch-knob">
              <svg class="footer-switch-icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M6 18l-1.4 1.4M19.4 4.6L18 6" />
              </svg>
              <svg class="footer-switch-icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M20.5 13.4A8.5 8.5 0 1 1 10.6 3.5a6.7 6.7 0 0 0 9.9 9.9z" />
              </svg>
            </span>
          </button>
        </div>
      </div>

      <div class="footer-columns">
        {columns.map((col, c) => (
          <div class={`footer-col${col.heading === 'Projects' ? ' footer-col-projects' : col.heading === 'About' ? ' footer-col-about' : ''}`}>
            <h3 class="footer-heading">{col.heading}</h3>
            <ul class="footer-links">
              {col.links.map((link, i) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener' : undefined}
                  >
                    <span class="footer-icon" aria-hidden="true">
                      <span class="fi fi-lead"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons[link.label] ?? ''} /></span>
                      <span class="fi fi-next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons[link.label] ?? ''} /></span>
                    </span>
                    <span class="footer-label">{link.label}</span>
                  </a>
                  {link.note && <span class="footer-mark">{link.note}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="footer-base">
      <span>&copy; {year} Owen Ritchie</span>
    </div>
  </div>
</footer>
</div>

<IconLoopButton
  icon="arrow-up"
  label="Back to top"
  direction="up"
  variant="to-top"
  id="to-top"
/>

<script>
  const themeSwitch = document.getElementById('footer-theme');

  if (themeSwitch) {
    const sync = () => {
      themeSwitch.setAttribute(
        'aria-checked',
        document.documentElement.dataset.theme === 'dark' ? 'true' : 'false'
      );
    };

    themeSwitch.addEventListener('click', () => (window as any).toggleTheme?.());

    new MutationObserver(sync).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    sync();
  }

  const toTop = document.getElementById('to-top');
  const footerEl = document.querySelector('.site-footer');

  if (toTop && footerEl) {
    toTop.addEventListener('click', () => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });

    new IntersectionObserver(
      ([entry]) => toTop.classList.toggle('is-visible', entry.isIntersecting),
      { rootMargin: '0px 0px -12% 0px' }
    ).observe(footerEl);
  }
</script>

<style>
  .footer-band {
    --band-pad: 2rem;
    display: flow-root;
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-bottom: calc(-1 * var(--band-pad));
    padding: 0 clamp(1.5rem, 5vw, 5rem) var(--band-pad);
    --band-bg: oklch(0.955 0.01 110);
    background: var(--band-bg);
  }

  /* The canvas colour is what shows under the mobile browser toolbar and on overscroll at the bottom: match the footer so there is no hard edge (body paints the page colour above it) */
  :global(html:root) {
    background: oklch(0.955 0.01 110);
  }

  :global(html[data-theme="dark"]:root) {
    background: oklch(0.22 0.04 280);
  }

  :global(html:root:has(.footer-band.is-flush)) {
    background: var(--bg);
  }

  .footer-band.is-rounded {
    margin-top: clamp(3rem, 8vw, 6rem);
    border-radius: clamp(28px, 5vw, 52px) clamp(28px, 5vw, 52px) 0 0;
  }

  :global([data-theme="dark"]) .footer-band {
    --band-bg: oklch(0.22 0.04 280);
  }

  .footer-band.is-flush {
    --band-bg: var(--bg);
  }

  .footer-band.is-flush .site-footer {
    --footer-bg: var(--bg);
  }

  @media (max-width: 480px) {
    .footer-band {
      --band-pad: 1rem;
    }
  }

  .site-footer {
    --footer-bg: oklch(0.955 0.01 110);
    --footer-ink: oklch(0.42 0.06 70);
    --footer-muted: oklch(0.42 0.06 70);
    --footer-mark: oklch(0.5 0.16 145);

    position: relative;
    max-width: 900px;
    margin: clamp(2.5rem, 6vw, 4.5rem) auto clamp(1.25rem, 3vw, 2.25rem);
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: clamp(20px, 3.5vw, 36px);
    padding: clamp(2rem, 4.5vw, 3.25rem) clamp(1.5rem, 4vw, 2.75rem) clamp(1.25rem, 2.5vw, 1.75rem);
  }

  :global([data-theme="dark"]) .site-footer {
    --footer-bg: oklch(0.22 0.04 280);
    --footer-ink: oklch(0.84 0.07 295);
    --footer-muted: oklch(0.72 0.08 290);
    --footer-mark: var(--accent);
  }

  .footer-inner {
    position: relative;
    z-index: 3;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
  }

  .footer-identity {
    align-self: start;
  }

  .footer-brand {
    display: block;
    font-family: 'Myflora', serif;
    font-weight: bold;
    font-size: clamp(2.3rem, 5.4vw, 3.4rem);
    line-height: 0.95;
    letter-spacing: 0.01em;
    color: var(--footer-ink);
  }

  .footer-note {
    margin: 0.85rem 0 0;
    max-width: 32ch;
    font-size: 0.92rem;
    line-height: 1.55;
    color: color-mix(in oklch, var(--footer-muted) 72%, transparent);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .footer-actions {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .footer-switch {
    position: relative;
    width: 80px;
    height: 44px;
    padding: 0;
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    flex: none;
  }

  .footer-switch:focus,
  .footer-switch:focus-visible {
    outline: none;
  }

  .footer-switch-knob {
    position: absolute;
    top: 50%;
    left: 3px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--footer-ink);
    color: var(--footer-bg);
    transform: translate(0, -50%);
    transition: transform var(--dur-base) var(--ease-out);
  }

  :global([data-theme="dark"]) .footer-switch-knob {
    transform: translate(37px, -50%);
  }

  .footer-switch-icon {
    width: 18px;
    height: 18px;
  }

  .icon-moon {
    display: none;
  }

  :global([data-theme="dark"]) .icon-sun {
    display: none;
  }

  :global([data-theme="dark"]) .icon-moon {
    display: block;
  }

  .footer-heading {
    font-family: 'Grenze', serif;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--footer-ink) 88%, transparent);
    margin: 0 0 0.9rem;
  }

  .footer-links {
    --footer-link-size: 0.95rem;

    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .footer-links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5rem;
    row-gap: 0.1rem;
  }

  .footer-mark {
    flex: none;
    font-family: 'Grenze', serif;
    font-style: italic;
    font-weight: 500;
    font-size: calc(var(--footer-link-size) * 1.213);
    line-height: 1.1;
    white-space: nowrap;
    color: var(--footer-mark);
  }

  .footer-icon {
    display: none;
  }

  .footer-links a {
    position: relative;
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--footer-link-size);
    line-height: 1.35;
    color: var(--footer-muted);
    text-decoration: none;
    padding-bottom: 0.15rem;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1.5px;
    transition:
      color var(--dur-base) var(--ease-out),
      background-size var(--dur-base) var(--ease-out);
  }

  .footer-links a:hover {
    color: var(--footer-ink);
    background-size: 100% 1.5px;
  }

  .footer-links a:focus-visible {
    outline: 2px solid var(--footer-ink);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .footer-base {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    text-align: center;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(2rem, 4.5vw, 3.25rem);
    padding-top: clamp(0.85rem, 1.6vw, 1.15rem);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: color-mix(in oklch, var(--footer-muted) 62%, transparent);
  }

  .footer-base::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    border-top: var(--dash-width) dashed var(--dash-color);
  }

  @media (max-width: 900px) {
    .site-footer {
      margin-top: 2rem;
      padding: 1.75rem 1.5rem 1.1rem;
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .footer-identity {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "brand toggle"
        "note toggle";
      align-items: center;
      column-gap: 1rem;
    }

    .footer-brand {
      grid-area: brand;
      font-size: clamp(2rem, 9vw, 2.8rem);
    }

    .footer-note {
      grid-area: note;
      margin-top: 0.5rem;
      font-size: 0.88rem;
    }

    .footer-actions {
      grid-area: toggle;
      margin-top: 0;
    }

    .footer-columns {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 1.5rem;
      border-top: var(--dash-width) dashed var(--dash-color);
    }

    .footer-col-projects,
    .footer-col-about,
    .footer-heading {
      display: none;
    }

    .footer-links {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .footer-links li {
      justify-content: center;
    }

    .footer-links a {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.55rem;
      padding: 0;
      background-image: none;
      font-size: 0.78rem;
      letter-spacing: 0.02em;
    }

    .footer-icon {
      position: relative;
      display: block;
      flex: none;
      width: 48px;
      height: 48px;
      overflow: hidden;
      border: var(--dash-width) dashed var(--dash-color);
      border-radius: 50%;
      transition: background-color var(--dur-base) var(--ease-out);
    }

    .fi {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      transition: transform var(--dur-slow) var(--ease-out);
    }

    .fi svg {
      width: 20px;
      height: 20px;
    }

    .fi-next {
      transform: translateY(-150%);
    }

    .footer-links a:active .footer-icon {
      background-color: color-mix(in oklch, var(--dash-color) 25%, transparent);
    }

    .footer-links a:active .fi-lead {
      transform: translateY(150%);
    }

    .footer-links a:active .fi-next {
      transform: translateY(0);
    }

    @media (hover: hover) {
      .footer-links a:hover .footer-icon {
        background-color: color-mix(in oklch, var(--dash-color) 25%, transparent);
      }

      .footer-links a:hover .fi-lead {
        transform: translateY(150%);
      }

      .footer-links a:hover .fi-next {
        transform: translateY(0);
      }
    }

    @media (max-width: 380px) {
      .site-footer {
        padding-inline: 1rem;
      }

      .footer-icon {
        width: 44px;
        height: 44px;
      }
    }

    .footer-mark {
      display: none;
    }

    .footer-base {
      display: none;
    }
  }
</style>
