<style>
  .about-box {
    grid-area: about;
    background: var(--card);
    border-color: var(--border);
    border-radius: 20px;
    padding: 1.5rem;
  }

  .about-content {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 1.5rem;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .about-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about-content p {
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--text);
    margin: 0;
  }

  .about-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .education-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .education {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: all 0.15s ease;
    position: relative;
    box-shadow: 3px 3px 0 var(--border);
  }

  .education:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--border);
  }

  .edu-logo {
    width: 56px;
    height: 56px;
    object-fit: contain;
    flex-shrink: 0;
  }

  :global([data-theme="light"]) .edu-logo {
    filter: invert(1);
  }

  :global([data-theme="light"]) .kinaxis-logo {
    filter: none;
  }

  .education div {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .education strong {
    font-size: 0.9rem;
    color: var(--text);
    font-weight: 600;
  }

  .education span {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .social-links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.6rem 0.75rem;
    border: 1px dashed var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text-muted);
    text-decoration: none;
    transition: all 0.2s ease;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .social-link:hover {
    border-color: var(--text-muted);
    color: var(--text);
  }

  .social-link svg {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }

  .social-link span {
    white-space: nowrap;
  }

  /* Interests Sidebar */
  .interests-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--border);
  }

  .interests-label {
    font-size: 0.6rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .interests-label:not(:first-child) {
    margin-top: 1rem;
  }

  .interests-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    align-content: flex-start;
  }

  .interest {
    padding: 0.35rem 0.5rem;
    background: var(--card);
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.55rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: default;
    transition: all 0.15s ease;
    box-shadow: 2px 2px 0 var(--border);
  }

  .interest:hover {
    color: var(--text);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--border);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 0.5rem;
    margin-top: 0.5rem;
    justify-items: center;
    align-items: center;
  }

  .skills-grid img {
    height: 28px;
    width: 28px;
    object-fit: contain;
    transition: transform 0.4s ease;
    cursor: pointer;
    justify-self: center;
  }

  .skills-grid img:hover {
    transform: rotate(360deg) scale(1.15);
  }

  @media (max-width: 1100px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .interests-sidebar {
      width: 100%;
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--border);
      padding-top: 1rem;
    }

    .education-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }    .education-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .education {
      padding: 0.75rem;
      gap: 0.75rem;
    }

    .social-links {
      grid-template-columns: repeat(2, 1fr);
    }

    .edu-logo {
      width: 48px;
      height: 48px;
    }

    .skills-grid {
      grid-template-columns: repeat(auto-fit, minmax(32px, 1fr));
      gap: 0.5rem;
    }

    .skills-grid img {
      height: 24px;
      width: 24px;
    }
  }

  @media (max-width: 480px) {
    .about-box {
      padding: 1.25rem;
    }

    .about-content p {
      font-size: 0.8rem;
    }

    .education-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .social-links {
      grid-template-columns: repeat(2, 1fr);
    }

    .edu-logo {
      width: 36px;
      height: 36px;
    }
  }
</style>
