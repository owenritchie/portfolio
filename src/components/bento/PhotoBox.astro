<div class="box photo-box animate-in-scale animate-delay-1">
  <img src="/me/owen.png" alt="Owen Ritchie" class="profile-photo" />
</div>

<style>
  .photo-box {
    grid-area: photo;
    padding: 0;
    border-radius: 20px;
    overflow: hidden;
    align-self: stretch;
    min-height: 120px;
  }

  .profile-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .photo-box {
      height: 200px;
      border-radius: 16px;
    }
  }
</style>
