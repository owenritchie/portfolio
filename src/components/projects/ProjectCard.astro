---
interface Props {
  title: string;
  subtitle: string;
  link?: string;
  image: string;
  colorTheme: string;
  comingSoon?: boolean;
  stack?: string[];
}

const { title, subtitle, link, image, colorTheme, comingSoon, stack } = Astro.props;

// Coming-soon cards aren't linked, so they render as a plain <div>.
const Tag = comingSoon ? 'div' : 'a';
---

<Tag
  class={`project-card${comingSoon ? ' is-coming-soon' : ''}`}
  href={comingSoon ? undefined : link}
  target={comingSoon ? undefined : '_blank'}
  rel={comingSoon ? undefined : 'noopener'}
>
  <div class={`project-card-inner card-theme-${colorTheme}`}>
    <div class="project-card-body">
      <h3 class="project-card-title">{title}</h3>
      <p class="project-card-subtitle">{subtitle}{comingSoon && ' - Coming Soon!'}</p>
      {stack && (
        <div class="project-card-stack">
          {stack.map((icon) => (
            <img src={icon} alt="" class="stack-icon" />
          ))}
        </div>
      )}
    </div>
    <div class="project-card-image">
      <img src={image} alt={title} />
    </div>
  </div>
</Tag>

<style>
  /* Unified earthy green for every card in light mode — base bg held in a var
     so :hover can lift it uniformly. (Per-project hues kept in data, just not used.) */
  .card-theme-orange,
  .card-theme-mint,
  .card-theme-purple,
  .card-theme-blue,
  .card-theme-sand { --card-bg: #0c390a; }

  /* Dark mode: strip inner bg, border lives on the outer card only */
  :global(html[data-theme="dark"]) .project-card-inner {
    --card-bg: transparent;
  }

  :global(html[data-theme="dark"]) .project-card {
    border-color: var(--border);
  }

  .project-card {
    border-radius: 16px;
    text-decoration: none;
    border: 2px dashed transparent;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.5s ease-out, transform 0.1s ease, border-color 0.3s ease;
  }

  .is-coming-soon {
    cursor: default;
  }

  /* settle to `none`, not translateY(0): a lingering transform keeps the card on
     its own GPU layer and rasterizes the screenshot blurry on subpixel bounds */
  :global(.project-card.visible) {
    opacity: 1;
    transform: none;
  }

  /* Only the entrance (opacity/transform) is staggered — hover stays instant. */
  .project-card:nth-child(1) { transition-delay: 0s, 0s, 0s; }
  .project-card:nth-child(2) { transition-delay: 0.08s, 0.08s, 0s; }
  .project-card:nth-child(3) { transition-delay: 0.16s, 0.16s, 0s; }
  .project-card:nth-child(4) { transition-delay: 0.24s, 0.24s, 0s; }

  :global(.project-card.visible:hover) {
    border-color: var(--border) !important;
  }

  /* Match the art gallery hover: the inner pulls away from the dashed frame. */
  :global(.project-card.visible:hover) .project-card-inner {
    transform: scale(0.97);
  }

  .project-card-inner {
    background: var(--card-bg);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 0;
    height: 100%;
    /* Lets the title/subtitle scale with the card width (cqi units below). */
    container-type: inline-size;
    transition: transform 0.3s ease;
  }

  .project-card-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    z-index: 2;
  }

  .project-card-image {
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin-top: 1rem;
    min-height: 0;
  }

  /* Full-width screenshot, top-anchored — shows the whole frame instead of a
     zoomed-in crop. Only the bottom edge tucks behind the card. No shadow. */
  .project-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    border-radius: 12px 12px 0 0;
  }

  .project-card-title {
    font-family: 'Playfair Display', serif;
    /* Scales with card width so the longest title (Sub-Saharan Africa) stays on
       one line on desktop and grows on the wide breakout / single-column cards. */
    font-size: clamp(1.45rem, 4cqi, 2.1rem);
    font-weight: 600;
    /* Cream, because the card is now forest green (works on the dark page too). */
    color: oklch(0.96 0.022 95);
    margin: 0;
    line-height: 1.15;
  }

  .project-card-subtitle {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(0.92rem, 1.9cqi, 1.2rem);
    letter-spacing: 0.04em;
    color: oklch(0.86 0.03 120);
    margin: 0;
    line-height: 1.4;
  }

  .project-card-stack {
    display: flex;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }

  .project-card-stack .stack-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
    opacity: 0.7;
  }

  @media (max-width: 560px) {
    .project-card {
      min-height: 240px;
    }

    .project-card-inner {
      padding: 1.25rem 1.25rem 0;
    }
  }
</style>