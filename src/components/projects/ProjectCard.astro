---
interface Props {
  title: string;
  subtitle: string;
  link: string;
  live: boolean;
  image: string;
  colorTheme: string;
  stack?: string[];
  index: number;
}

const { title, subtitle, link, live, image, colorTheme, stack, index } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener"
  class={`project-card project-card-${index + 1}`}
>
  <div class={`project-card-inner card-theme-${colorTheme}`}>
    <div class="project-card-body">
      <div class="project-card-header">
        <h3 class="project-card-title">{title}</h3>
        {live && <span class="project-live-badge">Live</span>}
      </div>
      <p class="project-card-subtitle">{subtitle}</p>
      {stack && (
        <div class="project-card-stack">
          {stack.map((icon) => (
            <img src={icon} alt="" class="stack-icon" />
          ))}
        </div>
      )}
    </div>
    <div class="project-card-image">
      <img src={image} alt={title} />
    </div>
  </div>
</a>

<style>
  /* Card Color Themes */
  .card-theme-orange { background: #fde8d5; }
  .card-theme-mint { background: #d5f0e8; }
  .card-theme-purple { background: #ead5fd; }
  .card-theme-blue { background: #d5e8fd; }
  .card-theme-sand { background: #fdf0d5; }

  /* Force dark mode card backgrounds */
  :global(html[data-theme="dark"]) .project-card-inner.card-theme-orange,
  :global(html[data-theme="dark"]) .project-card-inner.card-theme-mint,
  :global(html[data-theme="dark"]) .project-card-inner.card-theme-purple,
  :global(html[data-theme="dark"]) .project-card-inner.card-theme-blue,
  :global(html[data-theme="dark"]) .project-card-inner.card-theme-sand {
    background: transparent !important;
    border: 1px solid var(--border) !important;
  }

  :global([data-theme="dark"]) .project-card-image img {
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.4);
  }

  .project-card-1 { grid-column: 1 / 3; grid-row: 1; }
  .project-card-2 { grid-column: 3 / 5; grid-row: 1; }
  .project-card-3 { grid-column: 1 / 3; grid-row: 2; }
  .project-card-4 { grid-column: 3 / 5; grid-row: 2; }

  .project-card {
    border-radius: 16px;
    text-decoration: none;
    border: 2px dashed transparent;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out, border-color 0.3s ease;
  }

  .project-card :global(.visible) {
    opacity: 1;
    transform: translateY(0);
  }

  :global(.project-card.visible) {
    opacity: 1;
    transform: translateY(0);
  }

  .project-card:nth-child(1) { transition-delay: 0s; }
  .project-card:nth-child(2) { transition-delay: 0.1s; }
  .project-card:nth-child(3) { transition-delay: 0.2s; }
  .project-card:nth-child(4) { transition-delay: 0.3s; }

  .project-card:hover {
    border-color: var(--border);
  }

  .project-card-inner {
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 0;
    height: 100%;
    transition: transform 0.3s ease;
  }

  .project-card:hover .project-card-inner {
    transform: scale(0.97);
  }

  .project-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    z-index: 2;
  }

  .project-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-card-image {
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin-top: 1rem;
    min-height: 0;
  }

  .project-card-image img {
    width: 82%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    border-radius: 12px 12px 0 0;
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.12);
  }

  .project-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: transparent;
    color: #22c55e;
    font-size: 0.6rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(34, 197, 94, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .project-live-badge::before {
    content: '';
    width: 5px;
    height: 5px;
    background: #22c55e;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .project-card-title {
    font-family: 'Myflora', serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
    line-height: 1.2;
  }

  .project-card-subtitle {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.4;
  }

  .project-card-stack {
    display: flex;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }

  .project-card-stack .stack-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .project-card-1 { grid-column: 1 / 3; grid-row: auto; }
    .project-card-2 { grid-column: 1 / 3; grid-row: auto; }
    .project-card-3 { grid-column: 1 / 2; grid-row: auto; }
    .project-card-4 { grid-column: 2 / 3; grid-row: auto; }

    .project-card {
      min-height: 240px;
    }

    .project-card-1,
    .project-card-2 {
      min-height: 280px;
    }

    .project-card-image img {
      width: 90%;
    }
  }

  @media (max-width: 480px) {
    .project-card-1,
    .project-card-2,
    .project-card-3,
    .project-card-4 {
      grid-column: 1 / 3;
      grid-row: auto;
    }

    .project-card,
    .project-card-1,
    .project-card-2 {
      min-height: 220px;
    }

    .project-card-inner {
      padding: 1.25rem 1.25rem 0;
    }
  }
</style>
