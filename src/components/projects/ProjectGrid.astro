---
interface Project {
  title: string;
  short?: string;
  subtitle: string;
  link?: string;
  image: string;
  comingSoon?: boolean;
  download?: string;
  kind?: string;
  hidden?: boolean;
}

interface Props {
  projects: Project[];
  heading?: string;
}

const { projects, heading = "Things I've been working on" } = Astro.props;
const shown = projects.filter((p) => !p.hidden);

// Myflora has no usable comma, period or ampersand, so those fall back to the serif
const display = (text: string) =>
  text.split(/([,.&])/).map((part) => ({ part, punct: /^[,.&]$/.test(part) }));

const dl =
  '<path d="M12 13v8l-4-4" /><path d="m12 21 4-4" /><path d="M4.393 15.269A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.436 8.284" />';
---

<section id="projects" class="pgrid" style={`--n:${shown.length}`}>
  <h2 class="pgrid-heading" data-reveal="up"><span class="ph-long">{heading}</span><span class="ph-short">Projects</span></h2>

  <div class="pbrowser" data-active="0" data-reveal="up" style="--rd:0.1s">
    <div class="ptabs" role="tablist" aria-label="Projects">
      {shown.map((p, i) => (
        <button
          type="button"
          class={`ptab${i === 0 ? ' is-active' : ''}`}
          role="tab"
          id={`tab-${i}`}
          aria-controls={`panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tab={i}
        >
          <span class="ptab-title">{display(p.short ?? p.title).map(({ part, punct }) => (punct ? <span class="punct">{part}</span> : part))}</span>
          {p.kind && <span class="ptab-kind">{p.kind}</span>}
        </button>
      ))}
    </div>

    <div class="ppanels">
      {shown.map((p, i) => (
        <article
          class={`ppanel${i === 0 ? ' is-active' : ''}`}
          role="tabpanel"
          id={`panel-${i}`}
          aria-labelledby={`tab-${i}`}
          hidden={i !== 0}
        >
          <header class="ppanel-head">
            <h3 class="ppanel-title">
              {p.link && !p.comingSoon ? (
                <a class="ppanel-link" href={p.link} target="_blank" rel="noopener">{display(p.short ?? p.title).map(({ part, punct }) => (punct ? <span class="punct">{part}</span> : part))}</a>
              ) : (
                display(p.short ?? p.title).map(({ part, punct }) => (punct ? <span class="punct">{part}</span> : part))
              )}
            </h3>
          </header>

          {p.kind && <p class="ppanel-kind">{p.kind}</p>}

          <div class="ppanel-row">
            <p class="ppanel-desc">{p.subtitle}{p.comingSoon ? ' Coming soon.' : ''}</p>
            {p.download && (
              <a class="ppanel-download" href={p.download} target="_blank" rel="noopener">
                <span class="pd-icon" aria-hidden="true">
                  <span class="pd-viewport">
                    <span class="ib-icon ib-lead">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={dl} />
                    </span>
                    <span class="ib-icon ib-next">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" set:html={dl} />
                    </span>
                  </span>
                </span>
                <span class="pd-label">Download latest</span>
              </a>
            )}
          </div>

          <div class="ppanel-stage">
            {p.link && !p.comingSoon ? (
              <a class="ppanel-shot" href={p.link} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <img src={p.image} alt={`${p.title} screenshot`} width="1600" height="1000" loading="lazy" />
              </a>
            ) : (
              <div class="ppanel-shot">
                <img src={p.image} alt={`${p.title} screenshot`} width="1600" height="1000" loading="lazy" />
              </div>
            )}
            {p.link && !p.comingSoon && (
              <a class="ppanel-go" href={p.link} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3 20C3 13 9.5 13 9 17.2 8.6 20.5 4.8 18 7 12.5 9 8 13 6 19 5.5" /><path d="M14.5 2.2 19.3 5.5 15.2 9.7" /></svg>
              </a>
            )}
          </div>
        </article>
      ))}
      <div class="pnotch">
        <a class="pnotch-gh" href="https://github.com/owenritchie" target="_blank" rel="noopener" aria-label="Owen's GitHub profile">
          <span class="pnotch-viewport">
            <span class="pnotch-icon pnotch-lead"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg></span>
            <span class="pnotch-icon pnotch-next"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg></span>
          </span>
        </a>
      </div>
    </div>

    <nav class="pnav" aria-label="Browse projects">
      <button type="button" class="pnav-arrow" data-step="-1" aria-label="Previous project">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      {shown.map((p, i) => (
        <button type="button" class={`pnav-dot${i === 0 ? ' is-active' : ''}`} data-go={i} aria-label={`Project ${i + 1}: ${p.short ?? p.title}`} aria-current={i === 0 ? 'true' : undefined}><span></span></button>
      ))}
      <button type="button" class="pnav-arrow" data-step="1" aria-label="Next project">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </nav>
  </div>
</section>

<script>
  const browser = document.querySelector<HTMLElement>('.pbrowser');

  if (browser) {
    const tabs = Array.from(browser.querySelectorAll<HTMLButtonElement>('.ptab'));
    const panels = Array.from(browser.querySelectorAll<HTMLElement>('.ppanel'));

    const select = (i: number, focus = false) => {
      browser.dataset.active = String(i);
      tabs.forEach((tab, idx) => {
        const on = idx === i;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, idx) => {
        const on = idx === i;
        panel.hidden = !on;
        panel.classList.toggle('is-active', on);
      });
      browser.querySelectorAll<HTMLElement>('.pnav-dot').forEach((n, idx) => {
        const on = idx === i;
        n.classList.toggle('is-active', on);
        if (on) n.setAttribute('aria-current', 'true');
        else n.removeAttribute('aria-current');
      });
      if (focus) tabs[i].focus();
    };

    const step = (d: number) => {
      const cur = Number(browser.dataset.active);
      select((cur + d + tabs.length) % tabs.length);
    };

    browser.querySelectorAll<HTMLButtonElement>('.pnav-arrow').forEach((btn) => {
      btn.addEventListener('click', () => step(Number(btn.dataset.step)));
    });
    browser.querySelectorAll<HTMLButtonElement>('.pnav-dot').forEach((btn) => {
      btn.addEventListener('click', () => select(Number(btn.dataset.go)));
    });

    let sx = 0;
    let sy = 0;
    const panelsEl = browser.querySelector('.ppanels');
    panelsEl?.addEventListener('touchstart', (e) => {
      const t = (e as TouchEvent).touches[0];
      sx = t.clientX;
      sy = t.clientY;
    }, { passive: true });
    panelsEl?.addEventListener('touchend', (e) => {
      const t = (e as TouchEvent).changedTouches[0];
      const dx = t.clientX - sx;
      if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(t.clientY - sy) * 1.5) step(dx < 0 ? 1 : -1);
    }, { passive: true });

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next = -1;
        if (e.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next >= 0) {
          e.preventDefault();
          select(next, true);
        }
      });
    });
  }
</script>

<style>
  .pgrid {
    --slab: clamp(28px, 5vw, 52px);
    --gutter: max((100vw - 1120px) / 2, clamp(1.5rem, 5vw, 5rem));
    --sec: oklch(0.954 0.014 130);
    --card: oklch(0.91 0.05 140);
    --ink: oklch(0.26 0.035 145);
    --ink-soft: oklch(0.45 0.04 145);
    --btn-fill: var(--ink);
    --btn-fg: var(--card);
    --btn-ring: var(--ink-soft);
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: calc(-1 * var(--slab));
    background: var(--sec);
    color: var(--ink);
    border-radius: var(--slab) var(--slab) 0 0;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter) clamp(1rem, 2vw, 1.5rem);
    scroll-margin-top: 1.5rem;
  }

  :global([data-theme='dark']) .pgrid {
    --sec: oklch(0.22 0.04 280);
    --card: oklch(0.17 0.03 278);
    --ink: var(--heading-ink);
    --ink-soft: oklch(0.72 0.08 290);
    --btn-fill: oklch(0.3 0.055 280);
    --btn-fg: oklch(0.88 0.04 285);
    --btn-ring: var(--dash-color);
  }

  :global([data-theme='dark']) .pgrid::after {
    content: '';
    position: absolute;
    inset: 0;
    border: var(--dash-width) dashed var(--dash-color);
    border-bottom: none;
    border-radius: inherit;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, black 0, black 6px, transparent 64px);
    mask-image: linear-gradient(to bottom, black 0, black 6px, transparent 64px);
  }

  .pgrid-heading {
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    color: var(--heading-ink);
    text-align: center;
    margin: 0 0 clamp(2.75rem, 6.5vw, 4.5rem);
  }

  @media (max-width: 860px) {
    .pgrid-heading {
      text-align: left;
    }
  }

  .ph-short {
    display: none;
  }

  .pnav {
    display: none;
  }

  .pbrowser {
    --r: clamp(16px, 1.8vw, 24px);
    width: 100%;
    max-width: 76rem;
    margin: 0 auto;
  }

  @media (min-width: 1081px) {
    .pbrowser {
      zoom: 0.85;
    }
  }

  .ptabs {
    display: flex;
    align-items: stretch;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    border-bottom: 1.5px solid color-mix(in oklch, var(--ink) 20%, transparent);
  }

  .ptab {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.35rem;
    padding: 0.4rem 1.5rem 1.15rem 0;
    border: none;
    background: none;
    color: color-mix(in oklch, var(--ink) 55%, transparent);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: color var(--dur-base) var(--ease-out);
  }

  .ptab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 1.5rem;
    bottom: -1.5px;
    height: 3px;
    border-radius: 3px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .ptab:last-child::after {
    right: 0;
  }

  .ptab.is-active {
    color: var(--ink);
  }

  .ptab.is-active::after {
    transform: scaleX(1);
  }

  .ptab:not(.is-active):hover {
    color: var(--ink);
  }

  .ptab:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    border-radius: 6px;
  }

  .ptab-title {
    max-width: 100%;
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: clamp(1.05rem, 1.55vw, 1.4rem);
    line-height: 1.1;
  }

  .pgrid :global(.punct) {
    font-family: 'Grenze', serif;
    line-height: 0;
  }

  .ptab-kind {
    max-width: 100%;
    font-family: 'Grenze', serif;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .ppanels {
    --nw: 6.25rem;
    --nh: 5rem;
    --fr: var(--r);
    position: relative;
    background: var(--card);
    border-radius: var(--r);
    height: clamp(40rem, 86vh, 52rem);
  }

  .ppanel {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vh, 1.5rem);
    padding: clamp(1.4rem, 2.6vw, 2.2rem);
  }

  .ppanel[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ppanel.is-active {
      animation: panel-in var(--dur-slow) var(--ease-out);
    }
  }

  @keyframes panel-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .ppanel-head {
    flex: none;
    padding-right: calc(var(--nw) - 1rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .ppanel-title {
    margin: 0;
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: clamp(1.9rem, 3.2vw, 2.7rem);
    line-height: 1.1;
  }

  .ib-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .ib-icon svg {
    width: 22px;
    height: 22px;
  }

  .ppanel-link,
  .ppanel-link:visited {
    color: inherit;
    text-decoration: none;
  }

  .ppanel-link {
    padding-bottom: 0.1rem;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 2px;
    transition: background-size var(--dur-base) var(--ease-out);
  }

  .ppanel-link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .pnotch {
    position: absolute;
    top: 0;
    right: 0;
    width: var(--nw);
    height: var(--nh);
    display: grid;
    place-items: center;
    background: var(--sec);
    border-bottom-left-radius: var(--r);
  }

  .pnotch::before,
  .pnotch::after {
    content: '';
    position: absolute;
    width: var(--fr);
    height: var(--fr);
    background: radial-gradient(circle at bottom left, transparent calc(var(--fr) - 0.5px), var(--sec) calc(var(--fr) - 0.5px));
    pointer-events: none;
  }

  .pnotch::before {
    right: 0;
    top: 100%;
  }

  .pnotch::after {
    right: 100%;
    top: 0;
  }

  .pnotch-gh {
    --g: 0.5rem;
    isolation: isolate;
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: calc(var(--nw) - var(--g));
    height: calc(var(--nh) - var(--g));
    border-radius: var(--r) var(--r) var(--r) calc(var(--r) - var(--g));
    transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
    background: var(--card);
    color: var(--ink);
  }

  .pnotch-viewport {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
  }

  .pnotch-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .pnotch-next {
    transform: translateY(-150%);
  }

  .pnotch-icon svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .pnotch-gh:hover,
  .pnotch-gh:focus-visible {
    background: var(--btn-fill);
    color: var(--btn-fg);
  }

  .pnotch-gh:hover .pnotch-lead,
  .pnotch-gh:focus-visible .pnotch-lead {
    transform: translateY(150%);
  }

  .pnotch-gh:hover .pnotch-next,
  .pnotch-gh:focus-visible .pnotch-next {
    transform: translateY(0);
  }

  .pnotch-gh:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .ppanel-row {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .ppanel-desc {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(0.98rem, 1.2vw, 1.1rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .ppanel-download {
    --ib-travel: 150%;
    position: relative;
    isolation: isolate;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 3rem;
    padding: 0 1.2rem 0 0.35rem;
    border-radius: 999px;
    background: var(--btn-fill);
    color: var(--btn-fg);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .pd-icon {
    position: relative;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
  }

  .pd-viewport {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    overflow: hidden;
  }

  .ppanel-download .ib-next {
    transform: translate(0, calc(-1 * var(--ib-travel)));
  }

  .ppanel-download::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -7px;
    border: var(--dash-width) dashed var(--btn-ring);
    border-radius: 999px;
    opacity: 0;
    transform: scale(0.94);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }

  .ppanel-download:focus-visible {
    outline: none;
  }

  .ppanel-stage {
    container-type: inline-size;
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 0fr;
    column-gap: 0;
    transition: grid-template-columns var(--dur-slow) var(--ease-out), column-gap var(--dur-slow) var(--ease-out);
  }

  .ppanel-shot {
    display: block;
    min-width: 0;
    overflow: hidden;
    border-radius: clamp(12px, 1.4vw, 18px);
    background: color-mix(in oklch, var(--ink) 8%, var(--card));
  }

  .ppanel-shot img {
    display: block;
    width: 100cqw;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .ppanel-go {
    min-width: 0;
    overflow: hidden;
    display: grid;
    place-items: center;
    border-radius: clamp(12px, 1.4vw, 18px);
    background: var(--btn-fill);
    color: var(--btn-fg);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .ppanel-go svg {
    flex: none;
    width: clamp(4rem, 8vw, 7rem);
    height: clamp(4rem, 8vw, 7rem);
  }

  @media (hover: hover) {
    .ppanel-link:hover {
      background-size: 100% 2px;
    }

    .ppanel:has(.ppanel-link:hover, .ppanel-stage:hover) .ppanel-stage {
      grid-template-columns: 3fr 1fr;
