---
import IconLoopButton from '../IconLoopButton.astro';

interface Project {
  title: string;
  short?: string;
  subtitle: string;
  link?: string;
  image: string;
  colorTheme: string;
  comingSoon?: boolean;
  download?: string;
  stack?: string[];
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const slug = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
---

<section id="projects" class="pc">
  <h2 class="pc-heading" data-reveal="up">Things I've been working on</h2>

  <nav class="pc-nav" aria-label="Jump to project">
    <ul class="pc-nav-list">
      {projects.map((p, i) => (
        <li>
          <a
            class={`pc-pill${i === 0 ? ' active' : ''}`}
            href={`#${slug(p.title)}`}
            aria-current={i === 0 ? 'true' : undefined}
          >{p.short ?? p.title}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="pc-scroll">
    <div class="pc-list">
      {projects.map((p, i) => (
        <article class={`pc-item${i === 0 ? ' active' : ''}`} id={slug(p.title)} data-index={i}>
          <img class="pc-media-inline" src={p.image} alt={p.title} loading="lazy" />
          <h3 class="pc-title">{p.title}</h3>
          <p class="pc-desc">{p.subtitle}</p>
          {p.comingSoon ? (
            <span class="pc-soon">Coming soon</span>
          ) : (
            <div class="pc-actions">
              <a class="pc-btn" href={p.link} target="_blank" rel="noopener">View project</a>
              {p.download && (
                <IconLoopButton
                  icon="download"
                  label="Download latest"
                  direction="down"
                  variant="download"
                  href={p.download}
                  target="_blank"
                  rel="noopener"
                />
              )}
            </div>
          )}
        </article>
      ))}
    </div>

    <div class="pc-sticky">
      <div class="pc-media-stage">
        {projects.map((p, i) => (
          <div class={`pc-media${i === 0 ? ' active' : ''}`} data-media={i} aria-hidden={i === 0 ? 'false' : 'true'}>
            <img src={p.image} alt={p.title} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .pc {
    margin-top: 1rem;

    scroll-margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .pc-heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: clamp(2rem, 7vw, 4.6rem);
    line-height: 1.05;
    color: var(--text);
    text-align: center;

    margin: 0 0 clamp(2.5rem, 6vw, 4.5rem);
  }

  .pc-nav {
    position: sticky;
    top: clamp(1.5rem, 5vh, 3rem);
    z-index: 5;
    padding: 0.9rem 0 1rem;
    margin-bottom: clamp(0.5rem, 2vw, 1.25rem);
  }

  .pc-nav-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pc-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.95rem;
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .pc-pill.active {
    background: var(--accent);
    color: var(--bg);
    border-color: transparent;
  }

  :global([data-theme="dark"]) .pc-pill.active {
    background: var(--card);
    color: var(--text);
  }

  .pc-scroll {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .pc-list {
    display: flex;
    flex-direction: column;
  }

  .pc-item {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.15rem;
    opacity: 0.32;
    transform: translateY(8px);
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pc-item.active {
    opacity: 1;
    transform: none;
  }

  .pc-title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.08;
    color: var(--text);
    margin: 0;
  }

  .pc-desc {
    color: var(--text-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    max-width: min(42ch, 100%);
    margin: 0;
  }

  .pc-btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.4rem;
    height: 3.1rem;
    padding: 0 1.9rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: var(--btn-fg);
    text-indent: 0.06em;
    border: var(--dash-width) dashed transparent;
    border-radius: 999px;
    text-decoration: none;
  }

  .pc-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--btn);
    border-radius: 999px;
    transition:
      inset 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.3s ease;
  }

  .pc-btn::after {
    content: '';
    position: absolute;
    inset: -7px;
    z-index: -1;
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: 999px;
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pc-btn:hover::before,
  .pc-btn:focus-visible::before {
    background: var(--btn-hover);
  }

  .pc-btn:hover::after {
    opacity: 1;
    transform: scale(1);
  }

  .pc-btn:active::before {
    inset: -7px;
  }

  :global([data-theme="dark"]) .pc-btn {
    border-color: var(--dash-color);
  }

  .pc-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .pc-soon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.4rem;
    padding: 0.85rem 1.9rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    text-indent: 0.06em;
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: 999px;
  }

  .pc-sticky {
    position: sticky;
    top: 15vh;
    align-self: start;
    height: 70vh;
    display: grid;
    place-items: center;
    box-sizing: border-box;
  }

  .pc-media-stage {
    display: grid;
    justify-items: center;
    align-items: center;
    width: 100%;
  }

  .pc-media {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s ease,
      visibility 0s linear 0.6s;
  }

  .pc-media.active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s ease;
  }

  .pc-media img {
    display: block;
    max-width: 100%;
    max-height: 60vh;
    width: auto;
    height: auto;
    border-radius: 8px;
    outline: var(--dash-width) dashed var(--dash-color);
    outline-offset: 8px;
  }

  .pc-media-inline {
    display: none;
  }

  @media (max-width: 820px) {
    .pc-nav {
      display: none;
    }

    .pc-scroll {
      grid-template-columns: 1fr;
    }

    .pc-sticky {
      display: none;
    }

    .pc-list {
      gap: clamp(3rem, 11vw, 4.5rem);
    }

    .pc-item {
      min-height: 0;
      opacity: 1;
      transform: none;
      gap: 1rem;
    }

    .pc-media-inline {
      display: block;
      width: 100%;
      height: auto;
      margin-bottom: 0.5rem;
      border-radius: 10px;
      outline: var(--dash-width) dashed var(--dash-color);
      outline-offset: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-item,
    .pc-media { transition: opacity 0.3s ease; }
    .pc-item { transform: none; }
  }
</style>

<script>
  function initProjects() {
    const root = document.querySelector<HTMLElement>('.pc');
    if (!root) return;

    const items = Array.from(root.querySelectorAll<HTMLElement>('.pc-item'));
    const medias = Array.from(root.querySelectorAll<HTMLElement>('.pc-media'));
    const pills = Array.from(root.querySelectorAll<HTMLAnchorElement>('.pc-pill'));
    if (!items.length) return;
    let current = 0;

    function activate(i: number) {
      if (i === current) return;
      items[current]?.classList.remove('active');
      medias[current]?.classList.remove('active');
      medias[current]?.setAttribute('aria-hidden', 'true');
      pills[current]?.classList.remove('active');
      pills[current]?.removeAttribute('aria-current');

      items[i]?.classList.add('active');
      medias[i]?.classList.add('active');
      medias[i]?.setAttribute('aria-hidden', 'false');
      pills[i]?.classList.add('active');
      pills[i]?.setAttribute('aria-current', 'true');
      current = i;
    }

    pills.forEach((pill, i) => {
      pill.addEventListener('click', (e) => {
        const target = items[i];
        if (!target) return;
        e.preventDefault();
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
        history.replaceState(null, '', `#${target.id}`);
        activate(i);
      });
    });

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const idx = Number((e.target as HTMLElement).dataset.index);
            if (!Number.isNaN(idx)) activate(idx);
          }
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );

    items.forEach((it) => io.observe(it));
  }

  document.addEventListener('DOMContentLoaded', initProjects);
</script>
