---
interface Project {
  title: string;
  short?: string;
  subtitle: string;
  link?: string;
  image: string;
  colorTheme: string;
  comingSoon?: boolean;
  stack?: string[];
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section id="projects" class="pc">
  <h2 class="pc-heading" data-reveal="up">Things I've been working on</h2>

  <div class="pc-scroll">
    <!-- Left: project blocks that scroll past; the centered one is "active" -->
    <div class="pc-list">
      {projects.map((p, i) => (
        <article class={`pc-item${i === 0 ? ' active' : ''}`} data-index={i}>
          <!-- Phone-only inline shot: the sticky crossfade stage is hidden on
               mobile, so each project carries its own image stacked above it. -->
          <img class="pc-media-inline" src={p.image} alt={p.title} loading="lazy" />
          <h3 class="pc-title">{p.title}</h3>
          <p class="pc-desc">{p.subtitle}</p>
          {p.comingSoon ? (
            <span class="pc-soon">Coming soon</span>
          ) : (
            <a class="pc-btn" href={p.link} target="_blank" rel="noopener">View project</a>
          )}
        </article>
      ))}
    </div>

    <!-- Right: sticky screenshot that fades to the active project -->
    <div class="pc-sticky">
      <div class="pc-media-stage">
        {projects.map((p, i) => (
          <div class={`pc-media${i === 0 ? ' active' : ''}`} data-media={i} aria-hidden={i === 0 ? 'false' : 'true'}>
            <img src={p.image} alt={p.title} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .pc {
    margin-top: 1rem;
    scroll-margin-top: 1rem;
  }

  .pc-heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    /* Lower floor + steeper vw so the long phrase shrinks on phones instead of
       clipping at the viewport edge; capped at the same desktop size. */
    font-size: clamp(2rem, 7vw, 4.6rem);
    line-height: 1.05;
    color: var(--text);
    text-align: center;
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 1rem;
  }

  .pc-scroll {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  /* ---- Left: scrolling project blocks ---- */
  .pc-list {
    display: flex;
    flex-direction: column;
  }

  .pc-item {
    /* Height matches the sticky image box so the first/last blocks line up
       vertically with the image at the start and end of the scroll. */
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.15rem;
    /* inactive blocks recede; the centered one reads at full strength */
    opacity: 0.32;
    transform: translateY(8px);
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pc-item.active {
    opacity: 1;
    transform: none;
  }

  .pc-title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.08;
    color: var(--text);
    margin: 0;
  }

  .pc-desc {
    color: var(--text-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    /* flex-start column: cap at column width so 42ch can't overrun a phone. */
    max-width: min(42ch, 100%);
    margin: 0;
  }

  .pc-btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.4rem;
    padding: 0.85rem 1.9rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: var(--bg);
    /* Optical centering: letter-spacing leaves a trailing gap after the last
       glyph, nudging the label left; a matching indent re-centers it. */
    text-indent: 0.06em;
    /* Transparent dashed border keeps the box the exact size of .pc-soon,
       which carries a visible one. */
    border: 1.5px dashed transparent;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Solid accent fill on its own layer, so it can balloon outward on press to
     meet the dashed ring. */
  .pc-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    border-radius: 999px;
    transition:
      inset 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.3s ease;
  }

  /* Dashed ring — encircles the pill on hover, echoing the active work-timeline
     bar's offset dashed outline. */
  .pc-btn::after {
    content: '';
    position: absolute;
    inset: -7px;
    z-index: -1;
    border: 1.5px dashed var(--border);
    border-radius: 999px;
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pc-btn:hover {
    transform: translateY(-2px);
  }

  .pc-btn:hover::before {
    filter: brightness(1.08);
  }

  .pc-btn:hover::after {
    opacity: 1;
    transform: scale(1);
  }

  /* Click: the fill expands out into the encircling ring. */
  .pc-btn:active::before {
    inset: -7px;
  }

  /* Coming soon: same footprint as .pc-btn, permanently dashed, no hover ring. */
  .pc-soon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.4rem;
    padding: 0.85rem 1.9rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    text-indent: 0.06em;
    border: 1.5px dashed var(--border);
    border-radius: 999px;
  }

  /* ---- Right: sticky, crossfading screenshot ---- */
  .pc-sticky {
    position: sticky;
    /* 70vh box centered in the viewport -> image center sits at 50vh, the same
       line the text blocks (also 70vh) center on, so they stay aligned. */
    top: 15vh;
    align-self: start;
    height: 70vh;
    display: grid;
    place-items: center;
    box-sizing: border-box;
  }

  .pc-media-stage {
    display: grid;
    justify-items: center;
    align-items: center;
    width: 100%;
  }

  .pc-media {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s ease,
      visibility 0s linear 0.6s;
  }

  .pc-media.active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s ease;
  }

  /* True to size, no crop, with a separated dashed outline */
  .pc-media img {
    display: block;
    max-width: 100%;
    max-height: 60vh;
    width: auto;
    height: auto;
    border-radius: 8px;
    outline: 1.5px dashed var(--border);
    outline-offset: 8px;
  }

  /* Desktop keeps the sticky crossfade; the inline per-card image is phone-only. */
  .pc-media-inline {
    display: none;
  }

  @media (max-width: 820px) {
    .pc-scroll {
      grid-template-columns: 1fr;
    }

    /* Drop the pinned scrollytelling on phones — it left huge empty gaps and a
       tiny image. Each project becomes an honest full-width block instead. */
    .pc-sticky {
      display: none;
    }

    .pc-list {
      gap: clamp(3rem, 11vw, 4.5rem);
    }

    .pc-item {
      /* No more 62vh spacers or dimmed inactive states — every card reads at
         full strength, sized to its own content. */
      min-height: 0;
      opacity: 1;
      transform: none;
      gap: 1rem;
    }

    .pc-media-inline {
      display: block;
      width: 100%;
      height: auto;
      margin-bottom: 0.5rem;
      border-radius: 10px;
      outline: 1.5px dashed var(--border);
      outline-offset: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-item,
    .pc-media { transition: opacity 0.3s ease; }
    .pc-item { transform: none; }
  }
</style>

<script>
  function initProjects() {
    const root = document.querySelector<HTMLElement>('.pc');
    if (!root) return;

    const items = Array.from(root.querySelectorAll<HTMLElement>('.pc-item'));
    const medias = Array.from(root.querySelectorAll<HTMLElement>('.pc-media'));
    if (!items.length) return;
    let current = 0;

    function activate(i: number) {
      if (i === current) return;
      items[current]?.classList.remove('active');
      medias[current]?.classList.remove('active');
      medias[current]?.setAttribute('aria-hidden', 'true');

      items[i]?.classList.add('active');
      medias[i]?.classList.add('active');
      medias[i]?.setAttribute('aria-hidden', 'false');
      current = i;
    }

    // A block becomes active when it crosses a thin band at the viewport center.
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const idx = Number((e.target as HTMLElement).dataset.index);
            if (!Number.isNaN(idx)) activate(idx);
          }
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );

    items.forEach((it) => io.observe(it));
  }

  document.addEventListener('DOMContentLoaded', initProjects);
</script>
