---
interface Project {
  title: string;
  short?: string;
  subtitle: string;
  link?: string;
  image: string;
  colorTheme: string;
  comingSoon?: boolean;
  download?: string;
  stack?: string[];
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section id="projects" class="pc">
  <h2 class="pc-heading" data-reveal="up">Things I've been working on</h2>

  <div class="pc-scroll">
    <div class="pc-list">
      {projects.map((p, i) => (
        <article class={`pc-item${i === 0 ? ' active' : ''}`} data-index={i}>
          <img class="pc-media-inline" src={p.image} alt={p.title} loading="lazy" />
          <h3 class="pc-title">{p.title}</h3>
          <p class="pc-desc">{p.subtitle}</p>
          {p.comingSoon ? (
            <span class="pc-soon">Coming soon</span>
          ) : (
            <div class="pc-actions">
              <a class="pc-btn" href={p.link} target="_blank" rel="noopener">View project</a>
              {p.download && (
                <a
                  class="pc-download"
                  href={p.download}
                  target="_blank"
                  rel="noopener"
                  aria-label="Download Latest"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 13v8l-4-4" />
                    <path d="m12 21 4-4" />
                    <path d="M4.393 15.269A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.436 8.284" />
                  </svg>
                  <span class="pc-tip">Download Latest</span>
                </a>
              )}
            </div>
          )}
        </article>
      ))}
    </div>

    <div class="pc-sticky">
      <div class="pc-media-stage">
        {projects.map((p, i) => (
          <div class={`pc-media${i === 0 ? ' active' : ''}`} data-media={i} aria-hidden={i === 0 ? 'false' : 'true'}>
            <img src={p.image} alt={p.title} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .pc {
    margin-top: 1rem;
    scroll-margin-top: 1rem;
  }

  .pc-heading {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: clamp(2rem, 7vw, 4.6rem);
    line-height: 1.05;
    color: var(--text);
    text-align: center;
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 1rem;
  }

  .pc-scroll {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .pc-list {
    display: flex;
    flex-direction: column;
  }

  .pc-item {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.15rem;
    opacity: 0.32;
    transform: translateY(8px);
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pc-item.active {
    opacity: 1;
    transform: none;
  }

  .pc-title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.08;
    color: var(--text);
    margin: 0;
  }

  .pc-desc {
    color: var(--text-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    max-width: min(42ch, 100%);
    margin: 0;
  }

  .pc-btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.4rem;
    height: 3.1rem;
    padding: 0 1.9rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: var(--bg);
    text-indent: 0.06em;
    border: 1.5px dashed transparent;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pc-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    border-radius: 999px;
    transition:
      inset 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.3s ease;
  }

  .pc-btn::after {
    content: '';
    position: absolute;
    inset: -7px;
    z-index: -1;
    border: 1.5px dashed var(--border);
    border-radius: 999px;
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pc-btn:hover {
    transform: translateY(-2px);
  }

  .pc-btn:hover::before {
    filter: brightness(1.08);
  }

  .pc-btn:hover::after {
    opacity: 1;
    transform: scale(1);
  }

  .pc-btn:active::before {
    inset: -7px;
  }

  :global([data-theme="dark"]) .pc-btn {
    color: var(--text);
    border-color: var(--border);
  }

  :global([data-theme="dark"]) .pc-btn::before {
    background: var(--card);
  }

  :global([data-theme="dark"]) .pc-btn:hover::before {
    filter: none;
    background: color-mix(in oklch, var(--card) 78%, var(--accent) 22%);
  }

  .pc-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .pc-download {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.4rem;
    width: 3.1rem;
    height: 3.1rem;
    flex: none;
    border-radius: 999px;
    background: var(--accent-2);
    color: var(--bg);
    text-decoration: none;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.3s ease;
  }

  :global([data-theme="dark"]) .pc-download {
    background: var(--card);
    color: var(--text);
    border: 1.5px dashed var(--border);
  }

  :global([data-theme="dark"]) .pc-download:hover {
    filter: none;
    background: color-mix(in oklch, var(--card) 78%, var(--accent-2) 22%);
  }

  .pc-download::after {
    content: '';
    position: absolute;
    inset: -7px;
    border: 1.5px dashed var(--border);
    border-radius: 999px;
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pc-download:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
  }

  .pc-download:hover::after,
  .pc-download:focus-visible::after {
    opacity: 1;
    transform: scale(1);
  }

  .pc-tip {
    position: absolute;
    bottom: calc(100% + 0.85rem);
    left: 50%;
    transform: translate(-50%, 4px);
    padding: 0.35rem 0.7rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--bg);
    background: var(--text);
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pc-download:hover .pc-tip,
  .pc-download:focus-visible .pc-tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .pc-soon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.4rem;
    padding: 0.85rem 1.9rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    text-indent: 0.06em;
    border: 1.5px dashed var(--border);
    border-radius: 999px;
  }

  .pc-sticky {
    position: sticky;
    top: 15vh;
    align-self: start;
    height: 70vh;
    display: grid;
    place-items: center;
    box-sizing: border-box;
  }

  .pc-media-stage {
    display: grid;
    justify-items: center;
    align-items: center;
    width: 100%;
  }

  .pc-media {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s ease,
      visibility 0s linear 0.6s;
  }

  .pc-media.active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s ease;
  }

  .pc-media img {
    display: block;
    max-width: 100%;
    max-height: 60vh;
    width: auto;
    height: auto;
    border-radius: 8px;
    outline: 1.5px dashed var(--border);
    outline-offset: 8px;
  }

  .pc-media-inline {
    display: none;
  }

  @media (max-width: 820px) {
    .pc-scroll {
      grid-template-columns: 1fr;
    }

    .pc-sticky {
      display: none;
    }

    .pc-list {
      gap: clamp(3rem, 11vw, 4.5rem);
    }

    .pc-item {
      min-height: 0;
      opacity: 1;
      transform: none;
      gap: 1rem;
    }

    .pc-media-inline {
      display: block;
      width: 100%;
      height: auto;
      margin-bottom: 0.5rem;
      border-radius: 10px;
      outline: 1.5px dashed var(--border);
      outline-offset: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-item,
    .pc-media { transition: opacity 0.3s ease; }
    .pc-item { transform: none; }
  }
</style>

<script>
  function initProjects() {
    const root = document.querySelector<HTMLElement>('.pc');
    if (!root) return;

    const items = Array.from(root.querySelectorAll<HTMLElement>('.pc-item'));
    const medias = Array.from(root.querySelectorAll<HTMLElement>('.pc-media'));
    if (!items.length) return;
    let current = 0;

    function activate(i: number) {
      if (i === current) return;
      items[current]?.classList.remove('active');
      medias[current]?.classList.remove('active');
      medias[current]?.setAttribute('aria-hidden', 'true');

      items[i]?.classList.add('active');
      medias[i]?.classList.add('active');
      medias[i]?.setAttribute('aria-hidden', 'false');
      current = i;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const idx = Number((e.target as HTMLElement).dataset.index);
            if (!Number.isNaN(idx)) activate(idx);
          }
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );

    items.forEach((it) => io.observe(it));
  }

  document.addEventListener('DOMContentLoaded', initProjects);
</script>
