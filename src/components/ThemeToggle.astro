---
---

<button class="theme-toggle" type="button" onclick="toggleTheme()" aria-label="Toggle color theme">
  <svg class="sun" viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <circle cx="50" cy="50" r="20" fill="currentColor" />
    <g stroke="currentColor" stroke-width="7" stroke-linecap="round">
      <line x1="50" y1="24" x2="50" y2="12" />
      <line x1="50" y1="76" x2="50" y2="88" />
      <line x1="24" y1="50" x2="12" y2="50" />
      <line x1="76" y1="50" x2="88" y2="50" />
      <line x1="68.38" y1="31.62" x2="76.87" y2="23.13" />
      <line x1="68.38" y1="68.38" x2="76.87" y2="76.87" />
      <line x1="31.62" y1="68.38" x2="23.13" y2="76.87" />
      <line x1="31.62" y1="31.62" x2="23.13" y2="23.13" />
    </g>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<style>
  .theme-toggle {
    flex-shrink: 0;
    width: clamp(2.5rem, 4vw, 3.3rem);
    height: clamp(2.5rem, 4vw, 3.3rem);
    padding: 0;
    border: none;
    background: none;
    color: var(--text);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .theme-toggle:hover {
    transform: rotate(60deg);
  }

  .sun,
  .moon {
    width: 100%;
    height: 100%;
    display: block;
  }

  .moon {
    display: none;
    width: 78%;
    height: 78%;
  }

  :global([data-theme="dark"]) .sun {
    display: none;
  }

  :global([data-theme="dark"]) .moon {
    display: block;
    color: #eaf2ff;
    filter:
      drop-shadow(0 0 6px rgba(170, 205, 255, 0.55))
      drop-shadow(0 0 16px rgba(120, 170, 255, 0.35));
    animation: theme-moon-glow 4.5s ease-in-out infinite;
  }

  @keyframes theme-moon-glow {
    0%, 100% {
      filter:
        drop-shadow(0 0 5px rgba(170, 205, 255, 0.45))
        drop-shadow(0 0 12px rgba(120, 170, 255, 0.25));
    }
    50% {
      filter:
        drop-shadow(0 0 9px rgba(190, 220, 255, 0.7))
        drop-shadow(0 0 22px rgba(140, 185, 255, 0.45));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-theme="dark"]) .moon {
      animation: none;
    }
  }
</style>
