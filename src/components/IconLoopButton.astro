---
interface Props {
  icon: 'download' | 'arrow-up' | 'arrow-left';
  label: string;
  direction?: 'up' | 'down' | 'left' | 'right';
  variant?: 'download' | 'to-top' | 'accent';
  href?: string;
  id?: string;
  target?: string;
  rel?: string;
}

const {
  icon,
  label,
  direction = 'up',
  variant = 'download',
  href,
  id,
  target,
  rel,
} = Astro.props;

const paths: Record<Props['icon'], string> = {
  download:
    '<path d="M12 13v8l-4-4" /><path d="m12 21 4-4" /><path d="M4.393 15.269A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.436 8.284" />',
  'arrow-up': '<path d="M12 19V5M12 5l-6.5 6.5M12 5l6.5 6.5" />',
  'arrow-left': '<path d="M19 12H5M5 12l6.5-6.5M5 12l6.5 6.5" />',
};

const Tag = href ? 'a' : 'button';
const tagAttrs = href ? { href, target, rel } : { type: 'button' as const };
---

<Tag
  class="ib"
  data-dir={direction}
  data-variant={variant}
  id={id}
  aria-label={label}
  {...tagAttrs}
>
  <span class="ib-viewport">
    <span class="ib-icon ib-icon--lead">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
        set:html={paths[icon]}
      />
    </span>
    <span class="ib-icon ib-icon--next">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
        set:html={paths[icon]}
      />
    </span>
  </span>
</Tag>

<style>
  .ib {
    --ib-size: 3.1rem;
    --ib-icon: 22px;
    --ib-travel: 150%;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--ib-size);
    height: var(--ib-size);
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--ib-bg);
    color: var(--ib-fg);
    text-decoration: none;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .ib[data-dir="up"] {
    --tx: 0px;
    --ty: calc(-1 * var(--ib-travel));
    --rx: 0px;
    --ry: var(--ib-travel);
  }
  .ib[data-dir="down"] {
    --tx: 0px;
    --ty: var(--ib-travel);
    --rx: 0px;
    --ry: calc(-1 * var(--ib-travel));
  }
  .ib[data-dir="left"] {
    --tx: calc(-1 * var(--ib-travel));
    --ty: 0px;
    --rx: var(--ib-travel);
    --ry: 0px;
  }
  .ib[data-dir="right"] {
    --tx: var(--ib-travel);
    --ty: 0px;
    --rx: calc(-1 * var(--ib-travel));
    --ry: 0px;
  }

  .ib-viewport {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
  }

  .ib-icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transition: transform 0.4s cubic-bezier(0.7, 0, 0.2, 1);
  }

  .ib-icon--next {
    transform: translate(var(--rx), var(--ry));
  }

  .ib:hover .ib-icon--lead,
  .ib:focus-visible .ib-icon--lead {
    transform: translate(var(--tx), var(--ty));
  }

  .ib:hover .ib-icon--next,
  .ib:focus-visible .ib-icon--next {
    transform: translate(0, 0);
  }

  .ib-icon svg {
    width: var(--ib-icon);
    height: var(--ib-icon);
  }

  .ib::after {
    content: "";
    position: absolute;
    z-index: 0;
    inset: -7px;
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: 999px;
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ib:hover::after,
  .ib:focus-visible::after {
    opacity: 1;
    transform: scale(1);
  }

  .ib:focus-visible {
    outline: none;
  }

  .ib[data-variant="download"] {
    --ib-bg: var(--btn-2);
    --ib-fg: var(--bg);
    margin-top: 0.4rem;
  }

  .ib[data-variant="download"]:hover,
  .ib[data-variant="download"]:focus-visible {
    --ib-bg: var(--btn-2-hover);
  }

  :global([data-theme="dark"]) .ib[data-variant="download"] {
    --ib-fg: var(--text);
    border: var(--dash-width) dashed var(--dash-color);
  }

  .ib[data-variant="accent"],
  .ib[data-variant="to-top"] {
    --ib-size: 48px;
    --ib-bg: var(--btn);
    --ib-fg: var(--btn-fg);
  }

  .ib[data-variant="accent"]:hover,
  .ib[data-variant="accent"]:focus-visible,
  .ib[data-variant="to-top"]:hover,
  .ib[data-variant="to-top"]:focus-visible {
    --ib-bg: var(--btn-hover);
  }

  .ib[data-variant="to-top"] {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 90;
    opacity: 0;
    visibility: hidden;
    translate: 0 10px;
    transition:
      background 0.3s ease,
      opacity 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      translate 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.28s;
  }

  .ib[data-variant="to-top"].is-visible {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .ib,
    .ib::after,
    .ib-icon {
      transition: none;
    }
  }
</style>
