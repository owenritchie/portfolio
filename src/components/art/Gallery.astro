---
interface Props {
  photos: string[];
}

const { photos } = Astro.props;
---

<section class="gallery">
  {photos.map((photo) => (
    <button class="photo-item" onclick={`openLightbox('/photos/${photo}')`} aria-label="View photo">
      <div class="photo-inner">
        <img src={`/photos/${photo}`} alt="" loading="lazy" />
      </div>
    </button>
  ))}
</section>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .photo-item {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    border-radius: 16px;
    border: 2px dashed transparent;
    aspect-ratio: 1;
    display: block;
    width: 100%;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out, border-color 0.3s ease;
  }

  :global(.photo-item.visible) {
    opacity: 1;
    transform: translateY(0);
  }

  .photo-item:hover {
    border-color: var(--border);
  }

  .photo-inner {
    border-radius: 14px;
    overflow: hidden;
    width: 100%;
    height: 100%;
    transition: transform 0.3s ease;
  }

  .photo-item:hover .photo-inner {
    transform: scale(0.97);
  }

  .photo-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .gallery {
      gap: 0.5rem;
    }

    .photo-item {
      border-radius: 10px;
    }

    .photo-inner {
      border-radius: 8px;
    }
  }
</style>

<script>
  function initGalleryCards() {
    const items = document.querySelectorAll('.photo-item');

    items.forEach((item, i) => {
      const col = i % 3;
      (item as HTMLElement).style.transitionDelay = `${col * 0.1}s`;
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    items.forEach(item => observer.observe(item));
  }

  document.addEventListener('DOMContentLoaded', () => {
    initGalleryCards();
  });
</script>
