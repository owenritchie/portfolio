---
---

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<div class="about-map" data-reveal="fade">
  <div id="about-map-canvas" class="about-map-canvas"></div>
  <div class="about-map-tint"></div>

  <div class="about-map-pin">
    <span class="about-map-pin-ring"></span>
    <span class="about-map-pin-shape">
      <span class="about-map-pin-hole"></span>
    </span>
    <span class="about-map-pin-shadow"></span>
  </div>
</div>

<style>
  .about-map {
    --pin: color-mix(in oklch, var(--card) 80%, var(--border) 20%);
    position: relative;
    height: 100%;
    min-height: clamp(420px, 54vh, 620px);
    border-radius: 20px;
    overflow: hidden;
  }

  :global([data-theme="dark"]) .about-map {
    --pin: var(--accent);
  }

  @media (max-width: 820px) {
    .about-map {
      min-height: clamp(220px, 34vh, 300px);
    }
  }

  .about-map-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    filter: grayscale(1);
    isolation: isolate;
    transform: translateZ(0);
  }

  :global(.about-map .leaflet-control-zoom),
  :global(.about-map .leaflet-control-attribution) {
    display: none !important;
  }

  :global(.about-map .leaflet-container) {
    background: var(--card);
  }

  :global(.about-map .leaflet-tile) {
    backface-visibility: hidden;
    will-change: transform;
  }

  :global(.about-map .leaflet-tile-container) {
    transform: translateZ(0);
  }

  .about-map-tint {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--accent-2);
    mix-blend-mode: color;
    opacity: 0.35;
    pointer-events: none;
  }

  .about-map-pin {
    position: absolute;
    top: 46%;
    left: 50%;
    transform: translate(-50%, -100%);
    z-index: 5;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: about-map-drop 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .about-map-pin-shape {
    display: block;
    width: 26px;
    height: 26px;
    border-radius: 50% 50% 50% 0;
    background: var(--pin);
    border: 2px solid var(--bg);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35);
    transform: rotate(-45deg);
    position: relative;
    z-index: 2;
  }

  .about-map-pin-hole {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 9px;
    height: 9px;
    background: var(--bg);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .about-map-pin-shadow {
    width: 14px;
    height: 5px;
    margin-top: 1px;
    background: radial-gradient(ellipse, rgba(0, 0, 0, 0.4) 0%, transparent 75%);
    border-radius: 50%;
    z-index: 1;
  }

  .about-map-pin-ring {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 28px;
    height: 28px;
    transform: translate(-50%, 45%);
    border: 1.5px dashed var(--pin);
    border-radius: 50%;
    z-index: 1;
    animation: about-map-ring 3s ease-out infinite;
  }

  @keyframes about-map-drop {
    0% { transform: translate(-50%, -160%); opacity: 0; }
    60% { transform: translate(-50%, -96%); opacity: 1; }
    100% { transform: translate(-50%, -100%); opacity: 1; }
  }

  @keyframes about-map-ring {
    0% { transform: translate(-50%, 45%) scale(0.6); opacity: 0.8; }
    100% { transform: translate(-50%, 45%) scale(2.2); opacity: 0; }
  }

</style>

<script>
  function initAboutMap() {
    const el = document.getElementById('about-map-canvas');
    if (!el) return;

    const L = (window as any).L;
    if (!L) {
      setTimeout(initAboutMap, 80);
      return;
    }

    const lat = 45.4248;
    const lng = -75.6829;

    const map = L.map(el, {
      center: [lat, lng],
      zoom: 14,
      zoomControl: false,
      attributionControl: false,
      scrollWheelZoom: false,
      dragging: false,
      touchZoom: false,
      doubleClickZoom: false,
      boxZoom: false,
      keyboard: false,
      tap: false,
    });

    let tiles: any = null;
    function setTiles() {
      const dark = document.documentElement.getAttribute('data-theme') === 'dark';
      const url = dark
        ? 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
        : 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png';
      if (tiles) map.removeLayer(tiles);
      tiles = L.tileLayer(url, { maxZoom: 18, opacity: 1 }).addTo(map);
    }
    setTiles();

    el.style.pointerEvents = 'none';

    const refresh = () => map.invalidateSize();
    setTimeout(refresh, 250);
    window.addEventListener('load', refresh);
    if ('ResizeObserver' in window) new ResizeObserver(refresh).observe(el);

    new MutationObserver(() => setTiles()).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }

  if (document.readyState !== 'loading') initAboutMap();
  else document.addEventListener('DOMContentLoaded', initAboutMap);
</script>
