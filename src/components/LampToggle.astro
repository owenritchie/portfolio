---
interface Props {
  restLength?: number;
  maxPull?: number;
  size?: string;
  class?: string;
}

const { restLength = 40, maxPull = 20, size = '44px', class: className } = Astro.props;

const ANCHOR_X = 6;
const ANCHOR_Y = 6;
const KNOB_RADIUS = 11;
const MAX_ANGLE = 1.3;

const restKnobY = ANCHOR_Y + restLength;
const viewW = Math.max(40, Math.round(restLength * 0.444));
const viewH = Math.round(restKnobY + maxPull + KNOB_RADIUS + 8);
const midY = (ANCHOR_Y + restKnobY) / 2;
---

<div
  class={`lamp-toggle${className ? ' ' + className : ''}`}
  style={`--lamp-size: ${size}`}
  data-rest={restLength}
  data-pull={maxPull}
>
  <svg class="lamp-svg" viewBox={`0 0 ${viewW} ${viewH}`} overflow="visible" aria-hidden="true">
    <path class="lamp-cord" d={`M ${ANCHOR_X} ${ANCHOR_Y} Q ${ANCHOR_X} ${midY} ${ANCHOR_X} ${restKnobY}`}></path>
    <g class="lamp-knob-group" transform={`translate(${ANCHOR_X},${restKnobY})`}>
      <circle class="lamp-knob" r="11"></circle>
      <g class="lamp-icon lamp-icon-sun">
        <circle r="3.8" fill="currentColor"></circle>
        <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <line x1="0" y1="-6.4" x2="0" y2="-8.4"></line>
          <line x1="0" y1="6.4" x2="0" y2="8.4"></line>
          <line x1="-6.4" y1="0" x2="-8.4" y2="0"></line>
          <line x1="6.4" y1="0" x2="8.4" y2="0"></line>
          <line x1="-4.5" y1="-4.5" x2="-5.9" y2="-5.9"></line>
          <line x1="4.5" y1="4.5" x2="5.9" y2="5.9"></line>
          <line x1="-4.5" y1="4.5" x2="-5.9" y2="5.9"></line>
          <line x1="4.5" y1="-4.5" x2="5.9" y2="-5.9"></line>
        </g>
      </g>
      <g class="lamp-icon lamp-icon-moon" transform="translate(-12,-12)">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor"></path>
      </g>
      <circle
        class="lamp-hit"
        r="16"
        tabindex="0"
        role="button"
        aria-label="Pull the cord to switch between light and dark mode"
      ></circle>
    </g>
  </svg>
</div>

<script>
  function initLamp(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>('.lamp-svg');
    const cord = root.querySelector<SVGPathElement>('.lamp-cord');
    const knobGroup = root.querySelector<SVGGElement>('.lamp-knob-group');
    const hit = root.querySelector<SVGCircleElement>('.lamp-hit');
    if (!svg || !cord || !knobGroup || !hit) return;

    const ANCHOR = { x: 6, y: 6 };
    const REST_LENGTH = Number(root.dataset.rest) || 40;
    const MAX_PULL = Number(root.dataset.pull) || 20;
    const RESISTANCE = Math.max(14, REST_LENGTH * 0.29);
    const TOGGLE_RATIO = 0.62;
    const GRAVITY = 700;
    const DAMPING = 2.6;
    const MAX_ANGLE = 1.3;
    const KNOB_RADIUS = 11;

    let introActive = true;
    setTimeout(() => {
      introActive = false;
    }, 1600);

    const introSign = Math.random() < 0.5 ? -1 : 1;
    const introAngle = introSign * (0.65 + Math.random() * 0.65);
    const introStub = 6 + Math.random() * 10;

    let angle = introAngle;
    let angularVel = 0;
    let extra = -(REST_LENGTH - introStub);
    let extraTarget = 0;
    let dragging = false;
    let lastMoveTime = 0;
    let velSmooth = 0;
    let lastFrameTime = 0;
    let bendCurrent = 0;
    let bendVel = 0;

    function svgPoint(e: PointerEvent) {
      const rect = svg!.getBoundingClientRect();
      const vb = svg!.viewBox.baseVal;
      const scaleX = vb.width / rect.width;
      const scaleY = vb.height / rect.height;
      return {
        x: (e.clientX - rect.left) * scaleX,
        y: (e.clientY - rect.top) * scaleY,
      };
    }

    function onPointerDown(e: PointerEvent) {
      dragging = true;
      angularVel = 0;
      velSmooth = 0;
      lastMoveTime = performance.now();
      hit!.setPointerCapture(e.pointerId);
      root.classList.add('is-dragging');
    }

    function onPointerMove(e: PointerEvent) {
      if (!dragging) return;
      const now = performance.now();
      const p = svgPoint(e);
      const dx = p.x - ANCHOR.x;
      const dy = Math.max(4, p.y - ANCHOR.y);
      const dist = Math.hypot(dx, dy);
      const rawExtra = Math.max(0, dist - REST_LENGTH);
      extraTarget = MAX_PULL * (1 - Math.exp(-rawExtra / RESISTANCE));

      const newAngle = Math.max(-MAX_ANGLE, Math.min(MAX_ANGLE, Math.atan2(dx, dy)));
      const dt = Math.max(0.001, (now - lastMoveTime) / 1000);
      const rawVel = (newAngle - angle) / dt;
      velSmooth = velSmooth * 0.7 + rawVel * 0.3;
      angle = newAngle;
      lastMoveTime = now;
    }

    function onPointerUp() {
      if (!dragging) return;
      dragging = false;
      root.classList.remove('is-dragging');

      if (extraTarget / MAX_PULL > TOGGLE_RATIO) {
        (window as any).toggleTheme();
      }

      extraTarget = 0;
      angularVel = velSmooth;
    }

    hit.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);
    window.addEventListener('pointercancel', onPointerUp);

    hit.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        (window as any).toggleTheme();
        angularVel += angle >= 0 ? -0.6 : 0.6;
      }
    });

    function frame(t: number) {
      if (!lastFrameTime) lastFrameTime = t;
      const dt = Math.min((t - lastFrameTime) / 1000, 0.032);
      lastFrameTime = t;

      if (!dragging) {
        const length = Math.max(8, REST_LENGTH + extra);
        const accel = -(GRAVITY / length) * Math.sin(angle) - DAMPING * angularVel;
        angularVel += accel * dt;
        angle += angularVel * dt;

        if (!introActive) {
          if (angle > MAX_ANGLE) {
            angle = MAX_ANGLE;
            angularVel = Math.min(angularVel, 0);
          } else if (angle < -MAX_ANGLE) {
            angle = -MAX_ANGLE;
            angularVel = Math.max(angularVel, 0);
          }
        }

        extra += (extraTarget - extra) * Math.min(1, dt * 6);
      } else {
        extra += (extraTarget - extra) * Math.min(1, dt * 16);
      }

      const length = Math.max(8, REST_LENGTH + extra);
      const kx = ANCHOR.x + length * Math.sin(angle);
      const ky = ANCHOR.y + length * Math.cos(angle);

      const dx = kx - ANCHOR.x;
      const dy = ky - ANCHOR.y;
      const segLen = Math.hypot(dx, dy) || 1;
      const perpX = -dy / segLen;
      const perpY = dx / segLen;
      const whipTarget = Math.max(-38, Math.min(38, angularVel * 8));
      const springK = 170;
      const springD = 9;
      const springAccel = (whipTarget - bendCurrent) * springK - bendVel * springD;
      bendVel += springAccel * dt;
      bendCurrent += bendVel * dt;
      const bend = bendCurrent;
      const midX = (ANCHOR.x + kx) / 2 + perpX * bend;
      const midY = (ANCHOR.y + ky) / 2 + perpY * bend;

      cord!.setAttribute('d', `M ${ANCHOR.x} ${ANCHOR.y} Q ${midX} ${midY} ${kx} ${ky}`);
      knobGroup!.setAttribute('transform', `translate(${kx},${ky})`);

      requestAnimationFrame(frame);
    }

    requestAnimationFrame(frame);
  }

  document.querySelectorAll<HTMLElement>('.lamp-toggle').forEach(initLamp);
</script>

<style>
  .lamp-toggle {
    display: block;
    width: var(--lamp-size, 44px);
  }

  .lamp-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .lamp-cord {
    fill: none;
    stroke: oklch(0.74 0.07 60);
    stroke-width: 2.7;
    stroke-linecap: round;
    stroke-dasharray: 3.4 3.4;
  }

  :global([data-theme="dark"]) .lamp-cord {
    stroke: var(--text-muted);
  }

  .lamp-knob {
    fill: oklch(0.38 0.11 145);
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.22));
  }

  :global([data-theme="dark"]) .lamp-knob {
    fill: var(--accent);
  }

  .lamp-icon {
    color: var(--bg);
  }

  .lamp-icon-sun {
    color: #fff;
  }

  .lamp-icon-moon {
    display: none;
  }

  :global([data-theme="dark"]) .lamp-icon-sun {
    display: none;
  }

  :global([data-theme="dark"]) .lamp-icon-moon {
    display: block;
  }

  .lamp-hit {
    fill: transparent;
    pointer-events: all;
    cursor: grab;
    touch-action: none;
    outline: none;
  }

  .lamp-knob-group:has(.lamp-hit:focus-visible) .lamp-knob {
    stroke: var(--text);
    stroke-width: 2;
  }

  .lamp-toggle.is-dragging .lamp-hit {
    cursor: grabbing;
  }
</style>
