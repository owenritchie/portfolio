---
interface Entry {
  title: string;
  role: string;
  start: string;
  end: string;
  link?: string;
  logo?: string;
  logoZoom?: number;
  logoFit?: 'cover' | 'contain';
  description?: string;
  kind?: 'education';
  courses?: string[];
  skills?: string[];
  stats?: { value: string; num: number; label: string }[];
  hidden?: boolean;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (d: string) => {
  if (d === 'present') return 'Present';
  const [y, m] = d.split('-');
  return `${MONTHS[Number(m) - 1]} ${y}`;
};

const counter = (value: string) => {
  const m = value.match(/^([^0-9]*)([0-9]+(?:\.[0-9]+)?)(.*)$/);
  if (!m) return null;
  return { prefix: m[1], target: m[2], suffix: m[3], decimals: (m[2].split('.')[1] ?? '').length };
};

const shape = (e: Entry) => ({
  ...e,
  range: `${fmt(e.start)} — ${fmt(e.end)}`,
  best: (e.stats ?? []).slice(0, 3),
});

const visible = entries.filter((e) => !e.hidden);
const jobs = visible
  .filter((e) => e.kind !== 'education')
  .sort((a, b) => b.start.localeCompare(a.start))
  .map(shape);
const schools = visible.filter((e) => e.kind === 'education').map(shape);
---

<section id="work" class="timeline work" aria-label="Work">
  <div class="work-top">
  <h2 class="work-heading" data-reveal="up"><span class="wh-long">Where I've done my work</span><span class="wh-short">Experience</span></h2>
  </div>

  {schools.map((school) => (
    <article class="edu" data-reveal="up">
      <header class="work-job-head">
        {school.logo && (
          <span class="work-logo">
            <img src={school.logo} alt="" width="56" height="56" loading="lazy" style={school.logoZoom ? `transform:scale(${school.logoZoom})` : undefined} />
          </span>
        )}
        <div>
          <h3 class="work-name">
            {school.link ? <a href={school.link} target="_blank" rel="noopener">{school.title}</a> : school.title}
          </h3>
          <p class="work-role">{school.role}</p>
        </div>
        <p class="work-dates">{school.range}</p>
      </header>
      <div class="edu-body">
        <div>
          {school.description && <p class="work-desc">{school.description}</p>}
        </div>
        {school.courses && school.courses.length > 0 && (
          <div class="edu-courses">
            <p class="work-role">Coursework</p>
            <ul>
              {school.courses.map((c) => <li>{c}</li>)}
              <li class="edu-more">and more!</li>
            </ul>
          </div>
        )}
      </div>
    </article>
  ))}

  <div class="work-list">
    {jobs.map((job, i) => (
      <article class:list={['work-group', { flip: i % 2 === 1, solo: job.best.length === 0 }]}>
        <div class="work-job" data-reveal={i % 2 === 1 ? 'right' : 'left'}>
          <header class="work-job-head">
            {job.logo && (
              <span class="work-logo">
                <img
                  src={job.logo}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                  style={[job.logoFit ? `object-fit:${job.logoFit}` : '', job.logoZoom ? `transform:scale(${job.logoZoom})` : ''].filter(Boolean).join(';') || undefined}
                />
              </span>
            )}
            <div>
              <h3 class="work-name">
                {job.link ? <a href={job.link} target="_blank" rel="noopener">{job.title}</a> : job.title}
              </h3>
              <p class="work-role">{job.role}</p>
            </div>
            <p class="work-dates">{job.range}</p>
          </header>
          {job.description && <p class="work-desc">{job.description}</p>}
        </div>

        {job.best.length > 0 && (
          <ul class="work-stats" aria-label={`Highlights at ${job.title}`}>
            {job.best.map((s, k) => (
              <li class:list={['work-stat', { lead: k === 0 }]} data-reveal={i % 2 === 1 ? 'left' : 'right'} style={`--rd:${0.12 + k * 0.1}s`}>
                {(() => {
                  const c = counter(s.value);
                  return c
                    ? <b aria-label={s.value} data-prefix={c.prefix} data-target={c.target} data-suffix={c.suffix} data-decimals={c.decimals}>{s.value}</b>
                    : <b>{s.value}</b>;
                })()}
                <span>{s.label}</span>
              </li>
            ))}
          </ul>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .work {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: calc(-1 * clamp(28px, 5vw, 52px));
    scroll-margin-top: 1.5rem;
    background: var(--bg);
    border-radius: clamp(28px, 5vw, 52px) clamp(28px, 5vw, 52px) 0 0;
    padding: clamp(2.5rem, 6vw, 4.5rem) max((100vw - 1120px) / 2, clamp(1.5rem, 5vw, 5rem)) clamp(5.5rem, 10vw, 8rem);
  }

  .work::before {
    content: "";
    display: none;
    position: absolute;
    inset: 0;
    border: var(--dash-width) dashed var(--dash-color);
    border-bottom: none;
    border-radius: inherit;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, black 0, black 6px, transparent 64px);
    mask-image: linear-gradient(to bottom, black 0, black 6px, transparent 64px);
  }

  :global([data-theme="dark"]) .work::before {
    display: block;
  }

  .work-heading {
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    color: var(--heading-ink);
    margin: 0;
  }

  .work-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin: 0 0 clamp(2.5rem, 6vw, 4rem);
  }

  .wh-short {
    display: none;
  }

  .work-list {
    display: grid;
    gap: 0.9rem;
  }

  .work-group {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 0.9rem;
  }

  .work-group.flip .work-job {
    order: 2;
  }

  .work-group.flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr);
  }

  .work-group.solo {
    grid-template-columns: minmax(0, 1fr);
  }

  .work-job {
    display: flex;
    flex-direction: column;
    padding: clamp(1.4rem, 2.6vw, 2.1rem);
    border-radius: 24px;
    background: var(--card);
  }

  .edu {
    margin-bottom: clamp(1.5rem, 3.5vw, 2.5rem);
    padding: clamp(1.4rem, 2.6vw, 2.1rem);
    border: var(--dash-width) dashed var(--dash-color);
    border-radius: 24px;
  }

  .edu-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .edu-body .work-desc {
    margin-top: 1.2rem;
  }

  .edu-courses {
    margin-top: 1.2rem;
    padding-left: clamp(1.5rem, 3vw, 2.5rem);
    border-left: var(--dash-width) dashed var(--dash-color);
  }

  .edu-courses .work-role {
    margin: 0 0 0.6rem;
  }

  .edu-courses ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem 1.5rem;
  }

  .edu-courses li {
    font-size: 0.98rem;
    color: var(--text);
  }

  .edu-courses .edu-more {
    color: var(--text-muted);
    font-style: italic;
  }

  @media (max-width: 860px) {
    .edu-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .edu-courses {
      padding-left: 0;
      border-left: 0;
    }
  }

  .work-job-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
  }

  .work-logo {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg);
  }

  .work-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-name {
    font-family: var(--heading-font);
    font-weight: bold;
    font-size: clamp(1.7rem, 2.8vw, 2.3rem);
    line-height: 1.05;
    color: var(--heading-ink);
    margin: 0;
  }

  .work-name a {
    color: inherit;
    text-decoration: none;
  }

  .work-role {
    font-family: 'Grenze', serif;
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0.35rem 0 0;
  }

  .work-dates {
    align-self: start;
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
    margin: 0.35rem 0 0;
  }

  .work-desc {
    font-size: clamp(0.98rem, 1.15vw, 1.06rem);
    line-height: 1.7;
    color: var(--text);
    opacity: 0.85;
    margin: 1.2rem 0 0;
  }

  .work-stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 0.9rem;
    padding: 0;
    margin: 0;
  }

  .work-stat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.9rem;
    padding: 1.15rem 1.2rem;
    border-radius: 24px;
    border: var(--dash-width) dashed var(--dash-color);
  }

  .work-stat.lead {
    grid-column: 1 / -1;
    border-color: transparent;
    background: var(--green);
  }

  .work-stat b {
    font-family: 'Grenze', serif;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    font-size: clamp(1.9rem, 3.2vw, 2.6rem);
    line-height: 1;
    color: var(--heading-ink);
  }

  .work-stat.lead b {
    font-size: clamp(2.6rem, 5vw, 3.8rem);
  }

  .work-stat span {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.autoscrolling) .work-stat.lead:not(:global(.is-in)) {
      background: linear-gradient(var(--green), var(--green)) no-repeat 0 0 / 0% 100%;
    }

    :global(.autoscrolling) .work-stat.lead {
      transition: background-size 0.9s var(--ease-out) 0.15s;
    }
  }

  @media (max-width: 860px) {
    .wh-long {
      display: none;
    }

    .wh-short {
      display: inline;
    }

    .work-group,
    .work-group.flip {
      grid-template-columns: minmax(0, 1fr);
    }

    .work-group.flip .work-job {
      order: 0;
    }

    .work-job-head {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .work-dates {
      grid-column: 1 / -1;
      margin: 0;
    }
  }

  @media (max-width: 480px) {
    .work-stats {
      grid-auto-rows: auto;
    }
  }

  @media (max-width: 680px) {
    .work-top {
      justify-content: center;
    }

    .work-heading {
      text-align: center;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const motion = root.classList.contains('js-reveal') && matchMedia('(prefers-reduced-motion: no-preference)').matches;
  const counters = Array.from(document.querySelectorAll<HTMLElement>('.work-stat b[data-target]'));

  if (motion && counters.length) {
    const render = (el: HTMLElement, n: number) => {
      const d = Number(el.dataset.decimals || 0);
      el.textContent = `${el.dataset.prefix ?? ''}${n.toFixed(d)}${el.dataset.suffix ?? ''}`;
    };

    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.target);
      const start = performance.now();
      const dur = 1400;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        render(el, target * (1 - Math.pow(1 - t, 3)));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          if (!root.classList.contains('autoscrolling')) return;
          render(e.target as HTMLElement, 0);
          setTimeout(() => run(e.target as HTMLElement), 250);
        });
      },
      { threshold: 0.6 }
    );
    counters.forEach((el) => io.observe(el));
  }
</script>
