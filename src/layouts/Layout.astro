---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&family=Righteous&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon/owen.svg" />
    <title>{title}</title>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8RHHBW0QB9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8RHHBW0QB9');
    </script>
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
    </script>
  </head>
  <body>
    <slot />
    <script>
      const html = document.documentElement;
      const stored = localStorage.getItem('theme');
      if (stored) {
        html.dataset.theme = stored;
      }

      window.toggleTheme = () => {
        const current = html.dataset.theme;
        const next = current === 'dark' ? 'light' : 'dark';
        html.dataset.theme = next;
        localStorage.setItem('theme', next);
      };
    </script>

    <script>
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const panels = Array.from(
          document.querySelectorAll('main > header, main > section, main > footer')
        );
        if (panels.length < 2) return;

        panels.forEach((p, i) => {
          p.style.position = 'relative';
          p.style.zIndex = String(i + 1);
        });

        const movers = panels.filter(
          (p) => p.id !== 'work' && p.id !== 'projects' && p.tagName !== 'FOOTER'
        );
        movers.forEach((p) => {
          p.style.willChange = 'transform';
        });

        const SPEED = 0.7;
        let ticking = false;

        function update() {
          for (const p of movers) {
            const top = p.getBoundingClientRect().top;
            const past = Math.min(Math.max(-top, 0), p.offsetHeight);
            p.style.transform = 'translate3d(0,' + (past * SPEED).toFixed(1) + 'px,0)';
          }
          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(update);
            ticking = true;
          }
        }

        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
        update();
      })();
    </script>

    <script>
      (function () {
        const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        if (!els.length) return;

        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
        );

        els.forEach((el) => io.observe(el));

        function flush() {
          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
            els.forEach((el) => {
              el.classList.add('is-in');
              io.unobserve(el);
            });
            removeEventListener('scroll', flush);
          }
        }
        addEventListener('scroll', flush, { passive: true });
      })();
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Myflora";
    src: url("/fonts/Myflora.otf") format("opentype");
    font-weight: normal;
    font-style: normal;
    unicode-range: U+0-2F, U+3A-10FFFF;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --bg: oklch(0.99 0.005 250);
    --card: oklch(0.96 0.018 250);
    --border: oklch(0.82 0.045 252);
    --text: oklch(0.27 0.05 255);
    --text-muted: oklch(0.5 0.055 255);
    --accent: oklch(0.6 0.24 6);
    --accent-2: oklch(0.52 0.22 273);

    --font-heading: "Inter", system-ui, -apple-system, sans-serif;
    --font-body: "Inter", system-ui, -apple-system, sans-serif;
  }

  [data-theme="dark"] {
    --bg: oklch(0.17 0.03 278);
    --card: oklch(0.22 0.04 280);
    --border: oklch(0.5 0.05 282);
    --text: oklch(0.95 0.015 288);
    --text-muted: oklch(0.72 0.06 286);
    --accent: oklch(0.64 0.19 320);
    --accent-2: oklch(0.62 0.2 268);
  }

  [data-theme="dark"] .hero-name,
  [data-theme="dark"] .hero-nav a,
  [data-theme="dark"] .about-me-heading,
  [data-theme="dark"] .timeline-heading,
  [data-theme="dark"] .timeline-side-title,
  [data-theme="dark"] .pc-heading,
  [data-theme="dark"] .pc-title {
    text-shadow:
      0 0 14px oklch(0.92 0.03 288 / 0.5),
      0 0 34px oklch(0.85 0.07 285 / 0.28);
  }

  [data-theme="dark"] .hero-name,
  [data-theme="dark"] .about-me-heading,
  [data-theme="dark"] .timeline-heading,
  [data-theme="dark"] .timeline-side-title,
  [data-theme="dark"] .pc-heading,
  [data-theme="dark"] .pc-title {
    filter: blur(0.4px);
  }

  [data-theme="dark"] .hero-toggle {
    filter: drop-shadow(0 0 12px oklch(0.9 0.05 288 / 0.5));
  }

  @media (prefers-reduced-motion: no-preference) {
    .js-reveal [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
        translate 0.9s cubic-bezier(0.16, 1, 0.3, 1),
        scale 0.9s cubic-bezier(0.16, 1, 0.3, 1),
        filter 0.9s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--rd, 0s);
    }

    .js-reveal [data-reveal="up"] { translate: 0 28px; }
    .js-reveal [data-reveal="scale"] { scale: 0.94; }
    .js-reveal [data-reveal="left"] { translate: -32px 0; }
    .js-reveal [data-reveal="right"] { translate: 32px 0; }
    .js-reveal [data-reveal="fade"] { translate: 0 0; }
    .js-reveal [data-reveal="blur"] { translate: 0 20px; filter: blur(10px); }

    .js-reveal [data-reveal="trigger"] {
      opacity: 1;
      transition: none;
    }

    .js-reveal [data-reveal].is-in {
      opacity: 1;
      translate: 0 0;
      scale: 1;
      filter: none;
    }

    .js-reveal .timeline[data-reveal]:not(.is-in) .timeline-row,
    .js-reveal .timeline[data-reveal]:not(.is-in) .timeline-bar {
      animation-play-state: paused;
    }
  }

  html {
    font-family: var(--font-body);
    font-size: 90%;
    background: var(--bg);
    color: var(--text);
    scroll-behavior: smooth;
    transition: background 0.3s, color 0.3s;
    font-weight: 400;
    line-height: 1.6;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    padding: 2rem;
    overflow-x: hidden;
  }

  @media (max-width: 480px) {
    body {
      padding: 1rem;
    }
  }
</style>
