---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&family=Righteous&family=Grenze:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />
    <link id="favicon" rel="icon" type="image/svg+xml" href="/favicon/owen-green.svg" />
    <title>{title}</title>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8RHHBW0QB9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8RHHBW0QB9');
    </script>
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
    </script>
    <script is:inline>
      (function () {
        var ua = navigator.userAgent || '';
        var ios =
          /iPad|iPhone|iPod/.test(ua) ||
          (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        var android = /Android/i.test(ua);
        if (ios || android) {
          document.documentElement.classList.add('no-pendulum');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      const html = document.documentElement;
      const stored = localStorage.getItem('theme');
      if (stored) {
        html.dataset.theme = stored;
      }

      function updateFavicon() {
        const link = document.getElementById('favicon');
        if (link) {
          link.setAttribute(
            'href',
            html.dataset.theme === 'dark' ? '/favicon/owen-pink.svg' : '/favicon/owen-green.svg'
          );
        }
      }
      updateFavicon();

      window.toggleTheme = () => {
        const current = html.dataset.theme;
        const next = current === 'dark' ? 'light' : 'dark';
        html.dataset.theme = next;
        localStorage.setItem('theme', next);
        updateFavicon();
      };
    </script>


    <script>
      (function () {
        const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        if (!els.length) return;

        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
        );

        els.forEach((el) => io.observe(el));

        function flush() {
          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
            els.forEach((el) => {
              el.classList.add('is-in');
              io.unobserve(el);
            });
            removeEventListener('scroll', flush);
          }
        }
        addEventListener('scroll', flush, { passive: true });
      })();
    </script>

    <script>
      document.addEventListener('click', (e) => {
        const projectsLink = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href="#projects"]');
        if (projectsLink) {
          const section = document.getElementById('projects');
          if (!section) return;

          const fbItem = section.querySelector<HTMLElement>('.fb-item');
          const track = section.querySelector<HTMLElement>('.dial-track');
          const target = fbItem && fbItem.offsetParent ? fbItem : track;
          if (!target) return;

          e.preventDefault();
          const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
          history.replaceState(null, '', '#projects');
          return;
        }

        const meLink = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href="#me"]');
        if (meLink) {
          const section = document.getElementById('me');
          if (!section) return;

          e.preventDefault();
          const scrollMarginTop = parseFloat(getComputedStyle(section).scrollMarginTop) || 0;
          const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({
            top: section.offsetTop - scrollMarginTop,
            behavior: reduced ? 'auto' : 'smooth',
          });
          history.replaceState(null, '', '#me');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Myflora";
    src: url("/fonts/Myflora.otf") format("opentype");
    font-weight: normal;
    font-style: normal;
    unicode-range: U+0-2F, U+3A-10FFFF;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --bg: oklch(0.98 0.014 122);
    --card: oklch(0.95 0.025 130);
    --border: oklch(0.8 0.06 140);
    --text: oklch(0.26 0.035 145);
    --text-muted: oklch(0.48 0.05 145);
    --accent: oklch(0.5 0.16 145);
    --accent-2: oklch(0.74 0.07 60);

    --dash-width: 1.5px;
    --dash-color: oklch(0.8 0 0);

    --btn: oklch(0.36 0.11 145);
    --btn-hover: oklch(0.5 0.16 145);
    --btn-fg: oklch(0.99 0.004 130);
    --btn-2: var(--accent-2);
    --btn-2-hover: oklch(0.82 0.06 60);

    --font-heading: "Inter", system-ui, -apple-system, sans-serif;
    --font-body: "Inter", system-ui, -apple-system, sans-serif;
  }

  html.menu-open,
  html.menu-open body {
    overflow: hidden;
  }

  html.no-pendulum .lamp-anchor {
    display: none;
  }

  [data-theme="dark"] {
    --bg: oklch(0.17 0.03 278);
    --card: oklch(0.22 0.04 280);
    --border: oklch(0.5 0.05 282);
    --text: oklch(0.95 0.015 288);
    --text-muted: oklch(0.72 0.06 286);
    --accent: oklch(0.64 0.19 320);
    --accent-2: oklch(0.62 0.2 268);

    --dash-color: oklch(0.5 0 0);

    --btn: var(--card);
    --btn-hover: color-mix(in oklch, var(--card) 78%, var(--accent) 22%);
    --btn-fg: var(--text);
    --btn-2: var(--card);
    --btn-2-hover: color-mix(in oklch, var(--card) 78%, var(--accent-2) 22%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .js-reveal [data-reveal] {
      opacity: 0;
      transition:
        opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
        translate 0.9s cubic-bezier(0.16, 1, 0.3, 1),
        scale 0.9s cubic-bezier(0.16, 1, 0.3, 1),
        filter 0.9s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--rd, 0s);
    }

    .js-reveal [data-reveal="up"] { translate: 0 28px; }
    .js-reveal [data-reveal="scale"] { scale: 0.94; }
    .js-reveal [data-reveal="left"] { translate: -32px 0; }
    .js-reveal [data-reveal="right"] { translate: 32px 0; }
    .js-reveal [data-reveal="fade"] { translate: 0 0; }
    .js-reveal [data-reveal="blur"] { translate: 0 20px; filter: blur(10px); }

    .js-reveal [data-reveal="trigger"] {
      opacity: 1;
      transition: none;
    }

    .js-reveal [data-reveal].is-in {
      opacity: 1;
      translate: 0 0;
      scale: 1;
      filter: none;
    }

    .js-reveal .timeline[data-reveal]:not(.is-in) .timeline-row,
    .js-reveal .timeline[data-reveal]:not(.is-in) .timeline-bar {
      animation-play-state: paused;
    }
  }

  main > header,
  main > section,
  main > footer {
    position: relative;
  }

  .hero { z-index: 1; }
  #me { z-index: 2; }
  #work { z-index: 3; }
  #projects { z-index: 4; }
  .site-footer { z-index: 5; }

  @keyframes hero-lag {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(0, 70%, 0); }
  }

  @keyframes me-lag {
    0% { transform: translate3d(0, 0, 0); }
    25% { transform: translate3d(0, 23.41%, 0); }
    50% { transform: translate3d(0, 45.25%, 0); }
    75% { transform: translate3d(0, 66.47%, 0); }
    100% { transform: translate3d(0, 88%, 0); }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero,
      #me {
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit;
      }

      .hero {
        animation-name: hero-lag;
      }

      #me {
        animation-name: me-lag;
      }
    }
  }

  ::selection {
    background: var(--accent);
    color: var(--bg);
  }

  html {
    font-family: var(--font-body);
    font-size: 90%;
    background: var(--bg);
    color: var(--text);
    scroll-behavior: smooth;
    transition: background 0.3s, color 0.3s;
    font-weight: 400;
    line-height: 1.6;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    padding: 2rem;
    overflow-x: hidden;
  }

  @media (max-width: 480px) {
    body {
      padding: 1rem;
    }
  }
</style>
