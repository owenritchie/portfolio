---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&family=Righteous&family=Grenze:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />
    <link id="favicon" rel="icon" type="image/svg+xml" href="/favicon/owen-green.svg" />
    <title>{title}</title>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8RHHBW0QB9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8RHHBW0QB9');
    </script>
    <script is:inline>
      if (!matchMedia('(max-width: 680px), (pointer: coarse)').matches) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
    <script is:inline>
      (function () {
        var ua = navigator.userAgent || '';
        var ios =
          /iPad|iPhone|iPod/.test(ua) ||
          (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        var android = /Android/i.test(ua);
        if (ios || android) {
          document.documentElement.classList.add('no-pendulum');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      const html = document.documentElement;
      const stored = localStorage.getItem('theme');
      if (stored) {
        html.dataset.theme = stored;
      }

      try {
        if (localStorage.getItem('rose-trail') === 'on') html.classList.add('rose-trail');
      } catch {}

      function updateFavicon() {
        const link = document.getElementById('favicon');
        if (link) {
          link.setAttribute(
            'href',
            html.dataset.theme === 'dark' ? '/favicon/owen-pink.svg' : '/favicon/owen-green.svg'
          );
        }
      }
      updateFavicon();

      window.toggleTheme = () => {
        const current = html.dataset.theme;
        const next = current === 'dark' ? 'light' : 'dark';
        html.dataset.theme = next;
        localStorage.setItem('theme', next);
        updateFavicon();
      };
    </script>

    <script>
      (function () {
        const root = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const GAP = 70;
        const LIFE = 1400;
        const MAX = 16;
        let lastX = -999;
        let lastY = -999;
        let live = 0;

        addEventListener(
          'pointermove',
          (e) => {
            if (e.pointerType === 'touch' || innerWidth <= 680 || !root.classList.contains('rose-trail')) return;
            if (Math.hypot(e.clientX - lastX, e.clientY - lastY) < GAP || live >= MAX) return;
            lastX = e.clientX;
            lastY = e.clientY;

            const rose = document.createElement('img');
            rose.src = '/other/mc-rose-crop.png';
            rose.alt = '';
            rose.className = 'rose-petal';
            rose.draggable = false;
            document.body.append(rose);
            live++;

            const tilt = (Math.random() - 0.5) * 36;
            const x = e.clientX - 7;
            const y = e.clientY - 15;
            rose
              .animate(
                [
                  { transform: `translate(${x}px, ${y}px) rotate(${tilt}deg) scale(1)`, opacity: 0.95 },
                  { transform: `translate(${x}px, ${y - 18}px) rotate(${tilt * 1.5}deg) scale(0.7)`, opacity: 0 },
                ],
                { duration: LIFE, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
              )
              .finished.then(() => {
                rose.remove();
                live--;
              });
          },
          { passive: true }
        );
      })();
    </script>

    <script>
      (function () {
        const root = document.documentElement;
        const check = () => {
          root.classList.toggle('at-end', innerHeight + scrollY >= root.scrollHeight - 80);
        };
        addEventListener('scroll', check, { passive: true });
        addEventListener('resize', check);
        check();
      })();
    </script>

    <script>
      (function () {
        const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        if (!els.length) return;

        const reduce = matchMedia('(prefers-reduced-motion: reduce), (max-width: 680px), (pointer: coarse)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
        );

        els.forEach((el) => io.observe(el));

        function flush() {
          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
            els.forEach((el) => {
              el.classList.add('is-in');
              io.unobserve(el);
            });
            removeEventListener('scroll', flush);
          }
        }
        addEventListener('scroll', flush, { passive: true });
      })();
    </script>

  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Myflora";
    src: url("/fonts/Myflora.otf") format("opentype");
    font-weight: normal;
    font-style: normal;
    unicode-range: U+0-2F, U+3A-10FFFF;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --bg: oklch(0.977 0.008 95);
    --card: oklch(0.945 0.013 92);
    --border: oklch(0.85 0.014 90);
    --text: oklch(0.26 0.035 145);
    --text-muted: oklch(0.48 0.05 145);
    --accent: oklch(0.5 0.16 145);
    --accent-2: oklch(0.74 0.07 60);
    --green: oklch(0.915 0.042 140);

    --dash-width: 1.5px;
    --dash-color: oklch(0.72 0.05 80);

    --heading-ink: oklch(0.26 0.035 145);
    --heading-font: 'Myflora', serif;

    --btn: oklch(0.36 0.11 145);
    --btn-hover: oklch(0.5 0.16 145);
    --btn-fg: oklch(0.99 0.004 130);
    --btn-2: var(--accent-2);
    --btn-2-hover: oklch(0.82 0.06 60);

    --font-heading: "Inter", system-ui, -apple-system, sans-serif;
    --font-body: "Inter", system-ui, -apple-system, sans-serif;

    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --dur-base: 0.25s;
    --dur-slow: 0.5s;
  }

  html.menu-open,
  html.menu-open body {
    overflow: hidden;
  }

  .rose-petal {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    height: 30px;
    width: auto;
    pointer-events: none;
    image-rendering: pixelated;
    will-change: transform, opacity;
  }

  html.no-pendulum .lamp-anchor {
    display: none;
  }

  [data-theme="dark"] {
    --bg: oklch(0.17 0.03 278);
    --card: oklch(0.22 0.04 280);
    --border: oklch(0.5 0.05 282);
    --text: oklch(0.95 0.015 288);
    --text-muted: oklch(0.72 0.06 286);
    --accent: oklch(0.64 0.19 320);
    --accent-2: oklch(0.62 0.2 268);
    --green: color-mix(in oklch, var(--card) 82%, var(--accent) 18%);

    --dash-color: oklch(0.34 0.06 282);

    --heading-ink: oklch(0.84 0.07 295);

    --btn: var(--card);
    --btn-hover: color-mix(in oklch, var(--card) 78%, var(--accent) 22%);
    --btn-fg: var(--text);
    --btn-2: var(--card);
    --btn-2-hover: color-mix(in oklch, var(--card) 78%, var(--accent-2) 22%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .js-reveal [data-reveal] {
      opacity: 0;
      transition:
        opacity var(--dur-slow) var(--ease-out),
        translate var(--dur-slow) var(--ease-out),
        scale var(--dur-slow) var(--ease-out),
        filter var(--dur-slow) var(--ease-out);
      transition-delay: var(--rd, 0s);
    }

    .js-reveal [data-reveal="up"] { translate: 0 28px; }
    .js-reveal [data-reveal="scale"] { scale: 0.94; }
    .js-reveal [data-reveal="left"] { translate: -32px 0; }
    .js-reveal [data-reveal="right"] { translate: 32px 0; }
    .js-reveal [data-reveal="fade"] { translate: 0 0; }
    .js-reveal [data-reveal="blur"] { translate: 0 20px; filter: blur(10px); }

    .js-reveal [data-reveal="trigger"] {
      opacity: 1;
      transition: none;
    }

    .js-reveal [data-reveal].is-in {
      opacity: 1;
      translate: 0 0;
      scale: 1;
      filter: none;
    }

    .js-reveal .timeline[data-reveal]:not(.is-in) .timeline-row,
    .js-reveal .timeline[data-reveal]:not(.is-in) .timeline-bar {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-delay: 0s !important;
      animation-iteration-count: 1 !important;
      transition-delay: 0s !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  main > header,
  main > section,
  main > footer {
    position: relative;
  }

  .hero { z-index: 1; }
  #me { z-index: 2; }
  #work { z-index: 3; }
  #projects { z-index: 4; }
  .site-footer { z-index: 5; }

  ::selection {
    background: var(--accent);
    color: var(--bg);
  }

  html {
    font-family: var(--font-body);
    font-size: 90%;
    background: var(--bg);
    color: var(--text);
    scroll-behavior: smooth;
    transition: background var(--dur-base), color var(--dur-base);
    font-weight: 400;
    line-height: 1.6;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* No rubber-band past the footer (it reveals the canvas); pull-to-refresh at the top stays */
  html.at-end {
    overscroll-behavior-y: none;
  }

  body {
    --pad: 2rem;
    min-height: 100vh;
    padding: max(var(--pad), env(safe-area-inset-top)) max(var(--pad), env(safe-area-inset-right)) var(--pad) max(var(--pad), env(safe-area-inset-left));
    overflow-x: hidden;
    background: var(--bg);
  }

  @media (max-width: 480px) {
    body {
      --pad: 1rem;
    }
  }
</style>
